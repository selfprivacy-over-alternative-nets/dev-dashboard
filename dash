def cmd_list(args):
    cat = load_catalog()
    es = all_entries(cat)
    for e in es:
        nets = ",".join(e.get("networks") or []) or "-"
        c = e.get("cmd", "")
        kind = "@todo" if c == "@todo" else "@manual" if c == "@manual" else ""
        print(f"  {e['id']:<26} {e['level']:<8} {e.get('client','-'):<8} net={nets:<16} {GREY}{kind}{OFF}")
    print(f"\n{len(es)} commands. Run: ./dash run <id> [--on vm --reach onion --net tor]  |  ./dash setups  |  ./dash run --all")


def select(args):
    cat = load_catalog()
    es = all_entries(cat)
    if args.ids:
        picked = [entry_by_id(cat, i) for i in args.ids]
        missing = [i for i, p in zip(args.ids, picked) if p is None]
        if missing:
            rm = cat.get("removed_setups") or {}
            hints = [f"  {i}: {rm[i.split('.', 1)[1]]}" for i in missing
                     if i.startswith("install.") and i.split(".", 1)[1] in rm]
            sys.exit(f"unknown id(s): {', '.join(missing)}" + ("\n" + "\n".join(hints) if hints else ""))
        return picked
    if args.all:
        return es
    out = es
    if args.level:
        out = [e for e in out if e["level"] == args.level]
    if args.category:
        out = [e for e in out if e.get("category") == args.category]
    if args.tag:
        k, _, v = args.tag.partition("=")
        out = [e for e in out if str(e.get(k, "")) == v]
    if out is es:
        sys.exit("nothing selected. use <id>, --all, --level, --category, or --tag")
    return out


def cmd_run(args):
    _gate = alignment_gate()   # once up front (req 183); run_entry checks again for its other callers
    if _gate:
        sys.exit(_gate)
    entries = select(args)
    # Fold the dedicated box args into the env channel the gates/dispatch already read (KEY for the
    # box-identity gate + server logs; API_TOKEN for the L3 app). Keeps run_entry's signature stable.
    env = list(args.env or [])
    if getattr(args, "key", None):
        env.append(f"KEY={args.key}")
    if getattr(args, "token", None):
        env.append(f"API_TOKEN={args.token}")
    args.env = env
    print(f"{BOLD}Running {len(entries)} command(s){OFF}\n")
    results = [run_entry(e, args.config, net=args.net, method=args.on,
                         record=args.record, server_log=args.server_log,
                         ip=args.ip, extra_env=args.env, allow_dirty=args.allow_dirty,
                         reach=args.reach, reach_name=args.name) for e in entries]
    refused = sum(1 for r in results if not r)
    results = [r for r in results if r]
    ok = sum(1 for r in results if r["status"] == "pass")
    print(f"\n{BOLD}Done.{OFF} {ok}/{len(results)} pass" + (f", {refused} not run" if refused else "") +
          f". Data → {os.path.relpath(DATA, ROOT)}")
    print("View:  ./dash serve   Publish:  ./dash publish")
    # non-zero when anything was refused or did not complete, so `./dash run a && ./dash run b` stops there
    if refused or any(r["status"] not in ("pass", "slow") for r in results):
        sys.exit(1)


def cmd_wrap(args):
    _gate = alignment_gate()
    if _gate:
        sys.exit(_gate)
    cat = load_catalog()
    e = entry_by_id(cat, args.id) or {"id": args.id, "name": args.id, "category": "test",
                                       "level": "adhoc", "repo": None, "budget_s": None}
    e = dict(e)
    e["cmd"] = " ".join(args.cmd)
    rec = run_entry(e, args.config, net=args.net, method=args.on, record=args.record, server_log=args.server_log,
                    reach=args.reach, reach_name=args.name)
    sys.exit(0 if rec and rec.get("status") in ("pass", "slow") else 1)


def cmd_report(args):
    cat = load_catalog()
    _gate = alignment_gate(cat)   # a manual result lands in a matrix cell too (req 183)
    if _gate:
        sys.exit(_gate)
    e = entry_by_id(cat, args.id)
    if not e:
        sys.exit(f"unknown id: {args.id}")
    gs = git_state(e.get("repo"))
    nets = e.get("networks") or []
    # The same explicit setup + reach a `run` takes, so a manual result lands in the same matrix cell.
    _on, _err = resolve_method(e, args.on, cat)
    if _err:
        sys.exit(f"setup: {_err}")
    _net = args.net or (nets[0] if len(nets) == 1 else None)
    _row, _err = resolve_reach(e, _net, _on, args.reach, args.name, cat, check_wired=False)
    if _err:
        sys.exit(f"reach: {_err}")
    _repos = project_repo_states(entry_repos(e))
    _pins = flake_pins()
    _box = None
    _sh = None
    if args.ip:
        # Authoritative: record the box's actual deployed identity (the device, not report-time git).
        _box = read_box_stamp(args.ip, args.key)
        if _box is None:
            print(f"{AMBER}warning{OFF}: root@{args.ip} unreachable or not stamped — recording local git state instead.")
        else:
            _server = _box.get("repos") or []
            _snames = {s.get("name") for s in _server}
            _client = [r for r in _repos if r.get("name") not in _snames]
            _repos = _server + _client
            _pins = _box.get("pins") or _pins
            _sh = _box.get("state_hash")
    rec = {
        "run_id": gen_run_id(), "ts": now_iso(), "env": args.env or ("ci" if is_ci() else "local"),
        "host": args.host or socket.gethostname(), "category": e.get("category", "test"),
        "id": e["id"], "name": e.get("name", e["id"]), "level": e.get("level", ""),
        "client": e.get("client", "-"), "transport": _net or "-",
        "backend": e.get("backend", "-"), "method": _on or "-",
        "reach": (_row or {}).get("reach"), "reach_name": (_row or {}).get("name"), "reach_row": (_row or {}).get("id"),
        "diagram_view": diagram_view(_on, (_row or {}).get("id"), cat),
        "records_video": bool(e.get("records_video")),
        "config_label": args.config or "", "status": args.status,
        "source": "manual",   # self-attested (click-through/video), NOT an automated+verified run
        "duration_s": round(float(args.duration), 1), "exit_code": 0 if args.status == "pass" else 1,
        "error": scrub(args.error or ""), "log_path": "",
        "artifacts": {"client_log": "", "server_log": "", "video": ""},
        "repos": _repos, "pins": _pins, "pin_mismatch": api_pin_mismatch(), "state_hash": _sh, "box_stamp": _box,
        **{k: gs[k] for k in ("repo", "branch", "commit", "subject", "dirty", "diff_hash")},
    }
    append_record(rec)
    print(f"recorded {args.status} for {args.id} ({fmt_dur(args.duration)})")


def cmd_verify_box(args):
    """Read /etc/dev-test-build.json from a deployed box and compare to the CURRENT code pins.
    Answers: does this already-deployed box correspond to the code state you'd be testing?"""
    if not ssh_reachable(args.ip, args.key):
        sys.exit(f"{RED}unreachable{OFF} — root@{args.ip} not reachable over SSH (box down / wrong IP / wrong key).")
    stamp = read_box_stamp(args.ip, args.key)
    if stamp is None:
        sys.exit(f"{RED}not-stamped{OFF} — root@{args.ip} is reachable but has no /etc/dev-test-build.json (deployed before stamping; redeploy to stamp it).")
    want = flake_pins()  # current catalog-default deployed pins
    diffs = box_pin_diffs(stamp, want)
    print(f"box root@{args.ip} deployed_at {stamp.get('deployed_at', '?')} from flake {stamp.get('flake', '?')}")
    if diffs:
        print(f"{RED}MISMATCH{OFF} — the box runs a DIFFERENT state than the current code:")
        for d in diffs:
            print("  " + d)
        print("  redeploy the box before testing, so results reflect the current code.")
        sys.exit(1)
    print(f"{GREEN}MATCH{OFF} — box corresponds to current code pins ({', '.join(f'{k}={v}' for k, v in want.items())}).")


def cmd_l3_baseline(args):
    """Capture (bless) or show the known-clean golden backend baseline for an L3 setup. Run `capture`
    right after a fresh (re)install so later flows' drift is measured against a clean reference. The
    golden stores only the state sha + modules/users summary — no secrets. All args explicit (reqs 1-6);
    box setups need --ip/--key/--token (enforced by resolve_backend_target)."""
    setup, _err = canon_setup(args.on)
    if not _err and setup not in setup_ids():
        _err = f"{setup} is harness-only (the L1/L2 test VM), not a setup you pass — use one of: {' | '.join(setup_ids())}"
    if _err:
        sys.exit(f"--on {args.on}: {_err}")
    action = args.action or "capture"
    target = resolve_backend_target(setup, "tor", args.ip, args.key, args.token)
    if not target:
        sys.exit(1)
    if target["kind"] == "box":
        stamp = read_box_stamp(target["ip"], target["key"])
        state_key = (stamp or {}).get("state_hash") or "unknown"
    else:
        state_key = _state_hash_of(project_repo_states(DEFAULT_REPOS["L3"]))
    _iid = _backend_install_id(target)
    if _iid:
        state_key = f"{state_key}-{_iid}"     # same key the L3 runs use (per code state AND per install)
    p = _l3_baseline_path(state_key, setup)
    if action == "show":
        print(open(p).read() if os.path.exists(p)
              else f"no baseline for {state_key}/{setup} (expected {os.path.relpath(p, ROOT)})")
        return
    pre = _snapshot_backend(target)
    if not pre.get("present"):
        sys.exit(f"{RED}backend userdata.json not readable on {setup}{OFF} — is the backend up?")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump({"sha": pre.get("sha"), "modules": pre.get("modules"), "users_n": pre.get("users_n"),
               "setup": setup, "state_key": state_key, "captured": now_iso()}, open(p, "w"), indent=1)
    print(f"{GREEN}captured golden baseline{OFF}  {state_key}/{setup} → {os.path.relpath(p, ROOT)}")
    print(f"  modules: {pre.get('modules')}   users_n: {pre.get('users_n')}")


def cmd_find_target(args):
    """Discover candidate target devices and confirm WHICH one to install to — match the MAC shown on
    the target's PXE/boot screen. Reads the netboot DHCP leases (a device that booted into the
    installer = the strongest signal) + scans every connected LAN. Prints the MAC/IP to install with."""
    cands, seen = [], set()
    for m, i in _netboot_leases():
        if m not in seen:
            cands.append((m, i, "netbooted")); seen.add(m)
    # Direct-cable link status — a common reason a target is invisible (no cable link / target NIC off).
    _car = _iface_carrier(DIRECT_IFACE)
    _srv = _netboot_running()
    if _car is False:
        _link = f"{RED}NO CARRIER (no cable link){OFF}"
    elif _car:
        _link = f"{GREEN}link up{OFF}"
    else:
        _link = "unknown"
    print(f"{GREY}direct cable {DIRECT_IFACE}: {_link}; netboot server "
          f"{'up' if _srv else 'down'}{OFF}")

    prefixes = _local_prefixes()
    if args.subnet:
        prefixes = sorted(set(prefixes) | {args.subnet})
    print(f"{GREY}scanning {', '.join(p + '.0/24' for p in prefixes)} …{OFF}")
    for p in prefixes:
        _ping_sweep(p)
    for m, i in _neigh_pairs():
        if m not in seen:
            cands.append((m, i, "on LAN")); seen.add(m)
    # IPv6 link-local — finds a directly-cabled target that has NO IPv4/DHCP (cable-* setups). Added only
    # for MACs the IPv4 sweep didn't already cover (so LAN devices keep their IPv4).
    for m, dev in _ipv6_ll_discover():
        if m not in seen:
            src = "direct cable" if dev == DIRECT_IFACE else f"link-local {dev}"
            cands.append((m, "no-IPv4 (link-local)", src)); seen.add(m)

    if not cands:
        print(f"{AMBER}No devices found.{OFF}")
        if _car is False:
            print(f"  {DIRECT_IFACE} has {RED}NO CARRIER{OFF} — nothing is linked on the wired port. "
                  f"Check the cable (both ends), and that the target is powered ON and in UEFI network "
                  f"boot (or a running OS) so its NIC comes up. Watch it: "
                  f"{CYAN}watch -n1 cat /sys/class/net/{DIRECT_IFACE}/carrier{OFF} (want 1).")
            print(f"  Installing a NEW empty device over the direct cable? After the cable is linked, start "
                  f"the netboot server (separate terminal, sudo):")
            print(f"    {CYAN}sudo bash ~/netboot/start-netboot-server.sh{OFF}")
        elif not _srv:
            print(f"  Installing an EMPTY device over a direct cable? It only gets an IP once the "
                  f"netboot server is running. Start it (separate terminal, sudo):")
            print(f"    {CYAN}sudo bash ~/netboot/start-netboot-server.sh{OFF}")
            print(f"  then boot the target into UEFI network boot and re-run.")
        else:
            print(f"  Netboot server is up but nothing leased yet — boot the target into UEFI network "
                  f"boot. For a router-LAN target, check cable/power or pass --subnet <prefix>.")
        return

    print(f"{BOLD}Candidate targets{OFF} — match the MAC shown on the target's screen:")
    for n, (m, i, src) in enumerate(cands, 1):
        tag = f"{GREEN}netbooted{OFF}" if src == "netbooted" else f"{GREY}{src}{OFF}"
        print(f"  [{n}] MAC {BOLD}{m}{OFF}  IP {i}  ({tag})")
    if not any(s == "netbooted" for _, _, s in cands):
        # No direct-cable netbooted target in the list (only router-LAN devices). If you're installing a
        # NEW empty device over the direct cable, ALWAYS surface the netboot-server command — regardless
        # of carrier (you may not have plugged the cable in yet). Wording adapts to the carrier/server state.
        if _car is False:
            print(f"{AMBER}note: installing a NEW empty device over the direct cable? ({DIRECT_IFACE} has no "
                  f"link yet.) Plug the cable into the target, start the netboot server (separate terminal, "
                  f"sudo), then power the target into UEFI network boot — it'll appear as "
                  f"{GREEN}netbooted{OFF}{AMBER} on 192.168.100.x:{OFF}")
        elif not _srv:
            print(f"{RED}note: {DIRECT_IFACE} is linked but the netboot server is NOT serving (no DHCP "
                  f"on :67), so a direct-cabled target gets no IP and won't appear. Start it, then re-run:{OFF}")
        else:
            print(f"{AMBER}note: the direct-cabled target hasn't appeared yet (the list above is only "
                  f"router-LAN devices). Power it ON into UEFI network boot — it shows up as "
                  f"{GREEN}netbooted{OFF}{AMBER} on 192.168.100.x. If it still doesn't, (re)start the "
                  f"netboot server, then re-run:{OFF}")
        print(f"    {CYAN}sudo bash ~/netboot/start-netboot-server.sh{OFF}")
    # Rule (req 142): re-ask on an invalid answer — only an explicit n / empty cancels, never a typo.
    try:
        if len(cands) == 1:
            m, i, _ = cands[0]
            while True:
                ans = input(f"Confirm this is your target (MAC {m})? [y/N]: ").strip().lower()
                if ans in ("y", "yes"):
                    chosen = (m, i); break
                if ans in ("", "n", "no"):
                    chosen = None; break
                print(f"{AMBER}  please answer y or n (Enter or n cancels){OFF}")
        else:
            while True:
                sel = input("Which is your target? [number, or n to cancel]: ").strip()
                if sel.lower() in ("n", "no"):
                    chosen = None; break
                if sel.isdigit() and 1 <= int(sel) <= len(cands):
                    chosen = cands[int(sel) - 1][:2]; break
                print(f"{AMBER}  please type a number 1-{len(cands)} (or n to cancel){OFF}")
    except (EOFError, KeyboardInterrupt):
        chosen = None
    if not chosen:
        print("cancelled — nothing selected.")
        return
    m, i = chosen
    # For a link-local-only (direct-cable, no IPv4) target the install IP is the netboot server's
    # pinned installer address; the e2e adopts the box by MAC regardless.
    ip_for_cmd = i if i[:1].isdigit() else DIRECT_IP.rsplit(".", 1)[0] + ".50"
    print(f"\n{GREEN}target confirmed{OFF}  MAC={m}  (found at {i})")
    # Hand off to resolve_flake.sh: it fills in the last blanks (which deploy flake + domain) and
    # prints/offers to run the ready install command. Fallback to a placeholder command if absent.
    _rf = os.path.join(ROOT, "tools", "resolve_flake.sh")
    if os.path.exists(_rf):
        subprocess.run(["bash", _rf], env={**os.environ, "MAC": m, "IP": ip_for_cmd})
    else:
        print("install, e.g.:")
        print(CYAN + "\n".join([
            "./dash run install.cable-0a --on cable-0a \\", f"  --ip {ip_for_cmd} \\",
            "  --key ~/.ssh/pcname_ed25519 \\", "  --env FLAKE=<flake> \\",
            f"  --env MAC={m} \\", "  --env DOMAIN=<domain> \\",
            "  --env NETBOOT=auto \\", "  --env TRANSPORT=none"]) + OFF)


