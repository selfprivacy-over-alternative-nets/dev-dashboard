def entry_by_id(cat, cid):
    for e in all_entries(cat):
        if e["id"] == cid:
            return e
    return _resolve_install_alias(cat, cid)


def _resolve_install_alias(cat, cid):
    """Accept the FINE install ids as run targets: install.<setup> (install.cable-0a … install.usb-0c)
    → that setup's Install-method entry (install.cable / install.wifi / install.usb), recording the fine
    setup as its method (so the stamp + matrix column reflect the real variant). The variants of one
    method differ only in post-install connectivity (the diagram's Network toggle), not in the install
    command. Legacy ids resolve through the setup aliases (install.lan-setup-0d → install.cable-0d,
    install.vm-local → install.vm, install.lan-setup-1 → install.wifi-0a)."""
    if not cid.startswith("install."):
        return None
    sid, _ = canon_setup(cid.split(".", 1)[1], cat)
    s = setup_entry(sid, cat) if sid else None
    if not s or sid == "test-vm":
        return None
    fam = next((m.get("install") for m in (cat.get("setup_map") or {}).get("methods", []) if m["id"] == s.get("method")), None)
    e = next((x for x in all_entries(cat) if x["id"] == fam), None)
    if not e:
        return None
    e = dict(e)
    e["id"] = f"install.{sid}"
    e["method"] = sid
    return e


def _wifi_required(setup):
    """Setups whose target ends up on wifi, so a wifi spec is mandatory (catalog setups[].target_wifi:
    cable-0b/0d/0c, wifi-0d, usb-0d/0c)."""
    return bool((setup_entry(setup) or {}).get("target_wifi"))


def is_ci():
    return bool(os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"))


def git_state(repo_rel):
    """Return {repo, commit, subject, dirty, diff_hash} for the repo a command targets."""
    repo = os.path.normpath(os.path.join(ROOT, repo_rel)) if repo_rel else ROOT
    name = os.path.basename(repo)

    def g(args, default=""):
        try:
            return subprocess.check_output(["git", "-C", repo] + args, stderr=subprocess.DEVNULL).decode().strip()
        except Exception:
            return default

    commit = g(["rev-parse", "--short", "HEAD"], "unknown")
    branch = g(["rev-parse", "--abbrev-ref", "HEAD"], "")
    subject = g(["log", "-1", "--format=%s"], "")
    porcelain = g(["status", "--porcelain"])
    diff = g(["diff", "HEAD"])
    dirty = bool(porcelain)
    diff_hash = hashlib.sha256((porcelain + diff).encode()).hexdigest()[:8] if dirty else ""
    return {"repo": name, "branch": branch, "commit": commit, "subject": subject, "dirty": dirty, "diff_hash": diff_hash}


def _is_git(repo):
    return subprocess.run(["git", "-C", repo, "rev-parse", "--git-dir"], capture_output=True).returncode == 0


# Which project repos each test actually depends on — scopes the state key AND the clean gate.
# Per-entry "repos" wins; else default by level/category; None → all project repos.
DEFAULT_REPOS = {
    "L1": ["api"],
    "L2": ["tests", "manager", "api"],
    "L3": ["app", "manager", "api"],
    "install": ["manager", "api"],
}


def entry_repos(entry):
    return entry.get("repos") or DEFAULT_REPOS.get(entry.get("level") or entry.get("category"))


def project_repo_states(names=None):
    """git_state for repos in catalog.project_repos — only `names` (the test's repos) if given,
    else all. Each gets a `name`. This is the 'config under test' the run actually depends on."""
    try:
        cat = load_catalog()
    except Exception:
        return []
    out = []
    for name, rel in (cat.get("project_repos") or {}).items():
        if names is not None and name not in names:
            continue
        repo = os.path.normpath(os.path.join(ROOT, rel))
        if not _is_git(repo):
            continue
        st = git_state(rel)
        st["name"] = name
        out.append(st)
    return out


def _state_hash_of(repos):
    """One short hash identifying a whole code state: all repos' commits + their dirtiness."""
    return hashlib.sha256("\n".join(sorted(
        f"{r['name']}:{r.get('commit', '')}:{r.get('diff_hash', '')}" for r in repos)).encode()).hexdigest()[:12]


def _self_contained(entry):
    """A test that builds its OWN flake (spins its own throwaway VM) instead of deploying to a
    box — an L2-style nixosTest. Its own flake.lock (not the backend's) is what pins the api /
    manager / nixpkgs it actually builds."""
    return bool(entry.get("cmd_by_net")) or entry.get("method") == "test-vm"


def nix_sandbox():
    """The host's nix `sandbox` setting ('true' | 'false' | 'relaxed' | ''). Anything other than
    'true' means a nix build may read host state — so a 'hermetic' nixosTest VM build could reflect
    more than the committed code. Best-effort; '' if nix can't be queried."""
    v = (_sh("nix config show sandbox", timeout=15).stdout or "").strip()
    if not v:
        for line in (_sh("nix show-config", timeout=20).stdout or "").splitlines():
            if line.startswith("sandbox ") or line.startswith("sandbox="):
                v = line.split("=", 1)[-1].strip()
                break
    return v


def guard_file_hits(repo_names, guard_paths):
    """Find build-affecting files (catalog `guard_paths`, e.g. users.nix/.env/flake.local.nix) that are
    present in a repo under test AND gitignored — so they're INVISIBLE to `git status` and the clean-
    state gate can't see them, yet they can change the build (req 91). A tracked guard file is part of
    the committed state; an untracked one already trips the dirty gate — neither is a hidden input, so
    only gitignored+present ones are returned. [{repo,path,sha}]."""
    hits = []
    pr = (load_catalog().get("project_repos") or {})
    for name in (repo_names or list(pr)):
        rel = pr.get(name)
        if not rel:
            continue
        repo = os.path.normpath(os.path.join(ROOT, rel))
        if not os.path.isdir(repo):
            continue
        for gp in guard_paths:
            fp = os.path.join(repo, gp)
            if not os.path.isfile(fp):
                continue
            ignored = subprocess.run(["git", "-C", repo, "check-ignore", "-q", gp],
                                     capture_output=True).returncode == 0
            if not ignored:
                continue    # tracked ⇒ in the committed state; untracked ⇒ caught by the dirty gate
            try:
                sha = hashlib.sha256(open(fp, "rb").read()).hexdigest()[:8]
            except Exception:
                sha = "?"
            hits.append({"repo": name, "path": gp, "sha": sha})
    return hits


def drv_of(cmd, run_dir):
    """The derivation path a self-contained build resolves to — the EXACT build-closure identity: it
    captures EVERY transitive input, not just the 3 recorded pins (api/nixpkgs/manager), so two builds
    that differ only in some transitive input can't collide on one state key (req 92). Extracts the
    flake attr (the first '#'-bearing token) from the cmd and runs `nix eval <attr>.drvPath`. Returns
    '' if there's no attr or the eval fails. A dirty tree yields a dirty-suffixed drv (honest)."""
    attr = next((t for t in cmd.split() if "#" in t), "")
    if not attr:
        return ""
    r = _sh(f"cd '{run_dir}' && nix eval \"{attr}.drvPath\" --raw", timeout=240)
    out = (r.stdout or "").strip().splitlines()[-1] if (r.stdout or "").strip() else ""
    return out if out.endswith(".drv") else ""


def resolve_lock(extra_env=None, entry=None):
    """The flake.lock that actually governs THIS run's build/deploy:
      1. $FLAKE/flake.lock when --env FLAKE=… (installs deploy that flake);
      2. a self-contained nixosTest's OWN flake.lock (its repo/cwd flake.lock) — e.g. L2 builds
         the `selfprivacy-tor-tests` flake, whose lock (NOT the backend flake) pins the api /
         manager / nixpkgs under test. Using it makes flake_pins + the pin gate check the right
         lock, so a stale test lock can no longer record a false pass;
      3. else catalog.pins_lock (the backend flake)."""
    for kv in (extra_env or []):
        if kv.startswith("FLAKE="):
            return os.path.join(kv.split("=", 1)[1], "flake.lock")
    if entry is not None and _self_contained(entry):
        rd = os.path.normpath(os.path.join(ROOT, entry.get("cwd") or entry.get("repo") or "."))
        cand = os.path.join(rd, "flake.lock")
        if os.path.exists(cand):
            return cand
    try:
        rel = load_catalog().get("pins_lock")
    except Exception:
        rel = None
    return os.path.normpath(os.path.join(ROOT, rel)) if rel else None


def flake_pins(lock_path=None):
    """{'selfprivacy-api': rev, 'nixpkgs': rev} from a flake.lock — the DEPLOYED versions (from
    the lock, NOT the local api checkout). lock_path defaults to catalog.pins_lock."""
    if lock_path is None:
        lock_path = resolve_lock(None)
    if not lock_path or not os.path.exists(lock_path):
        return {}
    try:
        d = json.load(open(lock_path))
    except Exception:
        return {}
    pins = {}
    for k in ("selfprivacy-api", "nixpkgs", "manager"):
        rev = ((d.get("nodes", {}).get(k, {}) or {}).get("locked", {}) or {}).get("rev")
        if rev:
            pins[k] = rev[:12]
    return pins


def lock_input_mismatch(lock_path, node_name, repo_name):
    """None if the local <repo_name> checkout CORRESPONDS to the <node_name> rev pinned in
    lock_path, else a dict describing the mismatch. 'Corresponds' = local HEAD == pinned rev AND
    clean. Returns None when not configured/checkable (e.g. the lock doesn't pin that input), so
    it never blocks inputs this lock doesn't govern."""
    if not lock_path or not os.path.exists(lock_path):
        return None
    try:
        rel = (load_catalog().get("project_repos") or {}).get(repo_name)
    except Exception:
        rel = None
    if not rel:
        return None
    repo = os.path.normpath(os.path.join(ROOT, rel))
    if not _is_git(repo):
        return None
    try:
        head = subprocess.check_output(["git", "-C", repo, "rev-parse", "HEAD"], stderr=subprocess.DEVNULL).decode().strip()
        lock = json.load(open(lock_path))
    except Exception:
        return None
    pin = ((lock.get("nodes", {}).get(node_name, {}) or {}).get("locked", {}) or {}).get("rev")
    if not pin:
        return None
    dirty = bool(subprocess.run(["git", "-C", repo, "status", "--porcelain"], capture_output=True).stdout.strip())
    if head != pin:
        return {"kind": "rev", "input": node_name, "pin": pin[:12], "checkout": head[:12],
                "msg": f"flake.lock pins {node_name} @ {pin[:12]} but the local {repo_name} checkout is @ {head[:12]}"}
    if dirty:
        return {"kind": "dirty", "input": node_name, "pin": pin[:12], "checkout": head[:12],
                "msg": f"{repo_name} checkout @ {head[:12]} matches the pin but has UNCOMMITTED changes (the build uses the committed pin, not your edits)"}
    return None


def api_pin_mismatch(lock_path=None):
    """None if the local selfprivacy-api checkout corresponds to the flake.lock api pin, else a
    mismatch dict. Thin wrapper over lock_input_mismatch; kept for existing callers."""
    if lock_path is None:
        lock_path = resolve_lock(None)
    return lock_input_mismatch(lock_path, "selfprivacy-api", "api")


def _env_get(extra_env, key):
    for kv in (extra_env or []):
        if kv.startswith(key + "="):
            return kv.split("=", 1)[1]
    return None


def needs_box(entry):
    """True if the test runs against a deployed target box, so the box's deployment identity
    must match the current code. Per-entry `needs_box` wins (the reach.* apply entries set it); else
    default: L3 tests do (they run the Flutter app against a deployed box). L1/L2 are self-contained
    nixosTests that spin their own throwaway VM, so they need no external box (matches the
    dashboard's needsBox)."""
    if "needs_box" in entry:
        return bool(entry["needs_box"])
    return entry.get("level") == "L3"


def resolve_reach(entry, net, setup, reach, name, cat=None, check_wired=True):
    """(row, None) or (None, why): the matrix reach row a run lands in — one view of the setup diagram's
    Reach (+ Name) toggles, or a harness-only row (onion over chutney, local https). Args-only, no I/O.
      - reach.* apply entries: fixed by the entry; --reach/--name may repeat it but not contradict it.
      - every L3 entry (run AND report): --reach is REQUIRED (+ --name when the diagram offers names for that reach,
        and forbidden otherwise) — it decides the row, so it is never defaulted (reqs 1-6). It must fit
        --net (onion→tor|chutney, local/tailscale/cloudflare/ipv6/portfwd→https), the setup (harness rows
        are VM-only) and be wired for that backend kind (catalog reach_rows[].l3_wired).
      - L2 / the inner L3 recorder on the VM: no choice exists, so it is derived from --net
        (tor→onion, chutney→onion over chutney, https→local) — and checked if given explicitly.
      - everything else (L1, installs): no row.
    check_wired=False (a manual `report`): a human drove it, so "not wired into dash yet" doesn't apply."""
    cat = cat or load_catalog()
    rows = cat.get("reach_rows", [])
    sm = cat.get("setup_map") or {}
    if entry.get("reach_row"):                                       # reach.<id> apply entries
        r = next((x for x in rows if x["id"] == entry["reach_row"]), None)
        if reach and reach != entry.get("reach"):
            return None, f"{entry['id']} applies --reach {entry.get('reach')}, not {reach}"
        if name and name != entry.get("reach_name"):
            return None, f"{entry['id']} applies --name {entry.get('reach_name')}, not {name}"
        if _setup_backend_kind(setup) != "box":
            return None, (f"{entry['id']} runs tools/add-cloudflare.sh against an installed BOX over SSH; it is not "
                          f"wired for --on {setup or '(none)'} — pass a box setup: {' | '.join(s for s in setup_ids(cat) if s != 'vm')}")
        return r, None
    lvl = entry.get("level")
    required = lvl == "L3" and not entry.get("_no_gate")   # the inner L3 recorder inherits the outer run's row
    if lvl not in ("L2", "L3"):
        if reach or name:
            return None, f"{entry['id']} takes no --reach/--name (only L3 flows and reach.* entries do)"
        return None, None
    derived = {"tor": "onion", "chutney": "onion", "https": "local"}
    if lvl == "L2" and reach and reach != derived.get(net):
        return None, (f"{entry['id']} runs in its own throwaway test VM, so its row follows --net ({net} → "
                      f"{derived.get(net)}); drop --reach {reach}")
    if not reach:
        if required:
            return None, ("--reach is required: the diagram's Reach — "
                          + " | ".join(r["id"] for r in sm.get("reaches", [])) + " — or local (harness, VM https); "
                          "plus --name buy|duckdns|trycf where that reach has names. See ./dash setups")
        reach = derived.get(net)
        if not reach:
            return None, None
    rdef = next((x for x in sm.get("reaches", []) if x["id"] == reach), None)
    allowed_names = (rdef or {}).get("names") or []
    if allowed_names and not name:
        return None, f"--reach {reach} needs --name {'|'.join(allowed_names)} (the diagram's Name toggle)"
    if name and not allowed_names:
        return None, f"--reach {reach} has no Name choice in the diagram — drop --name {name}"
    if name and name not in allowed_names:
        return None, f"--reach {reach} --name must be one of {'|'.join(allowed_names)} (got {name})"
    cands = [x for x in rows if x["reach"] == reach and (x.get("name") or None) == (name or None)]
    if not cands:
        return None, f"unknown reach '{reach}' — use one of: " + " | ".join(
            sorted({x['reach'] for x in rows if not x.get('future') and not x.get('greyed')}))
    r = next((x for x in cands if x["net"] == net), None)
    if not r:
        return None, (f"--reach {reach}{' --name ' + name if name else ''} goes with --net "
                      f"{' | '.join(x['net'] for x in cands if not x.get('greyed')) or '(none — greyed out)'}, not --net {net}")
    if r.get("future"):
        return None, f"{r['label']}: roadmap transport, not wired yet"
    if r.get("greyed"):
        return None, f"{r['label']}: {r['greyed']}"   # the label says "(greyed out)"
    if r.get("setups") and setup and setup not in r["setups"]:
        return None, f"N/A — {r['label']} is harness-only (setups: {', '.join(r['setups'])}), not for --on {setup}. {r.get('desc', '')}"
    if check_wired and lvl == "L3" and _setup_backend_kind(setup) not in (r.get("l3_wired") or []):
        return None, f"not wired yet — L3 over {r['label']} on --on {setup}: {r.get('desc', '')}"
    return r, None


def resolve_method(entry, method, cat=None):
    """(canonical setup a run lands in, None) or (None, why) — shared by `run` and `report`. --on takes a diagram
    setup (or a legacy alias); the harness test-vm is only valid as an entry's OWN method (L2). An install id names
    its setup (install.cable-0d) — or only its Install method (install.cable), then --on picks the Network variant;
    --on may repeat the id's setup but never contradict it."""
    cat = cat or load_catalog()
    m_in, err = canon_setup(method, cat)
    if err:
        return None, f"--on {method}: {err}"
    m_entry, _ = canon_setup(entry.get("method"), cat)
    if m_in and m_in not in setup_ids(cat) and m_in != m_entry:
        return None, (f"--on {m_in} is harness-only (the L1/L2 self-contained test VM), not a setup you pass — "
                      f"use one of: {' | '.join(setup_ids(cat))}")
    if m_in and entry.get("level") in ("L1", "L2") and m_in != m_entry:
        return None, f"{entry['id']} runs in its own throwaway test VM — it takes no --on (got --on {method})"
    if entry.get("category") != "install":
        return m_in or m_entry or "-", None
    fam = (setup_entry(m_entry, cat) or {}).get("method") if m_entry else entry.get("method")
    if m_entry in setup_ids(cat):
        if m_in and m_in != m_entry:
            return None, f"{entry['id']} installs setup {m_entry}; --on {method} contradicts it."
        return m_entry, None
    if m_in and (setup_entry(m_in, cat) or {}).get("method") == fam:
        return m_in, None
    var = [x for x in (entry.get("setups") or []) if x in setup_ids(cat)]
    return None, (f"{entry['id']} needs its Network variant (the diagram's Network toggle): run "
                  + " | ".join(f"install.{x}" for x in var) + (f"  (got --on {method})" if method else ""))


def _setup_backend_kind(setup):
    """Which kind of backend a `--on <setup>` names: an external physical 'box' (reached over the LAN
    via SSH key — every cable-*/wifi-*/usb-* setup) vs the local 'vm' (VirtualBox on this host, or the
    self-contained test-VM). L3 against a box must pass the box-identity gate + needs --ip/--key/--token;
    L3 on the vm does not (the VM is local and has no deploy stamp). Legacy ids (lan-setup-0d, …) count
    via their alias; the old coarse names (usb, native-ethernet) were boxes too."""
    s = (setup or "").strip()
    sid, _ = canon_setup(s)
    if sid:
        return "box" if (setup_entry(sid) or {}).get("backend") == "box" else "vm"
    return "box" if s in ("usb", "native-ethernet", "lan-setup-0") else "vm"   # "-", unset, …


def _setup_family(setup):
    """The install-METHOD family of a setup — what actually determines how the box got installed:
    `usb` (installer USB → disk) vs `lan` (netboot + nixos-anywhere: the diagram's LAN-cable and Wifi
    installs) vs `vm` (local VirtualBox). The Network variants (…-0a/0b/0d/0c) share ONE install and
    differ only in post-install connectivity, so they map to the same family. Used to stop a result
    landing in the wrong install-method column (e.g. a usb cell green against a lan-installed box).
    Box stamps written before the rename carry legacy ids (lan-setup-0d) — resolved via the aliases."""
    s = (setup or "").strip()
    sid, _ = canon_setup(s)
    if sid:
        cat = load_catalog()
        m = (setup_entry(sid, cat) or {}).get("method")
        return next((x.get("family") for x in (cat.get("setup_map") or {}).get("methods", []) if x["id"] == m), "vm")
    if s.startswith("usb"):
        return "usb"
    if s.startswith("lan-setup") or s == "native-ethernet":
        return "lan"
    return "vm"   # test-vm / unset


def _ssh_base(key):
    o = ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
         "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]
    if key:
        o += ["-i", os.path.expanduser(key)]
    return o


def ssh_reachable(ip, key):
    return subprocess.run(_ssh_base(key) + [f"root@{ip}", "true"], capture_output=True).returncode == 0


def read_box_stamp(ip, key):
    """The /etc/dev-test-build.json a box was deployed with, or None if unreachable/unstamped."""
    try:
        raw = subprocess.check_output(_ssh_base(key) + [f"root@{ip}", "cat /etc/dev-test-build.json"], stderr=subprocess.DEVNULL).decode()
        return json.loads(raw)
    except Exception:
        return None


def box_pin_diffs(stamp, want):
    """List of 'k: box=X vs code=Y' where the box's deployed pin != the current code pin."""
    out = []
    for k in ("selfprivacy-api", "nixpkgs"):
        w = want.get(k)
        if w and not str(stamp.get(k, "")).startswith(w):
            out.append(f"{k}: box={str(stamp.get(k, '?'))[:12]} vs code={w}")
    return out


def read_box_live(ip, key):
    """MEASURE the box's ACTUAL running system (not the install-time stamp, which is only a claim):
    the /run/current-system store path + nixos-version. None if unreachable. Lets the gate catch a
    box that was nixos-rebuilt / hand-edited AFTER it was stamped — the stamp wouldn't change, but
    the running closure would."""
    try:
        out = subprocess.check_output(
            _ssh_base(key) + [f"root@{ip}",
                              "printf '%s\\n%s' \"$(readlink -f /run/current-system)\" \"$(nixos-version 2>/dev/null)\""],
            stderr=subprocess.DEVNULL).decode().splitlines()
        return {"system": (out[0].strip() if out else ""),
                "nixos_version": (out[1].strip() if len(out) > 1 else "")}
    except Exception:
        return None


def submodule_drift(rel):
    """If `rel` is a git submodule whose working checkout differs from the superproject's
    recorded pointer, return a message; else None. (So 'manager clean' can't hide an app
    checkout that doesn't match manager's recorded gitlink.)"""
    if not rel:
        return None
    repo = os.path.normpath(os.path.join(ROOT, rel))
    if not _is_git(repo):
        return None
    try:
        sup = subprocess.check_output(["git", "-C", repo, "rev-parse", "--show-superproject-working-tree"], stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return None
    if not sup:
        return None
    subrel = os.path.relpath(repo, sup)
    try:
        out = subprocess.check_output(["git", "-C", sup, "submodule", "status", "--", subrel], stderr=subprocess.DEVNULL).decode()
    except Exception:
        return None
    if out and out[0] in "+-U":
        return f"{subrel}: checkout {out[1:11].strip()} differs from {os.path.basename(sup)}'s recorded submodule pointer"
    return None


def gen_run_id():
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    return f"{stamp}-{os.urandom(2).hex()}"


def append_record(rec):
    os.makedirs(os.path.dirname(DATA), exist_ok=True)
    with open(DATA, "a") as f:
        f.write(json.dumps(rec) + "\n")


def cmd_backfill_provenance(args):
    """One-time migration: add dial_domain (+ socks_port) to existing app-run records by
    parsing the dart-defines out of each run's log header. Idempotent (skips records that
    already carry it, or that have no parseable app command)."""
    if not os.path.exists(DATA):
        print("no results.jsonl")
        return
    out, changed = [], 0
    for line in open(DATA):
        if not line.strip():
            out.append(line.rstrip("\n"))
            continue
        r = json.loads(line)
        if "dial_domain" not in r:
            lp = (r.get("artifacts") or {}).get("client_log") or r.get("log_path")
            prov = extract_provenance(log_header_cmd(os.path.join(ROOT, lp))) if lp else {}
            if prov:
                r.update(prov)
                changed += 1
        out.append(json.dumps(r))
    with open(DATA, "w") as f:
        f.write("\n".join(out) + "\n")
    print(f"backfilled provenance into {changed} record(s)")


def drop_record(run_id):
    """Remove a previously-appended record by run_id (used to discard a transient retry attempt so
    the board isn't polluted with flaky-Tor failures we immediately retried past)."""
    if not run_id or not os.path.exists(DATA):
        return
    kept = [l for l in open(DATA) if l.strip() and json.loads(l).get("run_id") != run_id]
    open(DATA, "w").write("".join(kept))


def mark_record(run_id, **fields):
    """Update an already-appended record in place (by run_id) with extra fields — used to RETAIN a
    transient retry attempt marked flaky, instead of deleting it (so real-but-intermittent failures
    aren't silently hidden; the cell headline is still the later pass, flaky fails live in history)."""
    if not run_id or not os.path.exists(DATA):
        return
    out = []
    for l in open(DATA):
        if not l.strip():
            continue
        r = json.loads(l)
        if r.get("run_id") == run_id:
            r.update(fields)
        out.append(json.dumps(r))
    open(DATA, "w").write("\n".join(out) + "\n")


def repos_behind_upstream(repos, fetch=False):
    """{name: n} for each repo whose local HEAD is n commits BEHIND its tracked upstream (0 omitted).
    With fetch=True, refresh the remote-tracking ref first (best-effort, short timeout) so the count
    reflects the TRUE latest — not a stale last-fetch. Offline: the fetch is skipped and the compare
    falls back to the last-known upstream (so a confirmed-behind still trips; an unverifiable one
    doesn't). Catches testing a stale checkout while believing it's the latest code."""
    try:
        pr = (load_catalog().get("project_repos") or {})
    except Exception:
        pr = {}
    out = {}
    for r in repos:
        rel = pr.get(r.get("name"))
        if not rel:
            continue
        repo = os.path.normpath(os.path.join(ROOT, rel))
        if fetch:
            try:
                subprocess.run(["git", "-C", repo, "fetch", "--quiet"], timeout=30,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        try:
            n = subprocess.check_output(["git", "-C", repo, "rev-list", "--count", "HEAD..@{u}"],
                                        stderr=subprocess.DEVNULL).decode().strip()
            if n and n != "0":
                out[r["name"]] = int(n)
        except Exception:
            pass
    return out


def summarize_error(log_path):
    """Pull a one-line error summary out of a log (best effort, generic across tools)."""
    try:
        lines = open(log_path, errors="replace").read().splitlines()
    except Exception:
        return ""
    keys = ("error:", "Error", "Traceback", "assert", "AssertionError", "FAILED", "failed",
            "Exception", "Timeout", "cannot", "not found", "refused")
    hits = [l.strip() for l in lines if any(k in l for k in keys) and l.strip()]
    # Prefer a pytest/nix summary-ish line if present.
    for l in reversed(hits):
        if " failed" in l or "FAILED" in l or "AssertionError" in l or "error:" in l:
            return scrub(l[:240])
    return scrub(hits[-1][:240] if hits else "")


def classify(exit_code, duration, budget):
    if exit_code == 0:
        return "slow" if (budget and duration > budget) else "pass"
    return "fail"


def start_recording(run_id):
    """Record the app UI. Prefer a HEADLESS Xvfb: on Wayland/GNOME, x11grab of the real :0 captures
    black (rootless XWayland), so we render the app into a private Xvfb framebuffer and capture that —
    session-independent, small, always the app. Returns a dict incl. the DISPLAY the app must use."""
    if not shutil.which("ffmpeg"):
        print(f"{GREY}(ffmpeg missing — skipping video){OFF}")
        return None
    os.makedirs(MEDIA, exist_ok=True)
    out = os.path.join(MEDIA, run_id + ".mp4")
    size = "1280x800"
    try:
        if shutil.which("Xvfb"):
            disp = ":99"
            xvfb = subprocess.Popen(["Xvfb", disp, "-screen", "0", size + "x24", "-nolisten", "tcp"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(2)
            ff = subprocess.Popen(["ffmpeg", "-y", "-f", "x11grab", "-video_size", size, "-framerate", "12",
                                   "-i", disp, "-pix_fmt", "yuv420p", out],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.PIPE)
            print(f"{GREY}(recording the app headlessly via Xvfb {disp} → {os.path.relpath(out, ROOT)}){OFF}")
            return {"procs": [ff, xvfb], "out": out,
                    "env": {"DISPLAY": disp, "GDK_BACKEND": "x11", "LIBGL_ALWAYS_SOFTWARE": "1"}}
        x = os.environ.get("DISPLAY")
        if not x:
            print(f"{GREY}(no Xvfb and no X display — skipping video){OFF}")
            return None
        ff = subprocess.Popen(["ffmpeg", "-y", "-f", "x11grab", "-framerate", "12", "-i", x, "-pix_fmt", "yuv420p", out],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.PIPE)
        print(f"{AMBER}(recording ambient X — likely blank on Wayland; install {CYAN}xvfb{OFF}{AMBER} "
              f"[or run --setup] for a real recording){OFF}")
        return {"procs": [ff], "out": out, "env": {"GDK_BACKEND": "x11"}}
    except Exception as ex:
        print(f"{GREY}(recorder failed: {ex}){OFF}")
        return None


def trim_black(path, pad=0.3):
    """Drop the leading/trailing all-black stretch from a recording. `flutter test -d linux` spends
    the first ~20s BUILDING the app (no window on the display yet → black), then the UI shows for the
    last few seconds; without this the mp4 is 'mostly black'. Uses ffmpeg blackdetect to find the
    content window and re-encodes just that span. Best-effort: leaves the file untouched on any doubt."""
    try:
        r = subprocess.run(["ffmpeg", "-i", path, "-vf",
                            "blackdetect=d=0.2:pic_th=0.98:pix_th=0.10", "-f", "null", "-"],
                           capture_output=True, text=True, timeout=120)
        dur = None
        d = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                            "-of", "default=nw=1:nk=1", path], capture_output=True, text=True, timeout=30)
        try:
            dur = float(d.stdout.strip())
        except ValueError:
            return   # can't reason about the tail without a duration
        spans = re.findall(r"black_start:([\d.]+) black_end:([\d.]+)", r.stderr)
        start, end = 0.0, dur
        for bs, be in spans:
            bs, be = float(bs), float(be)
            if bs <= 0.2 and be > start:              # leading black (the build)
                start = be
            if be >= dur - 0.2 and bs < end:          # trailing black (teardown)
                end = bs
        start = max(0.0, start - pad)
        end = min(dur, end + pad)
        if end - start < 1.0 or (start <= 0.2 and end >= dur - 0.2):
            return   # nothing worth trimming, or it'd leave < 1s — keep the original
        tmp = path + ".trim.mp4"
        t = subprocess.run(["ffmpeg", "-y", "-i", path, "-ss", f"{start:.2f}", "-to", f"{end:.2f}",
                            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-an", tmp],
                           capture_output=True, text=True, timeout=180)
        if t.returncode == 0 and os.path.exists(tmp) and os.path.getsize(tmp) > 1000:
            os.replace(tmp, path)
            print(f"{GREY}(trimmed recording to the {end - start:.1f}s where the UI is visible){OFF}")
        elif os.path.exists(tmp):
            os.remove(tmp)
    except Exception as ex:
        print(f"{GREY}(video trim skipped: {ex}){OFF}")


def stop_recording(rec):
    if not rec:
        return ""
    for p in rec["procs"]:                     # ffmpeg first (SIGINT finalizes the mp4), then Xvfb
        try:
            p.send_signal(signal.SIGINT)
            p.wait(timeout=12)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
    out = rec["out"]
    if os.path.exists(out) and os.path.getsize(out) > 1000:
        trim_black(out)
        return os.path.relpath(out, ROOT)
    return ""


def pull_server_log(cmd, run_id):
    """Best-effort fetch of backend logs (e.g. an ssh journalctl). Onions scrubbed."""
    out = os.path.join(LOGS, run_id + ".server.log")
    try:
        with open(out, "w") as f:
            subprocess.run(cmd, shell=True, stdout=f, stderr=subprocess.STDOUT, timeout=90)
        open(out, "w").write(scrub(open(out, errors="replace").read()))
        return os.path.relpath(out, ROOT)
    except Exception:
        return ""


def collect_screenshots(shot_dir):
    """Gather per-step PNGs the test wrote into shot_dir, sorted by their NN- prefix."""
    if not shot_dir or not os.path.isdir(shot_dir):
        return []
    pngs = sorted(f for f in os.listdir(shot_dir) if f.endswith(".png")
                  and os.path.getsize(os.path.join(shot_dir, f)) > 1000)
    return [os.path.relpath(os.path.join(shot_dir, f), ROOT) for f in pngs]


def scrub_onion(dom):
    """Keep a .onion recognisable but not fully published: first 8 + last 6 base32 chars.
    Enough to eyeball-match against the (local, git-ignored) log; not the whole address."""
    m = re.match(r"^([a-z2-7]{16,})\.onion$", dom or "")
    return f"{m.group(1)[:8]}…{m.group(1)[-6:]}.onion" if m else (dom or "")


def extract_provenance(cmd):
    """Surface WHICH network endpoint the app actually dialed, straight from the flutter
    dart-defines, so a run's transport is self-evident without opening the log:
      onion transports → ONION_DOMAIN (scrubbed) + SOCKS_PORT (tor=9050, chutney=its client port)
      https            → HTTPS_DOMAIN, no SOCKS.
    Returns {} for non-app runs (L1/L2 have no dart-defines)."""
    prov = {}
    onion = re.search(r"--dart-define=ONION_DOMAIN=(\S+)", cmd or "")
    https = re.search(r"--dart-define=HTTPS_DOMAIN=(\S+)", cmd or "")
    if onion:
        prov["dial_domain"] = scrub_onion(onion.group(1))
    elif https:
        prov["dial_domain"] = https.group(1)
    else:
        return {}
    sp = re.search(r"--dart-define=SOCKS_PORT=(\d+)", cmd or "")
    prov["socks_port"] = int(sp.group(1)) if sp else None
    return prov


def log_header_cmd(path):
    """Read the `# <cmd>` line dash wrote at the top of a run log (holds the dart-defines)."""
    try:
        with open(path, errors="replace") as f:
            for _ in range(6):
                line = f.readline()
                if not line:
                    break
                if "--dart-define=" in line:
                    return line.lstrip("# ").strip()
    except OSError:
        pass
    return ""


def missing_local_cmd(cmd, run_dir):
    """Best-effort guard: if the command invokes a local script/binary by a relative or
    absolute path that doesn't exist (relative paths resolved against run_dir), return that
    path so the caller can emit a clear 'harness/catalog path error' instead of a cryptic
    '/bin/sh: … not found' that reads like a target/device failure.

    Deliberately conservative to avoid false positives: skips env-var prefixes (FOO=bar),
    common wrappers (sudo/env/exec/…), and bare PATH command names; bails out (returns None)
    on any compound/shell command (cd, pipes, &&, ;, redirects) it can't reason about safely."""
    try:
        import shlex
        toks = shlex.split(cmd)
    except Exception:
        return None
    for t in toks:
        if any(op in t for op in (";", "&&", "||", "|", "&", ">", "<", "`")) or t in ("cd", "sudo", "env", "exec", "nice", "time"):
            return None  # too complex / wrapped to reason about safely
        if "=" in t and not t.startswith(("/", "./", "../")) and "/" not in t.split("=", 1)[0]:
            continue     # env assignment prefix (FOO=bar)
        looks_local = t.startswith(("/", "./", "../")) or "/" in t or t.endswith((".sh", ".py"))
        if not looks_local:
            return None  # bare command name resolved via PATH — don't second-guess
        cand = t if os.path.isabs(t) else os.path.join(run_dir, t)
        return None if os.path.exists(cand) else t
    return None


def run_entry(entry, config_label=None, net=None, method=None, record=False, server_log=None, shots=False, ip=None, extra_env=None, allow_dirty=False, reach=None, reach_name=None):
    # Every run — `run`, `wrap`, `here`, the VM bring-up, the inner L3 recorder — first checks the matrix still
    # matches the setup diagram (req 183), so no result is ever filed under drifted axes.
    _gate = alignment_gate()
    if _gate:
        print(f"{entry['id']}: {_gate}")
        return None
    cmd = entry.get("cmd", "")
    nets = entry.get("networks") or []
    # --net is REQUIRED for any net-bearing test (no implicit "first net" default).
    if nets and not net:
        print(f"{RED}error{OFF}  {entry['id']} — --net is required (one of: {'/'.join(nets)}); no implicit default")
        return None
    if entry.get("cmd_by_net"):
        cmd = entry["cmd_by_net"].get(net, "")
        if not cmd:
            print(f"{RED}error{OFF}  {entry['id']} — no command for --net {net} (have: {'/'.join(entry['cmd_by_net'])})")
            return None

    net_tag = net or "-"
    # Setups are the setup diagram's views (cable-0a … usb-0c, vm); legacy ids are accepted as aliases and
    # recorded under the canonical id, so old commands keep working and every result lands in one column.
    _cat = load_catalog()
    method_tag, _m_err = resolve_method(entry, method, _cat)
    if _m_err:
        print(f"{RED}setup{OFF}  {entry['id']} — {_m_err}")
        return None

    # Fast, args-only short-circuits BEFORE any git fetch / lock reads / SSH (the slow per-entry work,
    # esp. repos_behind_upstream(fetch=True) which runs `git fetch` on every repo). A no-op (@todo /
    # @manual) or an @flutter run whose args can't possibly work (no --on, a box setup missing
    # --ip/--key/--token, chutney on a box) must fail instantly, not after a minute of git I/O. The
    # authoritative box checks (SSH reachability, live onion/domain, stamp identity) still run later for
    # valid args — these only reject the obviously-doomed arg combos.
    if cmd == "@todo":
        print(f"{GREY}todo{OFF}  {entry['id']}  — automated test not written yet (no record appended)")
        return None
    if cmd == "@manual":
        print(f"{AMBER}manual{OFF}  {entry['id']}  — run it, then log with:")
        print(f"  ./dash report {entry['id']} --status pass --duration <seconds> [--config ..]")
        return None
    if cmd == "@flutter":
        if entry.get("client") == "android" or entry["id"].endswith(".android"):
            print(f"{AMBER}android L3 not supported by this runner yet{OFF}  {entry['id']}")
            return None
        if method_tag in (None, "", "-"):
            print(f"{RED}no setup{OFF}  {entry['id']} — --on is required: {' | '.join(setup_ids(_cat))}  "
                  f"(the setup diagram's Install+Network views; ./dash setups).")
            return None
        if _setup_backend_kind(method_tag) == "box":
            _miss = [n for n, v in (("--ip", ip or _env_get(extra_env, "IP")),
                                    ("--key", _env_get(extra_env, "KEY")),
                                    ("--token", _env_get(extra_env, "API_TOKEN"))) if not v]
            if _miss:
                print(f"{RED}missing args{OFF}  {entry['id']} on {method_tag} runs against a box; "
                      f"required: {', '.join(_miss)} (a box's API token is per-box + secret, never defaulted).")
                return None
            if net == "chutney":
                print(f"{RED}N/A{OFF}  {entry['id']} — chutney is VM-only (--on vm); a box uses tor|https. "
                      f"Use --net tor|https.")
                return None
    # The diagram's Reach (+ Name) for this run → its matrix row. Args-only, so it also fails fast (req 114).
    _row, _r_err = resolve_reach(entry, net, method_tag, reach, reach_name, _cat)
    if _r_err:
        print(f"{RED}reach{OFF}  {entry['id']} [on={method_tag} net={net_tag}] — {_r_err}")
        return None
    if entry.get("reach_row") and _setup_backend_kind(method_tag) == "box":
        _miss = [n for n, v in (("--ip", ip or _env_get(extra_env, "IP")), ("--key", _env_get(extra_env, "KEY"))) if not v]
        if _miss:
            print(f"{RED}missing args{OFF}  {entry['id']} on {method_tag} configures the box over SSH; required: {', '.join(_miss)}.")
            return None

    gs = git_state(entry.get("repo"))
    run_id = gen_run_id()
    _lock = resolve_lock(extra_env, entry)
    _repos = project_repo_states(entry_repos(entry))   # only the repos this test depends on
    _behind = repos_behind_upstream(_repos, fetch=True)   # testing a stale checkout? (gated below)
    _pins = flake_pins(_lock)
    _mm = api_pin_mismatch(_lock)
    _mm_mgr = lock_input_mismatch(_lock, "manager", "manager")   # self-contained test flakes pin manager too
    _pin_problems = [m for m in (_mm, _mm_mgr) if m]
    _dirty_repos = [r["name"] for r in _repos if r.get("dirty")]
    _pr = (load_catalog().get("project_repos") or {})
    _drift = []
    for _n in (entry_repos(entry) or list(_pr)):
        _d = submodule_drift(_pr.get(_n))
        if _d:
            _drift.append(_d)
    # One hash identifying the whole code state (all repos' commits + their dirtiness).
    _state_hash = _state_hash_of(_repos)
    base = {
        "run_id": run_id, "ts": now_iso(), "env": "ci" if is_ci() else "local",
        "host": socket.gethostname(), "category": entry.get("category", "test"),
        "id": entry["id"], "name": entry.get("name", entry["id"]), "level": entry.get("level", ""),
        "client": entry.get("client", "-"), "transport": net_tag,
        "backend": entry.get("backend", "-"), "method": method_tag,
        # the setup diagram's Reach + Name for this run (its matrix row) and the diagram view it belongs to
        "reach": (_row or {}).get("reach"), "reach_name": (_row or {}).get("name"), "reach_row": (_row or {}).get("id"),
        "diagram_view": diagram_view(method_tag, (_row or {}).get("id"), _cat),
        "records_video": bool(entry.get("records_video")),
        "config_label": config_label or ("dirty" if _dirty_repos else ""),
        "source": "automated", "behind_upstream": _behind,
        "repos": _repos, "pins": _pins, "pin_mismatch": _mm or _mm_mgr, "state_hash": _state_hash,
        **{k: gs[k] for k in ("repo", "branch", "commit", "subject", "dirty", "diff_hash")},
        **extract_provenance(cmd),   # dial_domain (+ socks_port) for app runs → self-evident transport
    }

    # (@todo / @manual and the args-only @flutter preconditions already short-circuited above, before
    # any git fetch — see the fast block right after method_tag.)

    # Which runs are gated for integrity: installs (category) AND tests (identified by `level`: L1/L2/
    # L3). Catalog test entries carry no `category`, so keying only on category silently skipped the
    # clean-state / pin / behind-upstream gates for every test — they only ever fired for installs.
    # A test must run on committed, in-sync, latest code too (reqs 42-45, 77-79, 88). `_no_gate` is set
    # by the L3 inner recorder, whose outer run_entry already gated this run.
    _gated = (entry.get("category") in ("test", "install") or bool(entry.get("level"))) \
        and not entry.get("_no_gate")

    # Stale-checkout gate: a repo BEHIND its (freshly-fetched) upstream means you'd test OLD code while
    # believing it's the latest — refuse, since tests only ever run against the newest committed code.
    # Recorded in `behind_upstream`. Bypass with --allow-dirty (then it's flagged as forced).
    if _gated and _behind and not allow_dirty:
        print(f"{RED}behind-upstream{OFF}  {entry['id']} — local checkout is behind: " +
              ", ".join(f"{k} by {v}" for k, v in _behind.items()) + ".")
        print(f"  you'd be testing non-latest code. {CYAN}git pull{OFF} in each, or pass --allow-dirty.")
        return None

    # Clean-state gate: run tests/installs only on committed code so every run on a state shares
    # it. Checks ALL repos the test uses (so e.g. a dirty app checkout for an L3 run is caught —
    # not just the primary repo). Results live in the separate testresults repo, so they never
    # dirty the code. Override with --allow-dirty.
    if _gated and (_dirty_repos or _drift) and not allow_dirty:
        if _dirty_repos:
            print(f"{RED}dirty{OFF}  {entry['id']} — uncommitted changes in: {', '.join(_dirty_repos)}.")
        for _d in _drift:
            print(f"{RED}submodule-drift{OFF}  {entry['id']} — {_d}.")
        print(f"  commit/sync them so every run shares one state, or pass --allow-dirty.")
        return None

    # Pin gate: the build/deploy uses the revs PINNED in the flake.lock (of the flake this run
    # actually builds — for a self-contained L2 test that's its OWN tests flake, not the backend)
    # — not your local checkouts. If a pinned input (api OR manager) differs from its checkout the
    # run wouldn't exercise your code, so the result would be mislabelled. Refuse unless
    # --allow-dirty. (This is what catches a stale test flake.lock cache-hitting an old build.)
    if _gated and _pin_problems and not allow_dirty:
        for m in _pin_problems:
            print(f"{RED}pin-mismatch{OFF}  {entry['id']} — {m['msg']}.")
        print(f"  bump the flake input to match (`nix flake update` in the flake under test) or check out the pinned rev; or pass --allow-dirty.")
        return None

    # Hidden-input guard (req 91): build-affecting files `git status` can't see. A guard_path that is
    # gitignored + present is INVISIBLE to the clean-state gate yet can change the build, so a random
    # person's clean checkout would build something different. Recorded (`guard_files`) + warned; not a
    # hard refuse (a present file may be legitimately required) — surfaced for a human to judge.
    _guard_hits = guard_file_hits(entry_repos(entry), load_catalog().get("guard_paths") or []) if _gated else []
    base["guard_files"] = _guard_hits
    for _h in _guard_hits:
        print(f"{AMBER}guard-file{OFF}  {entry['id']} — {_h['repo']}/{_h['path']} is gitignored + present "
              f"(sha {_h['sha']}); INVISIBLE to `git status`, yet it can change the build. Recorded.")

    # Nix hermeticity gate: an L1/L2 nixosTest builds + boots a VM that must come ONLY from the
    # committed code. A disabled sandbox or an --impure build can leak host state into that "hermetic"
    # VM → a pass wouldn't prove the committed code ran. Refuse unless --allow-dirty (then flagged
    # forced). Scoped to the self-contained VM builds; L3 (host flutter) / installs are inherently not
    # a hermetic VM build, so the host sandbox setting doesn't change what they prove.
    _herm_scope = _self_contained(entry) or entry.get("level") in ("L1", "L2")
    _sandbox = nix_sandbox() if _herm_scope else ""
    _impure = ("--impure" in cmd) if _herm_scope else False
    _herm_problems = []
    if _herm_scope:
        if _sandbox and _sandbox != "true":
            _herm_problems.append(f"nix sandbox={_sandbox} (non-hermetic build)")
        if _impure:
            _herm_problems.append("--impure in the build command")
    base["nix_sandbox"] = _sandbox
    base["impure"] = _impure
    base["hermetic"] = (not _herm_problems) if _herm_scope else None
    base["hermetic_problems"] = _herm_problems
    if _herm_problems and not allow_dirty:
        for m in _herm_problems:
            print(f"{RED}non-hermetic{OFF}  {entry['id']} — {m}.")
        print(f"  a self-contained VM build must be hermetic so the result reflects only the committed "
              f"code. Set `sandbox = true` in nix.conf / drop --impure, or pass --allow-dirty.")
        return None

    # Box-identity gate: a test that runs against the target must run against a box deployed from
    # the CURRENT code. Read the box's /etc/dev-test-build.json; record it as the source of truth
    # (box_stamp + box_stale) and refuse if the box is unreachable/unstamped/stale — unless
    # --allow-dirty forces the run (in which case the staleness is still recorded, not hidden).
    if needs_box(entry) and _setup_backend_kind(method_tag) == "box":
        _bip = ip or _env_get(extra_env, "IP")
        _bkey = _env_get(extra_env, "KEY")
        _reach = bool(_bip and _bkey) and ssh_reachable(_bip, _bkey)
        _stamp = read_box_stamp(_bip, _bkey) if _reach else None
        if _stamp is None:
            if not allow_dirty:
                if not _bip or not _bkey:
                    print(f"{RED}no-box{OFF}  {entry['id']} — runs against the target box; pass --ip <box> --key <ssh key> (and --token <api token> for L3).")
                elif not _reach:
                    print(f"{RED}box-unreachable{OFF}  {entry['id']} — root@{_bip} not reachable over SSH (box down / wrong IP / wrong key).")
                else:
                    print(f"{RED}box-not-stamped{OFF}  {entry['id']} — root@{_bip} is reachable but has no /etc/dev-test-build.json; (re)deploy it to stamp its build identity.")
                return None
            # forced past the box-identity gate: the box's code identity was never checked (req 85)
            base["box_unverified"] = ("no --ip/--key" if (not _bip or not _bkey) else
                                      "unreachable" if not _reach else "not stamped")
        else:
            base["box_stamp"] = _stamp
            _bd = box_pin_diffs(_stamp, _pins)
            # MEASURE the box's running system (don't just trust the stamp, which is an install-time
            # claim): catch a box nixos-rebuilt / hand-edited after install — the stamp wouldn't
            # change, but /run/current-system would.
            _live = read_box_live(_bip, _bkey)
            if _live:
                base["box_live"] = _live
                # The box's actual running-system store path IS the closure identity for a box run
                # (the exact built system, beyond the 3 pins; req 92).
                if _live.get("system"):
                    base["closure"] = _live["system"]
                _baseline = _stamp.get("system")
                if _baseline and _live.get("system") and _live["system"] != _baseline:
                    _bd = _bd + [f"running system {_live['system'][:28]}… ≠ stamped {str(_baseline)[:28]}… "
                                 f"(box rebuilt/edited since install)"]
                elif not _baseline:
                    print(f"{GREY}note{OFF}  {entry['id']} — box stamp has no running-system baseline; "
                          f"redeploy to enable drift detection.")
            base["box_stale"] = bool(_bd)
            # Install-method gate (reqs 20-28/37): the box must have been installed the way THIS cell
            # claims. The stamp proves code identity, not how it was installed — so without this a
            # usb-* result could go green against a lan-installed box (a false positive for usb). Match
            # the install-method FAMILY (usb vs lan/netboot vs vm); the fine a/b/c/d variants share one
            # install. Older boxes stamped before `method` was recorded skip this (noted).
            _box_method = _stamp.get("method")
            base["box_method"] = _box_method
            if _box_method is None:
                print(f"{GREY}note{OFF}  {entry['id']} — box stamp has no install `method`; "
                      f"redeploy to enable install-method verification.")
            elif ((canon_setup(_box_method)[0] or "") in setup_ids()
                  and canon_setup(_box_method)[0] != method_tag) or (
                    (canon_setup(_box_method)[0] or "") not in setup_ids()
                    and _setup_family(_box_method) != _setup_family(method_tag)):
                # Since the matrix columns are the setup diagram's Install × Network views (req 168), the box
                # must have been installed as exactly this setup; an old coarse stamp (lan-setup-0) can only be
                # checked by its install family.
                base["box_method_mismatch"] = True
                print(f"{RED}install-setup mismatch{OFF}  {entry['id']} — box was installed as {_box_method}"
                      f" ({canon_setup(_box_method)[0] or 'family ' + _setup_family(_box_method)}), but --on "
                      f"{method_tag} claims another setup.")
                print(f"  a {method_tag} result must run against a box installed as {method_tag} (else it's a "
                      f"false positive for that column). (Re)install it that way, or pass --allow-dirty.")
                if not allow_dirty:
                    return None
            # Record what the BOX actually runs (its stamp = source of truth) as the server-side
            # state, plus the local client repo(s) — not the workstation's server checkout.
            _server = _stamp.get("repos") or []
            if _server:
                _snames = {s.get("name") for s in _server}
                _client = [r for r in _repos if r.get("name") not in _snames]
                base["repos"] = _server + _client
                if _stamp.get("pins"):
                    base["pins"] = _stamp["pins"]
                base["box_state_hash"] = _stamp.get("state_hash")
            if _bd and not allow_dirty:
                print(f"{RED}stale-box{OFF}  {entry['id']} — the deployed box ≠ the current code:")
                for _d in _bd:
                    print(f"    {_d}")
                print(f"  redeploy the box before testing, or pass --allow-dirty.")
                return None

    # Preflight: for an actual install, refuse up-front (with a fix) if the
    # requested setup (--on) isn't feasible, instead of half-running.
    if entry.get("category") == "install":
        ok, msg = setup_preflight(method_tag)
        if not ok:
            print(f"{RED}preflight FAILED{OFF}  {entry['id']}  {GREY}[on={method_tag}]{OFF}")
            for line in msg.splitlines():
                print(f"  {line}")
            return None
        # Wifi setups (…-0b/0c/0d): the target ends up on wifi, so a wifi spec is mandatory — the e2e
        # verifies it's in range (non-disruptively, by scan) before installing.
        if _wifi_required(method_tag) and not _env_get(extra_env, "WIFI_SSID"):
            print(f"{RED}no wifi spec{OFF}  {entry['id']} [on={method_tag}] — this setup leaves the "
                  f"target on wifi; pass {CYAN}--env WIFI_SSID=<ssid>{OFF} (and --env WIFI_PSK=<pass> if "
                  f"needed). The install scans that the SSID is in range before writing anything.")
            return None

    def _forced_reasons():
        """Every gate this run was pushed past with --allow-dirty (req 85: never a silent clean pass)."""
        f = []
        if allow_dirty:
            if _dirty_repos:
                f.append("dirty:" + ",".join(_dirty_repos))
            if _drift:
                f.append("submodule-drift")
            if _behind:
                f.append("behind-upstream")
            if _pin_problems:
                f.append("pin-mismatch")
            if base.get("hermetic_problems"):
                f.append("non-hermetic")
            if base.get("box_stale"):
                f.append("stale-box")
            if base.get("box_method_mismatch"):
                f.append("install-method-mismatch")
            if base.get("box_unverified"):
                f.append("box-unverified:" + base["box_unverified"])
        return f

    if cmd == "@flutter":
        # L3 desktop flow: not a shell command. Resolve the backend target from the setup/args and
        # drive the Flutter app against it, recording the real setup as the method (so the result
        # lands in the correct matrix column). Gates above (clean-state/pin/behind/box-identity) have
        # already run for this catalog entry; the inner recorder does not re-gate — so the gates this
        # run was FORCED past are decided here and carried onto the inner record (else an --allow-dirty
        # L3 run would be recorded as a clean pass, req 85).
        base["forced_reasons"] = _forced_reasons()
        base["forced"] = bool(base["forced_reasons"])
        if base["forced"]:
            print(f"{AMBER}  FORCED past: {', '.join(base['forced_reasons'])} (--allow-dirty) — the run is recorded as forced{OFF}")
        return _dispatch_l3(entry, net, method_tag, ip, extra_env, allow_dirty, base,
                            reach=base.get("reach"), reach_name=base.get("reach_name"))

    repo_dir = os.path.normpath(os.path.join(ROOT, entry["repo"])) if entry.get("repo") else ROOT
    # Where the command actually runs. Defaults to the repo dir so repo-relative cmds
    # (e.g. ./build-and-run.sh) keep working. An entry may set "cwd" (relative to the
    # dashboard root) when its script lives somewhere other than `repo` — e.g. the install
    # entries whose `repo` is the backend (for git provenance) but whose script is in
    # dev-dashboard/tools/. git provenance uses `git -C repo` and is independent of cwd.
    run_dir = os.path.normpath(os.path.join(ROOT, entry["cwd"])) if entry.get("cwd") else repo_dir

    # Fail fast with an unambiguous message if the command's own script/binary isn't where
    # we'll run it — instead of a cryptic "/bin/sh: … not found" (exit 127) that looks like
    # the target/device wasn't reachable.
    miss = missing_local_cmd(cmd, run_dir)
    if miss:
        rel = os.path.relpath(run_dir, ROOT) or "."
        print(f"{RED}FAILED{OFF}  {entry['id']}  {GREY}[net={net_tag} on={method_tag}]{OFF}")
        print(f"  command not found: {BOLD}{miss}{OFF} does not exist at cwd '{rel}'.")
        print(f"  This is a harness/catalog PATH error — NOT a target/device failure:")
        print(f"  the script never ran, so nothing ever tried to reach the target.")
        print(f"  Fix this entry's cmd/cwd in dev-dashboard/catalog.json.")
        rec = {**base, "status": "fail", "duration_s": 0.0, "exit_code": 127,
               "error": f"harness: '{miss}' not found at cwd '{rel}' — catalog/path error, not a target failure",
               "log_path": "", "artifacts": {"client_log": "", "server_log": "", "video": "", "screenshots": []}}
        append_record(rec)
        return rec

    # Full-closure identity (req 92): for a self-contained VM build (L1/L2), resolve the derivation
    # path — the exact build closure (every transitive input), not just the 3 pins. Fold a short hash
    # of it into `state_id` so two builds that differ in a transitive input can't collide on one id.
    if _self_contained(entry) or entry.get("level") in ("L1", "L2"):
        _drv = drv_of(cmd, run_dir)
        base["drv"] = _drv
        if _drv:
            base["closure"] = _drv
            base["state_id"] = f"{_state_hash}+{hashlib.sha256(_drv.encode()).hexdigest()[:8]}"
            print(f"{GREY}closure {os.path.basename(_drv)}{OFF}")
        else:
            print(f"{AMBER}note{OFF}  {entry['id']} — could not resolve a build closure (nix eval); "
                  f"recording pins only (no drv closure id).")

    log_path = os.path.join(LOGS, run_id + ".log")
    os.makedirs(LOGS, exist_ok=True)
    tags = f"{GREY}[net={net_tag} on={method_tag}]{OFF}"
    # Never let a box API token reach the terminal transcript or the log (logs are committed by ./dash publish):
    # redact the token values this run knows (--token → API_TOKEN, --dart-define=API_TOKEN=…) and any 64-hex string.
    _secret_vals = {v for v in [_env_get(extra_env, "API_TOKEN"), os.environ.get("API_TOKEN")]
                    + re.findall(r"API_TOKEN=(\S+)", cmd) if v and len(v) >= 8}

    def _redact(text):
        for v in _secret_vals:
            text = text.replace(v, "<redacted>")
        return _HEX64_RE.sub("<redacted-64hex>", text)

    print(f"{BOLD}▶ {entry['id']}{OFF} {tags}  {GREY}{_redact(cmd)}{OFF}")
    rec_handle = start_recording(run_id) if record else None
    # env precedence: entry "env" defaults < the caller's shell env < CLI overrides (--ip/--env)
    # < the recorder's display env. Install entries keep their per-setup default IP in "env".
    run_env = {**entry.get("env", {}), **os.environ}
    if ip:
        run_env["IP"] = ip
    for kv in (extra_env or []):
        k, sep, v = kv.partition("=")
        if sep:
            run_env[k.strip()] = v
    if rec_handle and rec_handle.get("env"):
        run_env.update(rec_handle["env"])       # run the app on the recorder's display (e.g. Xvfb :99)
    if entry.get("category") == "install":
        # Hand the FULL deploy identity to the installer so it stamps the box authoritatively
        # (repos/branches/commits used + dirtiness), not just api/nixpkgs pins.
        run_env["DEV_TEST_STAMP"] = json.dumps({"repos": _repos, "pins": _pins, "state_hash": _state_hash,
                                                 "dirty": bool(_dirty_repos), "method": method_tag})
    if entry.get("category") in ("install", "reach"):
        run_env["SP_SETUP"] = method_tag   # so the installer / reach apply's next-steps suggest the matching --on
    if entry.get("category") == "reach":
        # every input is on the command line (req 172) — and a prompt could not show through the line relay
        run_env["SP_NONINTERACTIVE"] = "1"
    shot_dir = ""
    if shots:                                    # the test grabs its own $DISPLAY into SHOT_DIR per step
        shot_dir = os.path.join(MEDIA, run_id + ".shots")
        os.makedirs(shot_dir, exist_ok=True)
        run_env["SHOT_DIR"] = shot_dir
        run_env["SHOT_SIZE"] = "1280x800"
    start = datetime.datetime.now()
    out_lines = 0
    subst = False
    with open(log_path, "w") as log:
        log.write(f"# {entry['id']}  net={net_tag} on={method_tag}\n# {_redact(cmd)}\n# cwd {run_dir}\n# started {now_iso()}\n\n")
        log.flush()
        try:
            proc = subprocess.Popen(cmd, shell=True, cwd=run_dir, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True, bufsize=1, env=run_env)
            for line in proc.stdout:
                line = _redact(line)
                sys.stdout.write(line)
                log.write(line)
                out_lines += 1
                if "copying path" in line or "substituting" in line or "will be fetched" in line:
                    subst = True
            proc.wait()
            code = proc.returncode
        except KeyboardInterrupt:
            proc.terminate()
            code = 130
        except Exception as ex:
            log.write(f"\n[dash] launch error: {ex}\n")
            code = 127
    duration = (datetime.datetime.now() - start).total_seconds()
    video = stop_recording(rec_handle)
    trim_log(log_path)
    slog_cmd = server_log or entry.get("server_log_cmd")
    server_log_path = pull_server_log(slog_cmd, run_id) if slog_cmd else ""
    status = classify(code, duration, entry.get("budget_s"))
    err = "" if status == "pass" else summarize_error(log_path)
    screenshots = collect_screenshots(shot_dir)
    if shots:
        print(f"{GREY}captured {len(screenshots)} step screenshot(s){OFF}")
    # Cache-hit: a self-contained nix build that produced NO output + exit 0 means nix found the
    # derivation's output already in the store and reran nothing (no VM booted). It's still a
    # valid pass for the CURRENT inputs (nix is content-addressed, and the pin gate above proved
    # the lock matches the checkouts) — but flag it so a sub-second "pass" is transparent, not
    # mistaken for a fresh VM run.
    from_cache = bool(_self_contained(entry)) and code == 0 and out_lines == 0
    # Substituted: the output was FETCHED from a binary cache ("copying path …") — built on another
    # machine, not run here. Still a valid deterministic pass, but not a local execution.
    substituted = bool(_self_contained(entry)) and code == 0 and subst and not from_cache
    # Forced: the run was pushed past a gate with --allow-dirty — must never look like a clean pass.
    _forced = _forced_reasons()
    rec = {**base, "status": status, "duration_s": round(duration, 1), "exit_code": code,
           "error": err, "from_cache": from_cache, "substituted": substituted,
           "forced": bool(_forced), "forced_reasons": _forced,
           "log_path": os.path.relpath(log_path, ROOT),
           "artifacts": {"client_log": os.path.relpath(log_path, ROOT),
                         "server_log": server_log_path, "video": video,
                         "screenshots": screenshots}}
    append_record(rec)
    col = {"pass": GREEN, "slow": AMBER, "fail": RED}.get(status, GREY)
    print(f"{col}{status}{OFF}  {entry['id']}  {fmt_dur(duration)}" + (f"  {RED}{err}{OFF}" if err else ""))
    if from_cache:
        print(f"{GREY}  (cached: nix reused a prior build of this exact derivation — no VM ran this time){OFF}")
    if substituted:
        print(f"{GREY}  (substituted: output fetched from a binary cache — built elsewhere, not run here){OFF}")
    if _forced:
        print(f"{AMBER}  FORCED past: {', '.join(_forced)} (--allow-dirty) — recorded as a forced run, not a clean pass{OFF}")
    # After a box install, run the guided finish (reboot → online → public IP → DNS records → verify)
    # on the REAL terminal — and only AFTER the record is written, so the human's time inside it can
    # never inflate the install's recorded duration (which would mis-mark a clean install "slow").
    # Interactive terminals only; CI/pipes skip it. The vm setup has no DOMAIN/MAC → naturally excluded.
    if (entry.get("category") == "install" and status in ("pass", "slow")
            and sys.stdin.isatty() and sys.stdout.isatty()):
        _dom, _key, _mac = run_env.get("DOMAIN"), run_env.get("KEY"), run_env.get("MAC")
        _fin = os.path.join(os.path.dirname(os.path.abspath(__file__)), "tools", "finish_box_setup.sh")
        if _dom and _key and os.path.exists(_fin):
            while True:
                try:
                    _ans = input(f"\n{BOLD}Finish setup now — reboot the box, read its public IP, add + verify DNS? [Y/n] {OFF}").strip()
                except (EOFError, KeyboardInterrupt):
                    _ans = "n"
                _low = _ans.lower()
                if _low in ("n", "no"):
                    break   # skip the guided finish
                if _low not in ("", "y", "yes"):
                    # Don't silently cancel on a typo (e.g. the box IP typed at this yes/no gate) — re-ask.
                    if re.match(r"^\d{1,3}(\.\d{1,3}){3}$", _ans):
                        print(f"{AMBER}  That's an IP, but this is a yes/no question.{OFF} The guided finish asks for the"
                              f" box's LAN IP later — AFTER you reboot it onto its network (it may differ from what you typed).")
                        print(f"  Answer {BOLD}y{OFF} to start it, or {BOLD}n{OFF} to skip.")
                    else:
                        print(f"{AMBER}  Please answer {BOLD}y{OFF}{AMBER} (start the guided finish) or {BOLD}n{OFF}{AMBER} (skip it).{OFF}")
                    continue
                # yes → run the guided finish (it asks for the box IP, then the tunnel's key in step 8)
                _fargs = ["bash", _fin, "--domain", _dom, "--key", _key, "--setup", method_tag]
                if _mac:
                    _fargs += ["--mac", _mac]
                if run_env.get("WIFI_SSID"):
                    _fargs += ["--wifi", run_env["WIFI_SSID"]]
                if run_env.get("PUBLIC_METHOD"):   # embed the chosen tunnel (set up over SSH; no box login)
                    _fargs += ["--public-method", run_env["PUBLIC_METHOD"],
                               "--public-cf-named", run_env.get("PUBLIC_CF_NAMED", "0")]
                try:
                    subprocess.run(_fargs)   # inherits the real terminal; does its own prompts + DNS verify
                except KeyboardInterrupt:
                    print(f"{GREY}  (guided finish interrupted — the install result above stands){OFF}")
                break
    return rec


def trim_log(path, keep=600):
    try:
        lines = open(path, errors="replace").read().splitlines()
        if len(lines) > keep:
            head = lines[:6]
            tail = lines[-keep:]
            open(path, "w").write("\n".join(head + [f"... [{len(lines)-keep-6} lines trimmed] ..."] + tail) + "\n")
    except Exception:
        pass


def fmt_dur(s):
    s = float(s)
    if s < 90:
        return f"{s:.1f}s"
    m, sec = divmod(int(s), 60)
    return f"{m}m{sec:02d}s"


