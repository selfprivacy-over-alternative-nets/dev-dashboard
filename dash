#!/usr/bin/env python3
"""dash — orchestrate, time, and record the SelfPrivacy dev/test commands.

One script runs every tracked command, measures how long it took, captures pass/fail + the
error, and appends a normalized JSON record to data/results.jsonl. The static dashboard
(index.html) reads that file. Multiple runs of the same thing stack up — nothing is overwritten.

Usage:
  ./dash list                       # show the catalog
  ./dash run <id> [<id> ...]        # run specific commands
  ./dash run --all                  # run everything runnable
  ./dash run --level L1|L2|L3|install
  ./dash run --category test|install
  ./dash run --tag transport=https  # filter by any tag (client/transport/backend/method)
  ./dash run <id> --config "my WIP" # label the current dirty working tree (a 'code config')
  ./dash wrap <id> -- <cmd...>      # time+record an arbitrary command under <id>
  ./dash report <id> --status pass --duration 720 [--error ..] [--config ..] [--env ci]
                                    # log a result that ran elsewhere (USB install, remote box)
  ./dash serve [port]               # serve the dashboard locally (default 8099)
  ./dash publish [-m msg]           # commit data/logs and push (updates GitHub Pages)
  ./dash demo                       # add labeled DEMO data so you can see the full view
  ./dash clear-demo                 # remove DEMO data

Env: results are tagged env=ci when CI or GITHUB_ACTIONS is set, else env=local.
"""
import argparse
import datetime
import hashlib
import json
import os
import re
import shutil
import signal
import socket
import subprocess
import sys
import time

# Redact live .onion addresses so they never reach the published dashboard.
_ONION_RE = re.compile(r"[a-z2-7]{16,56}\.onion")


def scrub(text):
    return _ONION_RE.sub("<onion>", text or "")

ROOT = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(ROOT, "data", "results.jsonl")
LOGS = os.path.join(ROOT, "logs")
MEDIA = os.path.join(ROOT, "media")
CATALOG = os.path.join(ROOT, "catalog.json")

GREEN, AMBER, RED, GREY, BOLD, OFF = "\033[32m", "\033[33m", "\033[31m", "\033[90m", "\033[1m", "\033[0m"
CYAN = "\033[36m"
GLYPH = {"pass": "🟢", "slow": "🟠", "fail": "🔴", "skip": "⚪", "running": "…"}


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def load_catalog():
    with open(CATALOG) as f:
        return json.load(f)


def all_entries(cat):
    return list(cat.get("tests", [])) + list(cat.get("installs", []))


def entry_by_id(cat, cid):
    for e in all_entries(cat):
        if e["id"] == cid:
            return e
    return None


def is_ci():
    return bool(os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"))


def git_state(repo_rel):
    """Return {repo, commit, subject, dirty, diff_hash} for the repo a command targets."""
    repo = os.path.normpath(os.path.join(ROOT, repo_rel)) if repo_rel else ROOT
    name = os.path.basename(repo)

    def g(args, default=""):
        try:
            return subprocess.check_output(["git", "-C", repo] + args, stderr=subprocess.DEVNULL).decode().strip()
        except Exception:
            return default

    commit = g(["rev-parse", "--short", "HEAD"], "unknown")
    subject = g(["log", "-1", "--format=%s"], "")
    porcelain = g(["status", "--porcelain"])
    diff = g(["diff", "HEAD"])
    dirty = bool(porcelain)
    diff_hash = hashlib.sha256((porcelain + diff).encode()).hexdigest()[:8] if dirty else ""
    return {"repo": name, "commit": commit, "subject": subject, "dirty": dirty, "diff_hash": diff_hash}


def gen_run_id():
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    return f"{stamp}-{os.urandom(2).hex()}"


def append_record(rec):
    os.makedirs(os.path.dirname(DATA), exist_ok=True)
    with open(DATA, "a") as f:
        f.write(json.dumps(rec) + "\n")


def drop_record(run_id):
    """Remove a previously-appended record by run_id (used to discard a transient retry attempt so
    the board isn't polluted with flaky-Tor failures we immediately retried past)."""
    if not run_id or not os.path.exists(DATA):
        return
    kept = [l for l in open(DATA) if l.strip() and json.loads(l).get("run_id") != run_id]
    open(DATA, "w").write("".join(kept))


def summarize_error(log_path):
    """Pull a one-line error summary out of a log (best effort, generic across tools)."""
    try:
        lines = open(log_path, errors="replace").read().splitlines()
    except Exception:
        return ""
    keys = ("error:", "Error", "Traceback", "assert", "AssertionError", "FAILED", "failed",
            "Exception", "Timeout", "cannot", "not found", "refused")
    hits = [l.strip() for l in lines if any(k in l for k in keys) and l.strip()]
    # Prefer a pytest/nix summary-ish line if present.
    for l in reversed(hits):
        if " failed" in l or "FAILED" in l or "AssertionError" in l or "error:" in l:
            return scrub(l[:240])
    return scrub(hits[-1][:240] if hits else "")


def classify(exit_code, duration, budget):
    if exit_code == 0:
        return "slow" if (budget and duration > budget) else "pass"
    return "fail"


def start_recording(run_id):
    """Record the app UI. Prefer a HEADLESS Xvfb: on Wayland/GNOME, x11grab of the real :0 captures
    black (rootless XWayland), so we render the app into a private Xvfb framebuffer and capture that —
    session-independent, small, always the app. Returns a dict incl. the DISPLAY the app must use."""
    if not shutil.which("ffmpeg"):
        print(f"{GREY}(ffmpeg missing — skipping video){OFF}")
        return None
    os.makedirs(MEDIA, exist_ok=True)
    out = os.path.join(MEDIA, run_id + ".mp4")
    size = "1280x800"
    try:
        if shutil.which("Xvfb"):
            disp = ":99"
            xvfb = subprocess.Popen(["Xvfb", disp, "-screen", "0", size + "x24", "-nolisten", "tcp"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(2)
            ff = subprocess.Popen(["ffmpeg", "-y", "-f", "x11grab", "-video_size", size, "-framerate", "12",
                                   "-i", disp, "-pix_fmt", "yuv420p", out],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.PIPE)
            print(f"{GREY}(recording the app headlessly via Xvfb {disp} → {os.path.relpath(out, ROOT)}){OFF}")
            return {"procs": [ff, xvfb], "out": out,
                    "env": {"DISPLAY": disp, "GDK_BACKEND": "x11", "LIBGL_ALWAYS_SOFTWARE": "1"}}
        x = os.environ.get("DISPLAY")
        if not x:
            print(f"{GREY}(no Xvfb and no X display — skipping video){OFF}")
            return None
        ff = subprocess.Popen(["ffmpeg", "-y", "-f", "x11grab", "-framerate", "12", "-i", x, "-pix_fmt", "yuv420p", out],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.PIPE)
        print(f"{AMBER}(recording ambient X — likely blank on Wayland; install {CYAN}xvfb{OFF}{AMBER} "
              f"[or run --setup] for a real recording){OFF}")
        return {"procs": [ff], "out": out, "env": {"GDK_BACKEND": "x11"}}
    except Exception as ex:
        print(f"{GREY}(recorder failed: {ex}){OFF}")
        return None


def trim_black(path, pad=0.3):
    """Drop the leading/trailing all-black stretch from a recording. `flutter test -d linux` spends
    the first ~20s BUILDING the app (no window on the display yet → black), then the UI shows for the
    last few seconds; without this the mp4 is 'mostly black'. Uses ffmpeg blackdetect to find the
    content window and re-encodes just that span. Best-effort: leaves the file untouched on any doubt."""
    try:
        r = subprocess.run(["ffmpeg", "-i", path, "-vf",
                            "blackdetect=d=0.2:pic_th=0.98:pix_th=0.10", "-f", "null", "-"],
                           capture_output=True, text=True, timeout=120)
        dur = None
        d = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                            "-of", "default=nw=1:nk=1", path], capture_output=True, text=True, timeout=30)
        try:
            dur = float(d.stdout.strip())
        except ValueError:
            return   # can't reason about the tail without a duration
        spans = re.findall(r"black_start:([\d.]+) black_end:([\d.]+)", r.stderr)
        start, end = 0.0, dur
        for bs, be in spans:
            bs, be = float(bs), float(be)
            if bs <= 0.2 and be > start:              # leading black (the build)
                start = be
            if be >= dur - 0.2 and bs < end:          # trailing black (teardown)
                end = bs
        start = max(0.0, start - pad)
        end = min(dur, end + pad)
        if end - start < 1.0 or (start <= 0.2 and end >= dur - 0.2):
            return   # nothing worth trimming, or it'd leave < 1s — keep the original
        tmp = path + ".trim.mp4"
        t = subprocess.run(["ffmpeg", "-y", "-i", path, "-ss", f"{start:.2f}", "-to", f"{end:.2f}",
                            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-an", tmp],
                           capture_output=True, text=True, timeout=180)
        if t.returncode == 0 and os.path.exists(tmp) and os.path.getsize(tmp) > 1000:
            os.replace(tmp, path)
            print(f"{GREY}(trimmed recording to the {end - start:.1f}s where the UI is visible){OFF}")
        elif os.path.exists(tmp):
            os.remove(tmp)
    except Exception as ex:
        print(f"{GREY}(video trim skipped: {ex}){OFF}")


def stop_recording(rec):
    if not rec:
        return ""
    for p in rec["procs"]:                     # ffmpeg first (SIGINT finalizes the mp4), then Xvfb
        try:
            p.send_signal(signal.SIGINT)
            p.wait(timeout=12)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
    out = rec["out"]
    if os.path.exists(out) and os.path.getsize(out) > 1000:
        trim_black(out)
        return os.path.relpath(out, ROOT)
    return ""


def pull_server_log(cmd, run_id):
    """Best-effort fetch of backend logs (e.g. an ssh journalctl). Onions scrubbed."""
    out = os.path.join(LOGS, run_id + ".server.log")
    try:
        with open(out, "w") as f:
            subprocess.run(cmd, shell=True, stdout=f, stderr=subprocess.STDOUT, timeout=90)
        open(out, "w").write(scrub(open(out, errors="replace").read()))
        return os.path.relpath(out, ROOT)
    except Exception:
        return ""


def collect_screenshots(shot_dir):
    """Gather per-step PNGs the test wrote into shot_dir, sorted by their NN- prefix."""
    if not shot_dir or not os.path.isdir(shot_dir):
        return []
    pngs = sorted(f for f in os.listdir(shot_dir) if f.endswith(".png")
                  and os.path.getsize(os.path.join(shot_dir, f)) > 1000)
    return [os.path.relpath(os.path.join(shot_dir, f), ROOT) for f in pngs]


def run_entry(entry, config_label=None, net=None, method=None, record=False, server_log=None, shots=False):
    cmd = entry.get("cmd", "")
    if entry.get("cmd_by_net"):
        if not net:
            print(f"{AMBER}skip{OFF}  {entry['id']} — needs --net ({'/'.join(entry['cmd_by_net'])})")
            return None
        cmd = entry["cmd_by_net"].get(net, "")
        if not cmd:
            print(f"{AMBER}skip{OFF}  {entry['id']} — no command for net={net}")
            return None

    nets = entry.get("networks") or []
    net_tag = net or (nets[0] if len(nets) == 1 else "-")
    method_tag = method or entry.get("method", "-")
    gs = git_state(entry.get("repo"))
    run_id = gen_run_id()
    base = {
        "run_id": run_id, "ts": now_iso(), "env": "ci" if is_ci() else "local",
        "host": socket.gethostname(), "category": entry.get("category", "test"),
        "id": entry["id"], "name": entry.get("name", entry["id"]), "level": entry.get("level", ""),
        "client": entry.get("client", "-"), "transport": net_tag,
        "backend": entry.get("backend", "-"), "method": method_tag,
        "records_video": bool(entry.get("records_video")),
        "config_label": config_label or ("dirty" if gs["dirty"] else ""),
        **{k: gs[k] for k in ("repo", "commit", "subject", "dirty", "diff_hash")},
    }

    if cmd == "@todo":
        print(f"{GREY}todo{OFF}  {entry['id']}  — automated test not written yet (no record appended)")
        return None
    if cmd == "@manual":
        print(f"{AMBER}manual{OFF}  {entry['id']}  — run it, then log with:")
        print(f"  ./dash report {entry['id']} --status pass --duration <seconds> [--config ..]")
        return None

    repo_dir = os.path.normpath(os.path.join(ROOT, entry["repo"])) if entry.get("repo") else ROOT
    log_path = os.path.join(LOGS, run_id + ".log")
    os.makedirs(LOGS, exist_ok=True)
    tags = f"{GREY}[net={net_tag} on={method_tag}]{OFF}"
    print(f"{BOLD}▶ {entry['id']}{OFF} {tags}  {GREY}{cmd}{OFF}")
    rec_handle = start_recording(run_id) if record else None
    run_env = {**os.environ}
    if rec_handle and rec_handle.get("env"):
        run_env.update(rec_handle["env"])       # run the app on the recorder's display (e.g. Xvfb :99)
    shot_dir = ""
    if shots:                                    # the test grabs its own $DISPLAY into SHOT_DIR per step
        shot_dir = os.path.join(MEDIA, run_id + ".shots")
        os.makedirs(shot_dir, exist_ok=True)
        run_env["SHOT_DIR"] = shot_dir
        run_env["SHOT_SIZE"] = "1280x800"
    start = datetime.datetime.now()
    with open(log_path, "w") as log:
        log.write(f"# {entry['id']}  net={net_tag} on={method_tag}\n# {cmd}\n# cwd {repo_dir}\n# started {now_iso()}\n\n")
        log.flush()
        try:
            proc = subprocess.Popen(cmd, shell=True, cwd=repo_dir, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, text=True, bufsize=1, env=run_env)
            for line in proc.stdout:
                sys.stdout.write(line)
                log.write(line)
            proc.wait()
            code = proc.returncode
        except KeyboardInterrupt:
            proc.terminate()
            code = 130
        except Exception as ex:
            log.write(f"\n[dash] launch error: {ex}\n")
            code = 127
    duration = (datetime.datetime.now() - start).total_seconds()
    video = stop_recording(rec_handle)
    trim_log(log_path)
    slog_cmd = server_log or entry.get("server_log_cmd")
    server_log_path = pull_server_log(slog_cmd, run_id) if slog_cmd else ""
    status = classify(code, duration, entry.get("budget_s"))
    err = "" if status == "pass" else summarize_error(log_path)
    screenshots = collect_screenshots(shot_dir)
    if shots:
        print(f"{GREY}captured {len(screenshots)} step screenshot(s){OFF}")
    rec = {**base, "status": status, "duration_s": round(duration, 1), "exit_code": code,
           "error": err, "log_path": os.path.relpath(log_path, ROOT),
           "artifacts": {"client_log": os.path.relpath(log_path, ROOT),
                         "server_log": server_log_path, "video": video,
                         "screenshots": screenshots}}
    append_record(rec)
    col = {"pass": GREEN, "slow": AMBER, "fail": RED}.get(status, GREY)
    print(f"{col}{status}{OFF}  {entry['id']}  {fmt_dur(duration)}" + (f"  {RED}{err}{OFF}" if err else ""))
    return rec


def trim_log(path, keep=600):
    try:
        lines = open(path, errors="replace").read().splitlines()
        if len(lines) > keep:
            head = lines[:6]
            tail = lines[-keep:]
            open(path, "w").write("\n".join(head + [f"... [{len(lines)-keep-6} lines trimmed] ..."] + tail) + "\n")
    except Exception:
        pass


def fmt_dur(s):
    s = float(s)
    if s < 90:
        return f"{s:.1f}s"
    m, sec = divmod(int(s), 60)
    return f"{m}m{sec:02d}s"


# ── Commands ─────────────────────────────────────────────────────────────────
def cmd_list(args):
    cat = load_catalog()
    es = all_entries(cat)
    for e in es:
        nets = ",".join(e.get("networks") or []) or "-"
        c = e.get("cmd", "")
        kind = "@todo" if c == "@todo" else "@manual" if c == "@manual" else ""
        print(f"  {e['id']:<26} {e['level']:<8} {e.get('client','-'):<8} net={nets:<16} {GREY}{kind}{OFF}")
    print(f"\n{len(es)} commands. Run: ./dash run <id> [--net tor --on vm-local --record]  |  ./dash run --all")


def select(args):
    cat = load_catalog()
    es = all_entries(cat)
    if args.ids:
        picked = [entry_by_id(cat, i) for i in args.ids]
        missing = [i for i, p in zip(args.ids, picked) if p is None]
        if missing:
            sys.exit(f"unknown id(s): {', '.join(missing)}")
        return picked
    if args.all:
        return es
    out = es
    if args.level:
        out = [e for e in out if e["level"] == args.level]
    if args.category:
        out = [e for e in out if e.get("category") == args.category]
    if args.tag:
        k, _, v = args.tag.partition("=")
        out = [e for e in out if str(e.get(k, "")) == v]
    if out is es:
        sys.exit("nothing selected. use <id>, --all, --level, --category, or --tag")
    return out


def cmd_run(args):
    entries = select(args)
    print(f"{BOLD}Running {len(entries)} command(s){OFF}\n")
    results = [run_entry(e, args.config, net=args.net, method=args.on,
                         record=args.record, server_log=args.server_log) for e in entries]
    results = [r for r in results if r]
    ok = sum(1 for r in results if r["status"] == "pass")
    print(f"\n{BOLD}Done.{OFF} {ok}/{len(results)} pass. Data → data/results.jsonl")
    print("View:  ./dash serve   Publish:  ./dash publish")


def cmd_wrap(args):
    cat = load_catalog()
    e = entry_by_id(cat, args.id) or {"id": args.id, "name": args.id, "category": "test",
                                       "level": "adhoc", "repo": None, "budget_s": None}
    e = dict(e)
    e["cmd"] = " ".join(args.cmd)
    run_entry(e, args.config, net=args.net, method=args.on, record=args.record, server_log=args.server_log)


def cmd_report(args):
    cat = load_catalog()
    e = entry_by_id(cat, args.id)
    if not e:
        sys.exit(f"unknown id: {args.id}")
    gs = git_state(e.get("repo"))
    nets = e.get("networks") or []
    rec = {
        "run_id": gen_run_id(), "ts": now_iso(), "env": args.env or ("ci" if is_ci() else "local"),
        "host": args.host or socket.gethostname(), "category": e.get("category", "test"),
        "id": e["id"], "name": e.get("name", e["id"]), "level": e.get("level", ""),
        "client": e.get("client", "-"), "transport": args.net or (nets[0] if len(nets) == 1 else "-"),
        "backend": e.get("backend", "-"), "method": args.on or e.get("method", "-"),
        "records_video": bool(e.get("records_video")),
        "config_label": args.config or "", "status": args.status,
        "duration_s": round(float(args.duration), 1), "exit_code": 0 if args.status == "pass" else 1,
        "error": scrub(args.error or ""), "log_path": "",
        "artifacts": {"client_log": "", "server_log": "", "video": ""},
        **{k: gs[k] for k in ("repo", "commit", "subject", "dirty", "diff_hash")},
    }
    append_record(rec)
    print(f"recorded {args.status} for {args.id} ({fmt_dur(args.duration)})")


def cmd_serve(args):
    import http.server
    os.chdir(ROOT)
    port = args.port
    handler = http.server.SimpleHTTPRequestHandler
    print(f"Dashboard: http://localhost:{port}/   (Ctrl+C to stop)")
    http.server.HTTPServer(("0.0.0.0", port), handler).serve_forever()


def cmd_publish(args):
    msg = args.message or f"data: results @ {now_iso()}"
    subprocess.run(["git", "-C", ROOT, "add", "data", "logs", "catalog.json"], check=False)
    r = subprocess.run(["git", "-C", ROOT, "commit", "-m", msg], capture_output=True, text=True)
    print(r.stdout or r.stderr)
    push = subprocess.run(["git", "-C", ROOT, "push"], capture_output=True, text=True)
    print(push.stdout or push.stderr)


def cmd_demo(args):
    from tools.gen_demo import generate
    generate(append_record, now_iso)
    print("Added DEMO data. Toggle it off in the dashboard, or ./dash clear-demo")


def cmd_clear_demo(args):
    if not os.path.exists(DATA):
        return
    kept = [l for l in open(DATA) if l.strip() and not json.loads(l).get("demo")]
    open(DATA, "w").write("".join(kept))
    print(f"cleared demo data; {len(kept)} real records remain")


# ── `here`: run everything this (Ubuntu) host can, end-to-end ─────────────────
VM_NAME = "SelfPrivacy-Tor-Test"
DEV_TOKEN = "test-token-for-tor-development"
BACKEND_DIR = "../Manager-Ubuntu-SelfPrivacy-Over-Tor/backend"
FLUTTER_APP_DIR = "../Manager-Ubuntu-SelfPrivacy-Over-Tor/flutter-app/selfprivacy.org.app"


def _port_open(host, port, timeout=2):
    try:
        with socket.create_connection((host, port), timeout=timeout):
            return True
    except Exception:
        return False


def _sh(cmd, timeout=None):
    try:
        return subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
    except Exception as ex:
        r = subprocess.CompletedProcess(cmd, 1, "", str(ex))
        return r


def _vm_running():
    return VM_NAME in (_sh("VBoxManage list runningvms").stdout or "")


def _vm_exists():
    return _sh(f'VBoxManage showvminfo "{VM_NAME}"').returncode == 0


def _vm_uuids():
    """UUIDs of every registered machine named VM_NAME (VBox allows duplicate names)."""
    out = _sh("VBoxManage list vms", timeout=30).stdout or ""
    uuids = []
    for line in out.splitlines():
        if f'"{VM_NAME}"' in line and "{" in line:
            uuids.append(line[line.rfind("{") + 1:line.rfind("}")])
    return uuids


def _destroy_vm():
    """Bulletproof teardown so a fresh install can't hit 'settings file exists' or 'already locked'
    (VBox 7.x). Handles a wedged VM whose `poweroff` hangs, a stuck headless holding the session
    lock, and multiple/inaccessible machines that share the name."""
    # Bounded graceful poweroff — on a wedged VM this can hang, so cap it.
    _sh(f'VBoxManage controlvm "{VM_NAME}" poweroff', timeout=20)
    # Force-kill any lingering headless / hung controlvm still holding the session.
    _sh(f"pkill -9 -f 'VBoxHeadless.*{VM_NAME}'")
    _sh(f"pkill -9 -f 'controlvm {VM_NAME}'")
    time.sleep(3)
    # Unregister EVERY machine with this name, by UUID (covers duplicates + inaccessible).
    for uuid in _vm_uuids():
        _sh(f"VBoxManage unregistervm {uuid} --delete", timeout=120)   # may warn on inaccessible; fine
    # Remove any leftover on-disk folder so createvm --register gets a clean slate.
    vmdir = os.path.join(os.path.expanduser("~"), "VirtualBox VMs", VM_NAME)
    if os.path.isdir(vmdir):
        shutil.rmtree(vmdir, ignore_errors=True)
    time.sleep(2)


def _get_onion(retries=12):
    if not shutil.which("sshpass"):
        return ""
    for _ in range(retries):
        r = _sh("sshpass -p '' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=5 "
                "-p 2222 root@localhost cat /var/lib/tor/hidden_service/hostname")
        h = (r.stdout or "").strip()
        if h.endswith(".onion"):
            return h
        time.sleep(6)
    return ""


def ensure_backend(install_ok):
    """Return (onion, token, note). Bring up the VirtualBox VM if needed (non-destructive)."""
    if not shutil.which("VBoxManage"):
        return "", "", "VirtualBox not installed"
    if _vm_running():
        o = _get_onion()
        return o, DEV_TOKEN, ("" if o else "VM running but .onion not published yet")
    if _vm_exists():
        print(f"{GREY}starting existing VM {VM_NAME} with stable 2D graphics (waiting ~2.5 min for boot + Tor HS)…{OFF}")
        _power_off_hard()
        _apply_stable_graphics()                  # avoid the VMSVGA 3D guru-meditation crash
        _sh(f'VBoxManage startvm "{VM_NAME}" --type headless', timeout=120)
        o = _get_onion(retries=25)
        return o, DEV_TOKEN, ("" if o else "VM started but .onion not ready (boot slow, or Tor HS not up)")
    if not install_ok:
        return "", "", "no backend VM (omit --no-install to create one)"
    inst = entry_by_id(load_catalog(), "install.vm-local")
    if inst:
        run_entry(inst)                       # download image, create VM, start Tor
    o = _get_onion(retries=25)
    return o, DEV_TOKEN, ("" if o else "installed VM but .onion not ready")


def preflight(do_sudo):
    """Check prerequisites up front; with do_sudo, start host Tor now (interactive sudo)."""
    print(f"{BOLD}preflight{OFF}")

    def chk(tool):
        p = bool(shutil.which(tool))
        print(f"  {(GREEN + '✓' + OFF) if p else (RED + '✗' + OFF)} {tool}")
        return p

    vbox, flutter, ssh = chk("VBoxManage"), chk("flutter"), chk("sshpass")
    disp = bool(os.environ.get("DISPLAY") or os.environ.get("WAYLAND_DISPLAY"))
    print(f"  {(GREEN + '✓' + OFF) if disp else (RED + '✗' + OFF)} display")
    if not _port_open("127.0.0.1", 9050):
        print(f"  {GREY}host Tor SOCKS :9050 down — starting a user-level tor (no sudo)…{OFF}")
    tor = _ensure_tor()
    print(f"  {(GREEN + '✓' + OFF) if tor else (RED + '✗' + OFF)} host Tor SOCKS 127.0.0.1:9050")
    if not tor:
        print(f"    {AMBER}→ tor not found/failed. Install it: {CYAN}sudo apt install tor{OFF}{AMBER}, "
              f"or start manually: {CYAN}tor &{OFF}")
    if not flutter:
        print(f"    {AMBER}→ app build deps: {CYAN}(cd ../Manager-Ubuntu-SelfPrivacy-Over-Tor && ./scripts/requirements.sh --app-linux){OFF}")
    return {"vbox": vbox, "flutter": flutter, "ssh": ssh, "display": disp, "tor": tor}


def _apply_stable_graphics():
    """Stabilize the VBox guest on this host (VM must be off). Two known crashers on VBox 7.2.6:
    - VMSVGA 3D emulation guru-meditates (crash dump all VMSVGA 3D) -> use a plain 2D controller;
    - the 2nd vCPU hits VERR_VMX_INVALID_VMXON_PTR under VT-x contention -> run a single vCPU.
    Headless server, so neither costs anything meaningful."""
    _sh(f'VBoxManage modifyvm "{VM_NAME}" --graphicscontroller vboxvga', timeout=30)
    _sh(f'VBoxManage modifyvm "{VM_NAME}" --accelerate3d off', timeout=30)
    _sh(f'VBoxManage modifyvm "{VM_NAME}" --cpus 1', timeout=30)


def _power_off_hard():
    _sh(f'VBoxManage controlvm "{VM_NAME}" poweroff', timeout=20)
    _sh(f"pkill -9 -f 'VBoxHeadless.*{VM_NAME}'")
    time.sleep(2)


def _ensure_tor():
    """Make sure SOCKS 9050 is up. Starts a USER-level tor (no sudo) if needed — a user tor binds
    9050 fine, avoiding the flaky `sudo systemctl start tor` path."""
    if _port_open("127.0.0.1", 9050):
        return True
    if not shutil.which("tor"):
        return False
    datadir = os.path.expanduser("~/.cache/dash-tor")
    os.makedirs(datadir, exist_ok=True)
    subprocess.Popen(
        ["tor", "--SocksPort", "9050", "--DataDirectory", datadir,
         "--Log", "notice file " + os.path.join(datadir, "tor.log")],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
        start_new_session=True)                    # detached: survives this dash run for the app to use
    for _ in range(10):
        time.sleep(2)
        if _port_open("127.0.0.1", 9050):
            return True
    return False


def _onion_reachable(onion, tries=45):
    """True once the .onion answers over host Tor (SOCKS 9050). A freshly-(re)started v3 hidden
    service takes 2–5 min to establish intro points, upload its descriptor and become fetchable —
    so retry generously (~6 min)."""
    for i in range(tries):
        code = (_sh(f"curl -s -o /dev/null -w '%{{http_code}}' --max-time 25 "
                    f"--socks5-hostname 127.0.0.1:9050 -k https://{onion}/api/version", timeout=35).stdout or "").strip()
        if code in ("200", "301", "302", "401", "403"):
            return True
        if i and i % 6 == 0:
            print(f"{GREY}  …still waiting for the onion descriptor to propagate ({i*8//60}m){OFF}")
        time.sleep(8)
    return False


def _kick_vm_tor():
    """Restart the VM's tor to force a fresh HS-descriptor upload. After a cold boot the descriptor
    can take minutes to reach the HSDirs; a restart reliably kicks it (verified: unreachable -> 200)."""
    _sh("sshpass -p '' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 "
        "-p 2222 root@localhost 'systemctl restart tor'", timeout=25)
    time.sleep(3)


_VM_SSH = ("sshpass -p '' ssh -o StrictHostKeyChecking=no -o ConnectTimeout=6 -p 2222 root@localhost")


def _ensure_api_nix_path():
    """Make sure `nix` is on the selfprivacy-api service PATH inside the backend VM.

    The backend's systemd unit (Manager repo's selfprivacy-tor-core.nix) omits nix from the API
    service PATH, so `services.allServices` — which shells out to `nix` to enumerate services —
    fails with "[Errno 2] No such file or directory: 'nix'" and the app's Services list NEVER
    loads (it sits on skeleton placeholders forever). The proper fix is one line in that Manager
    module (add `config.nix.package.out` to `path`), but we must not modify the Manager repo, so we
    inject the fix TRANSIENTLY at runtime via a /run systemd drop-in (tmpfs; /etc is read-only on
    NixOS; the drop-in evaporates on VM reboot). Idempotent + best-effort."""
    if not shutil.which("sshpass"):
        return
    have = _sh(f"{_VM_SSH} 'systemctl show selfprivacy-api -p Environment --value'", timeout=20).stdout or ""
    if "/run/current-system/sw/bin" in have or "nix-2" in have:
        return                                       # already patched (or a rebuilt VM that has it)
    print(f"{GREY}patching backend: adding nix to the API service PATH (so Services can load over Tor)…{OFF}")
    remote = (
        "EXIST=$(systemctl show selfprivacy-api -p Environment --value | tr ' ' '\\n' | "
        "grep '^PATH=' | cut -d= -f2-); "
        "mkdir -p /run/systemd/system/selfprivacy-api.service.d && "
        "printf '[Service]\\nEnvironment=PATH=/run/current-system/sw/bin:%s\\n' \"$EXIST\" "
        "> /run/systemd/system/selfprivacy-api.service.d/nixpath.conf && "
        "systemctl daemon-reload && systemctl restart selfprivacy-api"
    )
    r = _sh(f'{_VM_SSH} "{remote}"', timeout=40)
    if r.returncode == 0:
        time.sleep(4)                                # let the API come back up before the app polls
        print(f"{GREY}  API restarted with nix on PATH.{OFF}")
    else:
        print(f"{AMBER}  couldn't patch API PATH (Services may stay empty): {r.stderr.strip()[:120]}{OFF}")


def bring_up_backend(cat):
    """Full backend bring-up via the Manager's build-and-run.sh (records the install time).

    A stale/broken VM is destroyed first (VBox 7.x 'settings file already exists'); after install we
    force a stable 2D graphics controller and reboot, because VMSVGA 3D crashes this guest."""
    if _vm_running():                                # reuse a healthy running VM (fast re-runs)
        o = _get_onion(retries=8)
        if o:
            print(f"{GREY}reusing the running VM (already has an .onion).{OFF}")
            return o
    if _vm_exists():                                 # start a stopped-but-good VM before reinstalling
        print(f"{GREY}starting the existing (stopped) VM with stable graphics…{OFF}")
        _power_off_hard()
        _apply_stable_graphics()
        _sh(f'VBoxManage startvm "{VM_NAME}" --type headless', timeout=120)
        o = _get_onion(retries=25)
        if o:
            print(f"{GREY}reusing the existing VM (.onion published).{OFF}")
            return o
        print(f"{GREY}existing VM didn't yield an .onion — reinstalling clean…{OFF}")
        _destroy_vm()
    inst = entry_by_id(cat, "install.vm-local")     # SP_BUILD_MODE=download SP_VM_ACTION=reinstall ./build-and-run.sh
    if inst:
        run_entry(inst)                             # build-and-run.sh hits a clean slate
    print(f"{GREY}applying stable 2D graphics (VBox 7.x VMSVGA 3D crashes the guest) and rebooting…{OFF}")
    _power_off_hard()
    _apply_stable_graphics()
    _sh(f'VBoxManage startvm "{VM_NAME}" --type headless', timeout=120)
    return _get_onion(retries=30)


def ensure_integration_dep(app_dir):
    """Add integration_test to the app's dev_dependencies (in-place; caller restores afterwards)."""
    p = os.path.join(app_dir, "pubspec.yaml")
    src = open(p).read()
    if "integration_test:" in src:
        return
    anchor = "  flutter_test:\n    sdk: flutter\n"
    add = "  integration_test:\n    sdk: flutter\n"
    src = src.replace(anchor, anchor + add, 1) if anchor in src else \
        src.replace("dev_dependencies:\n", "dev_dependencies:\n" + add, 1)
    open(p, "w").write(src)


def run_l3_flutter(onion, token, pf):
    """Run the AUTOMATED integration test, recorded. The test lives in the dashboard repo and is
    injected into the app package for the run, then the Manager repo is restored byte-for-byte."""
    app = os.path.normpath(os.path.join(ROOT, FLUTTER_APP_DIR))
    test_src = os.path.join(ROOT, "flutter", "providers_flow_test.dart")
    if not os.path.exists(test_src):
        print(f"{RED}missing {test_src}{OFF}")
        return
    if not pf.get("tor"):
        print(f"{AMBER}note{OFF}: host Tor (127.0.0.1:9050) is down — the app may not reach the .onion; "
              f"the run is still recorded. {CYAN}sudo systemctl start tor{OFF}")
    _ensure_api_nix_path()      # so the app's Services list can actually load over Tor (see helper)
    # Gate on the onion answering over Tor RIGHT BEFORE launch. The app's init() calls getApiVersion()
    # immediately; on a cold circuit the first SOCKS request can throw `hostUnreachable`, and an
    # integration test fails on any unhandled async exception. Confirming 200 first (and kicking the
    # VM's tor if not) makes the launch land on a warm circuit — mirrors the gate in cmd_here.
    if pf.get("tor"):
        if not _onion_reachable(onion, tries=6):
            print(f"{GREY}onion not answering yet — restarting the VM's tor to force a descriptor upload…{OFF}")
            _kick_vm_tor()
            _onion_reachable(onion, tries=30)
    itdir = os.path.join(app, "integration_test")
    injected = os.path.join(itdir, "providers_flow_test.dart")
    backup = {f: open(os.path.join(app, f)).read() for f in ("pubspec.yaml", "pubspec.lock")
              if os.path.exists(os.path.join(app, f))}
    created_dir = not os.path.isdir(itdir)
    try:
        print(f"{GREY}injecting automated test into the app (temporary — Manager repo restored after)…{OFF}")
        ensure_integration_dep(app)
        os.makedirs(itdir, exist_ok=True)
        shutil.copy(test_src, injected)
        print(f"{GREY}flutter pub get (resolving integration_test)…{OFF}")
        _sh(f"cd '{app}' && flutter config --enable-linux-desktop >/dev/null 2>&1; flutter pub get", timeout=600)
        entry = {
            "id": "L3.providers.desktop", "name": "providers tab", "level": "L3",
            "client": "desktop", "networks": ["tor"], "repo": FLUTTER_APP_DIR,
            "budget_s": 600, "records_video": True,
            "cmd": "flutter test integration_test/providers_flow_test.dart -d linux "
                   f"--dart-define=ONION_DOMAIN={onion} --dart-define=API_TOKEN={token}",
            "server_log_cmd": "sshpass -p '' ssh -o StrictHostKeyChecking=no -p 2222 root@localhost "
                              "'journalctl -u selfprivacy-api -u nginx -n 200 --no-pager'",
        }
        # Retry on TRANSIENT Tor failures only. The app's reload() timer throws uncaught on a
        # cold-circuit `hostUnreachable`, and integration_test fails on ANY uncaught async error
        # (the real app just logs it and retries on its next 10s tick). A fresh launch on a warm
        # circuit connects — so we retry, kicking the VM's tor between attempts. A failure with NO
        # connection markers (e.g. the Services-data assertion on a clean connection) is a REAL bug
        # and is NOT retried — it stays red honestly.
        transient_markers = ("hostUnreachable", "TimeoutException", "SocketException", "Connection refused")
        for attempt in range(1, 4):
            rec = run_entry(entry, net="tor", method="vm-local", record=True, shots=True)
            if not rec or rec.get("status") == "pass":
                break
            log_txt = ""
            cl = (rec.get("artifacts") or {}).get("client_log")
            if cl and os.path.exists(os.path.join(ROOT, cl)):
                log_txt = open(os.path.join(ROOT, cl), errors="replace").read()
            is_transient = any(m in log_txt for m in transient_markers)
            if is_transient and attempt < 3:
                print(f"{AMBER}transient Tor connection failure{OFF} — kicking the VM's tor and retrying "
                      f"(attempt {attempt + 1}/3)…")
                drop_record(rec["run_id"])           # don't leave a flaky-fail on the board
                _kick_vm_tor()
                _onion_reachable(onion, tries=20)    # re-warm before the next launch
            else:
                break                                # a real failure (or out of attempts) — keep it
    finally:
        print(f"{GREY}restoring Manager repo (removing injected test, reverting pubspec)…{OFF}")
        try:
            if os.path.exists(injected):
                os.remove(injected)
            if created_dir and os.path.isdir(itdir) and not os.listdir(itdir):
                os.rmdir(itdir)
        except Exception:
            pass
        for f, content in backup.items():
            open(os.path.join(app, f), "w").write(content)


def cmd_here(args):
    cat = load_catalog()
    mode = "long (full backend bring-up)" if args.long else "quick (use a running backend if present)"
    print(f"{BOLD}dash here — {mode}{OFF}\n")

    # Everything needing sudo is handled here, up front.
    pf = preflight(do_sudo=args.long)

    # One-time app build deps (Flutter + Linux toolchain) via the Manager's own script.
    if args.setup:
        mgr = os.path.normpath(os.path.join(ROOT, "../Manager-Ubuntu-SelfPrivacy-Over-Tor"))
        print(f"{BOLD}setup{OFF}: {mgr}/scripts/requirements.sh --app-linux (apt/sudo, one-time)")
        subprocess.run("./scripts/requirements.sh --app-linux", shell=True, cwd=mgr)
        # Xvfb: for reliable headless UI recording on Wayland (x11grab of :0 captures black there).
        subprocess.run("command -v Xvfb >/dev/null || sudo apt-get install -y xvfb", shell=True)
        pf = preflight(do_sudo=args.long)            # re-check after install

    # Fail fast: --long's whole point is the recorded app test (L3). If a hard prerequisite for it is
    # missing, stop NOW — before the multi-minute VM build + tests — instead of discovering it at the end.
    if args.long:
        need = {"vbox": "VirtualBox", "flutter": "Flutter (run with --setup)",
                "display": "a graphical display", "tor": "host Tor on 127.0.0.1:9050"}
        missing = [need[k] for k in need if not pf[k]]
        if missing:
            print(f"\n{RED}Aborting before doing any heavy work.{OFF} --long runs the app test (L3), which needs:")
            for m in missing:
                print(f"  {RED}✗{OFF} {m}")
            print(f"Fix the above and re-run. (For just the fast checks, use {CYAN}./dash here --fast{OFF} "
                  f"or {CYAN}./dash run L1.onion-routing{OFF}.)")
            sys.exit(1)

    # L1 + L2 FIRST — they use nix/QEMU (KVM). The VirtualBox backend must NOT be running while these
    # run: VirtualBox and KVM both grab Intel VT-x, and the contention guru-meditates the VBox VM
    # (VERR_VMX_INVALID_VMXON_PTR). So the VBox backend is brought up only AFTER the KVM tests finish.
    if pf["vbox"] and _vm_running():
        print(f"{GREY}powering off the VBox VM during the KVM tests (VT-x can't be shared)…{OFF}")
        _power_off_hard()
    run_entry(entry_by_id(cat, "L1.onion-routing"))
    if args.fast:
        print(f"{GREY}skipping L2 (--fast){OFF}")
    else:
        for net in ("tor", "https"):
            run_entry(entry_by_id(cat, "L2.backend"), net=net)

    # Backend (VirtualBox) — AFTER the KVM tests, so nothing else is holding VT-x.
    onion = None
    if not pf["vbox"]:
        print(f"{AMBER}skip backend/L3{OFF} — VirtualBox not installed")
    elif args.long:
        onion = bring_up_backend(cat)
    else:
        onion, _, note = ensure_backend(install_ok=not args.no_install)
        if not onion:
            print(f"{AMBER}backend not ready{OFF} — {note}. Use {CYAN}./dash here --long{OFF} to build it + start Tor.")

    # L3 — the real app over Tor, driven by the automated integration test, recorded.
    # Gate on the .onion actually being reachable, so we never launch the app into a refused loop.
    if onion and pf["flutter"] and pf["display"]:
        print(f"{GREY}backend .onion: {onion} — checking it's reachable over Tor…{OFF}")
        if not pf["tor"]:
            print(f"{AMBER}skip L3{OFF} — host Tor (127.0.0.1:9050) isn't running, so the app can't reach the "
                  f"onion. Start it: {CYAN}sudo systemctl start tor{OFF}, then re-run.")
            reachable = False
        elif _onion_reachable(onion, tries=4):       # quick: already-warm onion answers fast
            reachable = True
        else:                                        # cold boot: kick the VM's tor, then wait generously
            print(f"{GREY}onion not up yet — restarting the VM's tor to force a descriptor upload…{OFF}")
            _kick_vm_tor()
            reachable = _onion_reachable(onion)
        if pf["tor"] and reachable:
            print(f"{GREEN}onion reachable — launching the automated app test.{OFF}")
            run_l3_flutter(onion, DEV_TOKEN, pf)
        elif pf["tor"]:
            print(f"{AMBER}skip L3{OFF} — the backend .onion never answered over Tor. The VM likely didn't "
                  f"stay up (check {CYAN}VBoxManage showvminfo {VM_NAME} | grep State{OFF}) or the Tor HS "
                  f"isn't published yet. Not launching the app (would just loop on 'connection refused').")
    else:
        why = "no backend .onion" if not onion else ("flutter missing" if not pf["flutter"] else "no display")
        print(f"{AMBER}skip L3{OFF} — {why}. (Run {CYAN}./dash here --long{OFF} once flutter deps are installed.)")

    if not args.no_publish:
        cmd_publish(argparse.Namespace(message=f"dash here @ {now_iso()}"))
    print(f"\n{BOLD}dash here done.{OFF} View: ./dash serve" + ("" if args.no_publish else "  ·  pushed to the live board"))


def cmd_vm_reset(args):
    print(f"{BOLD}vm-reset{OFF} — killing stale VBox sessions and removing all copies of {VM_NAME}…")
    _destroy_vm()
    left = _vm_uuids()
    print(f"{GREEN}clean.{OFF}" if not left else f"{AMBER}still present: {left}{OFF} (try again, or check VBox GUI)")


def main():
    p = argparse.ArgumentParser(prog="dash", description="orchestrate + record SelfPrivacy dev/test runs")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(fn=cmd_list)

    r = sub.add_parser("run")
    r.add_argument("ids", nargs="*")
    r.add_argument("--all", action="store_true")
    r.add_argument("--level")
    r.add_argument("--category")
    r.add_argument("--tag")
    r.add_argument("--config", help="label the current dirty working tree")
    r.add_argument("--net", help="network/transport: tor|chutney|https|...")
    r.add_argument("--on", help="install method the backend runs on: vm-local|native-ethernet|...")
    r.add_argument("--record", action="store_true", help="screen-record the client UI (local media)")
    r.add_argument("--server-log", help="shell cmd to fetch backend logs after the run (e.g. ssh ... journalctl)")
    r.set_defaults(fn=cmd_run)

    w = sub.add_parser("wrap")
    w.add_argument("id")
    w.add_argument("--config")
    w.add_argument("--net")
    w.add_argument("--on")
    w.add_argument("--record", action="store_true")
    w.add_argument("--server-log")
    w.add_argument("cmd", nargs=argparse.REMAINDER, help="-- then the command")
    w.set_defaults(fn=cmd_wrap)

    rp = sub.add_parser("report")
    rp.add_argument("id")
    rp.add_argument("--status", required=True, choices=["pass", "fail", "slow", "skip"])
    rp.add_argument("--duration", required=True, type=float)
    rp.add_argument("--error", default="")
    rp.add_argument("--config", default="")
    rp.add_argument("--net")
    rp.add_argument("--on")
    rp.add_argument("--env")
    rp.add_argument("--host")
    rp.set_defaults(fn=cmd_report)

    s = sub.add_parser("serve")
    s.add_argument("port", nargs="?", type=int, default=8099)
    s.set_defaults(fn=cmd_serve)

    pub = sub.add_parser("publish")
    pub.add_argument("-m", "--message")
    pub.set_defaults(fn=cmd_publish)

    h = sub.add_parser("here", help="run everything this host can (L1 + L2 + recorded L3), then publish")
    h.add_argument("--long", action="store_true",
                   help="full bring-up: sudo-start Tor + build the VM via build-and-run.sh, then run+record the app")
    h.add_argument("--setup", action="store_true",
                   help="one-time: run the Manager's requirements.sh --app-linux first (Flutter + Linux build deps)")
    h.add_argument("--fast", action="store_true", help="skip the long L2 nixosTests")
    h.add_argument("--no-install", action="store_true", help="(quick mode) don't start/create a VM")
    h.add_argument("--no-publish", action="store_true", help="don't commit+push results at the end")
    h.set_defaults(fn=cmd_here)

    sub.add_parser("vm-reset", help="kill stale VBox sessions + remove all copies of the SelfPrivacy VM").set_defaults(fn=cmd_vm_reset)
    sub.add_parser("demo").set_defaults(fn=cmd_demo)
    sub.add_parser("clear-demo").set_defaults(fn=cmd_clear_demo)

    # wrap uses REMAINDER; strip the leading '--' if present
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "wrap" and "--" in argv:
        argv.remove("--")
    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
