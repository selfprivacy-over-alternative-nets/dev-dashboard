HTTPS_TUNNEL_PORT = 8443
# nip.io resolves *.127.0.0.1.nip.io -> 127.0.0.1, so the app reaches the tunnel via a real hostname
# (needed for the app's `api.<domain>` clearnet URL + TLS SNI) WITHOUT touching /etc/hosts (no sudo).
HTTPS_TUNNEL_DOMAIN = f"127.0.0.1.nip.io:{HTTPS_TUNNEL_PORT}"

# Trusted local HTTPS name for the `https` transport (see handover2.md / setup-theory7-https.sh):
# Caddy on 127.0.0.1:443 serves a browser-trusted mkcert cert for THEORY7_DOMAIN and reverse-proxies
# to the same 8443 SSH tunnel -> VM nginx. The app connects straight to https://<domain>/graphql
# (HTTPS_APEX=1, no api. prefix) and VALIDATES the cert against the mkcert root (HTTPS_CA) — a REAL
# cert check over a real domain, replacing the old self-signed nip.io "trust anything" behaviour.
THEORY7_DOMAIN = os.environ.get("HTTPS_DEV_DOMAIN", "theory7.weersurf.nl")
MKCERT_CA = os.path.expanduser("~/.local/share/mkcert/rootCA.pem")


def _ensure_theory7():
    """Ensure the trusted-HTTPS chain for the `https` transport is up: the 8443 SSH tunnel (VM nginx)
    plus the Caddy user-service that serves https://THEORY7_DOMAIN with a mkcert cert. Returns
    (domain, ca_path_or_None). No sudo — /etc/hosts, the cert, the CA and setcap were provisioned once
    by setup-theory7-https.sh; here we only (re)start the tunnel + the user-service."""
    _ensure_https_tunnel()  # 8443 -> VM:443
    up = _sh("ss -tlnp 2>/dev/null | grep -q '127.0.0.1:443 '").returncode == 0
    if not up:
        print(f"{GREY}starting theory7 Caddy user-service (127.0.0.1:443)…{OFF}")
        _sh("systemctl --user start theory7-https.service", timeout=20)
        time.sleep(1)
    ca = MKCERT_CA if os.path.exists(MKCERT_CA) else None
    return THEORY7_DOMAIN, ca


def _ensure_https_tunnel():
    """SSH-forward host 127.0.0.1:8443 -> the VM's nginx :443 so the app can reach the SAME backend
    over CLEARNET HTTPS (no Tor). The Tor VM's nginx serves /graphql on its only 443 server (default
    server, any Host), so `https://api.<domain>/graphql` routes fine. Returns the address the app
    should use as HTTPS_DOMAIN. Idempotent + best-effort."""
    listening = _sh(f"ss -tlnp 2>/dev/null | grep -q '127.0.0.1:{HTTPS_TUNNEL_PORT}'").returncode == 0
    if not listening:
        print(f"{GREY}opening SSH tunnel host:{HTTPS_TUNNEL_PORT} -> VM:443 for clearnet HTTPS…{OFF}")
        _sh(f"sshpass -p '' ssh -f -N -o StrictHostKeyChecking=no -o ExitOnForwardFailure=yes "
            f"-L 127.0.0.1:{HTTPS_TUNNEL_PORT}:127.0.0.1:443 -p 2222 root@localhost", timeout=20)
        time.sleep(2)
    return HTTPS_TUNNEL_DOMAIN


CHUTNEY_DIR = os.path.normpath(os.path.join(ROOT, "..", "chutney"))
CHUTNEY_SOCKS = 9009           # the hs-v3 flavor's client SOCKS port
SPHS_DIR = "/tmp/sp-hs-tor"    # host-side tor: joins chutney, HS -> the https tunnel (VM nginx)
_TOR_BIN = "/usr/sbin/tor"


def _ensure_chutney():
    """Bring up an L3-over-CHUTNEY backing WITHOUT touching real Tor (9050) or the VM: a private
    chutney Tor network + a host-side tor Hidden Service that reverse-proxies to the VM's nginx via
    the same https SSH tunnel. So the app dials a chutney .onion (over the chutney client's SOCKS)
    that resolves to the real SelfPrivacy backend. Returns (chutney_onion, socks_port) or (None,None).
    Idempotent. Needs the chutney tool cloned at ../chutney (pip: tomli_w tomli paramiko rpyc)."""
    if not os.path.isdir(CHUTNEY_DIR):
        print(f"{AMBER}chutney not cloned at {CHUTNEY_DIR} — skipping chutney L3.{OFF}")
        return None, None
    up = lambda: _sh(f"ss -tlnp 2>/dev/null | grep -q '127.0.0.1:{CHUTNEY_SOCKS}'").returncode == 0
    if not up():
        print(f"{GREY}starting the private chutney Tor network (keep-alive)…{OFF}")
        _sh(f"cd '{CHUTNEY_DIR}' && CHUTNEY_TOR={_TOR_BIN} nohup ./tools/test-network.sh --flavor hs-v3 "
            f"--tor {_TOR_BIN} --stop-time -1 >/tmp/chutney_up.log 2>&1 &")
        for _ in range(60):
            if up():
                break
            time.sleep(3)
        if not up():
            print(f"{AMBER}chutney network didn't come up (see /tmp/chutney_up.log){OFF}")
            return None, None
    _ensure_https_tunnel()                          # the HS forwards 443 -> this tunnel -> VM nginx
    das = _sh(f"grep -hE '^DirAuthority ' '{CHUTNEY_DIR}'/net/nodes/009c/torrc").stdout or ""
    das = "\n".join(l for l in das.splitlines() if l.startswith("DirAuthority"))
    if not das:
        print(f"{AMBER}couldn't read chutney DirAuthority lines{OFF}")
        return None, None
    os.makedirs(os.path.join(SPHS_DIR, "hs"), exist_ok=True)
    os.chmod(os.path.join(SPHS_DIR, "hs"), 0o700)   # tor requires the HS dir be 0700
    open(os.path.join(SPHS_DIR, "torrc"), "w").write(
        f"TestingTorNetwork 1\nDataDirectory {SPHS_DIR}\nSocksPort 0\n"
        f"Log notice file {SPHS_DIR}/notice.log\nSandbox 0\n"
        f"HiddenServiceDir {SPHS_DIR}/hs\nHiddenServicePort 443 127.0.0.1:{HTTPS_TUNNEL_PORT}\n{das}\n")
    _sh(f"pkill -f 'tor -f {SPHS_DIR}/torrc'")       # restart with the CURRENT chutney authorities
    time.sleep(1)
    _sh(f"nohup {_TOR_BIN} -f {SPHS_DIR}/torrc >/tmp/sp-hs-start.log 2>&1 &")
    hostname = os.path.join(SPHS_DIR, "hs", "hostname")
    for _ in range(25):
        if os.path.exists(hostname):
            break
        time.sleep(2)
    onion = open(hostname).read().strip() if os.path.exists(hostname) else None
    if not onion:
        print(f"{AMBER}host-side chutney HS didn't publish (see {SPHS_DIR}/notice.log){OFF}")
        return None, None
    if not _onion_reachable(onion, tries=15, socks_port=CHUTNEY_SOCKS):
        print(f"{AMBER}chutney onion not answering yet; the run may need a retry.{OFF}")
    print(f"{GREY}chutney backend ready: {onion[:16]}… via SOCKS {CHUTNEY_SOCKS}{OFF}")
    return onion, CHUTNEY_SOCKS


def _stop_chutney():
    """Tear down the chutney network + host-side HS (real tor/VM untouched)."""
    _sh(f"pkill -f 'tor -f {SPHS_DIR}/torrc'")
    _sh(f"cd '{CHUTNEY_DIR}' && CHUTNEY_TOR={_TOR_BIN} ./chutney stop >/dev/null 2>&1")
    _sh("pkill -f 'chutney/net/nodes'")


def resolve_backend_target(setup, net, ip, key, token):
    """Resolve HOW to reach the L3 backend for `--on <setup>` over transport `net`. Returns a target
    dict or None (after a fail-fast error). kind=="vm" → the local VirtualBox VM (address/token
    resolved by the VM code path). kind=="box" → a deployed physical box reached over the LAN: requires
    --ip/--key/--token (a box's API token is per-box + secret, so it can't be defaulted — reproducibility
    reqs 1-6), and its onion / https domain are read LIVE from the box (req 89), never from stale local
    state. chutney is vm-local only; a box exposes tor (real onion) or https (public domain)."""
    kind = _setup_backend_kind(setup)
    if kind == "vm":
        return {"kind": "vm", "setup": setup or "vm-local", "token": token or DEV_TOKEN,
                "socks": CHUTNEY_SOCKS if net == "chutney" else 9050}
    missing = [name for name, val in (("--ip", ip), ("--key", key), ("--token", token)) if not val]
    if missing:
        print(f"{RED}missing args{OFF}  L3 on {setup} runs against a physical box; required: "
              f"{', '.join(missing)} (a box's API token is per-box + secret, so it can't be defaulted).")
        return None
    if net == "chutney":
        print(f"{RED}N/A{OFF}  chutney is a laptop-local private Tor network (vm-local only); a box "
              f"exposes tor (real onion) or https (public domain). Use --net tor|https.")
        return None
    key = os.path.expanduser(key)
    if not os.path.exists(key):
        print(f"{RED}no key{OFF}  --key {key} does not exist.")
        return None
    if not ssh_reachable(ip, key):
        print(f"{RED}box-unreachable{OFF}  root@{ip} not reachable over SSH (box down / wrong IP / wrong key).")
        return None
    base = _ssh_base(key) + [f"root@{ip}"]
    tgt = {"kind": "box", "setup": setup, "ip": ip, "key": key, "token": token, "socks": 9050,
           "onion": None, "https_domain": None,
           "server_log_cmd": " ".join(base) + " 'journalctl -u selfprivacy-api -u nginx -n 200 --no-pager'"}
    if net == "tor":
        onion = subprocess.run(base + ["cat /var/lib/tor/hidden_service/hostname"],
                               capture_output=True, text=True, timeout=20).stdout.strip()
        if not onion.endswith(".onion"):
            print(f"{RED}no onion{OFF}  box {ip} has no published hidden service "
                  f"(/var/lib/tor/hidden_service/hostname). Is tor up on the box?")
            return None
        tgt["onion"] = onion
        print(f"{GREY}box onion (live): {onion}{OFF}")
    if net == "https":
        raw = subprocess.run(base + ["cat /etc/nixos/userdata.json"],
                             capture_output=True, text=True, timeout=20).stdout
        try:
            domain = json.loads(raw).get("domain", "")
        except Exception:
            domain = ""
        if not domain:
            print(f"{RED}no domain{OFF}  couldn't read `domain` from the box's /etc/nixos/userdata.json.")
            return None
        tgt["https_domain"] = f"api.{domain}"
        print(f"{GREY}box https domain (live): api.{domain}{OFF}")
    return tgt


def _dispatch_l3(entry, net, setup, ip, extra_env, allow_dirty, base):
    """Dispatch an L3 `@flutter` catalog entry: resolve the backend target from the setup/args and
    drive the recorded Flutter flow against it. Called by run_entry AFTER its gates (clean-state / pin /
    behind-upstream / box-identity) have run for this entry — the inner recorder does not re-gate.
    Merges the box provenance the outer gate computed (stamp / live / box repos+pins) onto the run."""
    if entry.get("client") == "android" or entry["id"].endswith(".android"):
        print(f"{AMBER}android L3 not supported by this runner yet{OFF}  {entry['id']}")
        return None
    if setup in (None, "", "-"):
        print(f"{RED}no setup{OFF}  {entry['id']} — --on is required (vm-local | lan-setup-0a..0d | "
              f"lan-setup-1 | lan-setup-2 | usb-0a..0c).")
        return None
    flow = entry["id"].split(".")[1]        # L3.<flow>.desktop
    key = _env_get(extra_env, "KEY")
    token = _env_get(extra_env, "API_TOKEN")
    target = resolve_backend_target(setup, net, ip, key, token)
    if not target:
        return None
    pf = {"tor": _port_open("127.0.0.1", 9050)}
    if target["kind"] == "box":
        address = target["onion"] if net != "https" else None
        socks = target["socks"]
    elif net == "chutney":
        address, socks = _ensure_chutney()
        if not address:
            print(f"{RED}chutney backend not ready{OFF} — see /tmp/chutney_up.log.")
            return None
    elif net == "tor":
        address, socks = _get_onion(retries=25), 9050
        if not address:
            print(f"{RED}no VM onion{OFF} — the vm-local backend isn't up/published. "
                  f"Deploy it first (./dash run install.vm-local …).")
            return None
    else:  # vm https — run_l3_flutter resolves theory7 itself
        address, socks = None, None
    retries = 1 if flow == "addremove" else None
    # Baseline key = the deployed backend's identity: a box's stamped state_hash, else this code state.
    state_key = base.get("box_state_hash") or base.get("state_hash")
    rec = run_l3_flutter(address, target["token"], pf, net=net, socks_port=socks, flow=flow,
                         retries=retries, target=target, state_key=state_key)
    if rec:
        extra = {k: base[k] for k in ("box_stamp", "box_live", "box_stale", "box_state_hash",
                                      "box_method", "box_method_mismatch", "repos", "pins", "closure")
                 if k in base}
        # For a box run the closure identity is the box's running-system store path (req 92).
        if base.get("closure"):
            _sk = base.get("box_state_hash") or base.get("state_hash") or ""
            extra["state_id"] = f"{_sk}+{hashlib.sha256(base['closure'].encode()).hexdigest()[:8]}"
        if extra:
            mark_record(rec["run_id"], **extra)
            rec.update(extra)
    return rec


# ── L3 clean-state baseline: snapshot / restore the backend's mutable SP state per flow ──────────
# An L3 real-data assertion can pass/fail on LEFTOVER state (a service another flow disabled, a user a
# prior run created) rather than on the code under test. So around each flow we snapshot the backend's
# authoritative mutable state — /etc/nixos/userdata.json (enabled services = modules.*.enable, users,
# dns/server/provider config) — flag drift vs a known-clean golden baseline, and restore after. All
# target-aware (VM at localhost:2222, or a box over its SSH key). What this CANNOT cover is logged, not
# silently dropped (req 90).
L3_STATE_UNCOVERED = [
    "service DB rows / app content (Nextcloud files, Matrix rooms, Gitea repos, mail)",
    "a created system user's home dir + password hash (userdata entry is restored; the account "
    "persists until the next rebuild)",
    "backups already pushed to a remote provider",
    "DNS records created at a DNS provider",
    "a disabled service's torn-down systemd unit when the restore had no Tor mutation channel "
    "(userdata/API state is restored; the unit returns on the next rebuild)",
]


def _backend_ssh_run(target, remote_cmd, input_data=None, timeout=30):
    """Run a command on the L3 backend over SSH (no shell on the host side — argv). Target-aware:
    a box uses its --key over the LAN; the VM uses the empty-password localhost:2222 account."""
    if target and target.get("kind") == "box":
        argv = _ssh_base(target["key"]) + [f"root@{target['ip']}", remote_cmd]
    else:
        argv = ["sshpass", "-p", "", "ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=6",
                "-p", "2222", "root@localhost", remote_cmd]
    try:
        return subprocess.run(argv, input=input_data, capture_output=True, text=True, timeout=timeout)
    except Exception as ex:
        return subprocess.CompletedProcess(argv, 1, "", str(ex))


def _backend_onion(target):
    """The backend's .onion for the always-available Tor restore channel (transport-independent, like
    the old addremove backstop) — live from the box, or the VM's published HS."""
    if target and target.get("kind") == "box":
        if target.get("onion"):
            return target["onion"]
        o = (_backend_ssh_run(target, "cat /var/lib/tor/hidden_service/hostname", timeout=20).stdout or "").strip()
        return o if o.endswith(".onion") else ""
    return _get_onion(retries=3)


def _snapshot_backend(target):
    """Read the backend's mutable SP state. Returns {present, sha, raw, modules:{id:enabled}, users_n}.
    `raw` is kept in memory for restore only — NEVER recorded/persisted (it holds hashedPassword etc.)."""
    r = _backend_ssh_run(target, "cat /etc/nixos/userdata.json", timeout=30)
    raw = r.stdout or ""
    present = (r.returncode == 0) and raw.strip().startswith("{")
    modules, users_n, sha = {}, None, None
    if present:
        try:
            d = json.loads(raw)
            modules = {k: bool((v or {}).get("enable")) for k, v in (d.get("modules") or {}).items()}
            users_n = len(d.get("users") or [])
            sha = hashlib.sha256(raw.encode()).hexdigest()[:16]
        except Exception:
            present = False
    return {"present": present, "sha": sha, "raw": raw if present else "",
            "modules": modules, "users_n": users_n}


def _set_service_enabled(target, token, service_id, enable):
    """Flip a service's enabled state via the enable/disableService mutation over the backend's Tor
    onion (SOCKS) — the proven channel that also triggers the real rebuild. True on GraphQL success."""
    onion = _backend_onion(target)
    if not onion:
        return False
    mut = "enableService" if enable else "disableService"
    q = ('{"query":"mutation{ services{ %s(serviceId:\\"%s\\")'
         '{ success message } } }"}' % (mut, service_id))
    socks = (target or {}).get("socks") or 9050
    try:
        out = subprocess.run(
            ["curl", "-s", "--socks5-hostname", f"127.0.0.1:{socks}", "-k",
             "-H", f"Authorization: Bearer {token}", "-H", "Content-Type: application/json",
             "-d", q, f"https://{onion}/graphql"],
            capture_output=True, text=True, timeout=90).stdout or ""
        return '"success":true' in out.replace(" ", "")
    except Exception:
        return False


def _restore_backend(pre, post, target, token):
    """Restore the backend to the pre-flow snapshot. Hybrid: service-enable diffs via GraphQL mutation
    (authoritative, triggers the rebuild), then a userdata.json file-restore fallback for any remaining
    non-service fields (users/dns/server — the API reads these from the file; deeper systemd/home-dir
    effects apply on the next rebuild, see L3_STATE_UNCOVERED). Returns a list of what it restored."""
    if not (pre.get("present") and post.get("present")):
        return ["(skipped: userdata.json unreadable pre or post)"]
    if post["sha"] == pre["sha"]:
        return []
    restored = []
    pm, qm = pre["modules"], post["modules"]
    for sid in sorted(set(pm) | set(qm)):
        want = pm.get(sid, False)            # services present in post but not pre → disable (want=False)
        have = qm.get(sid, False)
        if want != have:
            ok = _set_service_enabled(target, token, sid, want)
            restored.append(f"service:{sid}->{'enabled' if want else 'disabled'}"
                            + ("" if ok else " (mutation FAILED)"))
    # File-level fallback: re-read; if userdata still differs (non-service fields), write pre back.
    post2 = _snapshot_backend(target)
    if post2.get("present") and post2["sha"] != pre["sha"]:
        w = _backend_ssh_run(target, "cat > /etc/nixos/userdata.json", input_data=pre["raw"], timeout=30)
        restored.append("userdata.json (file-restored; non-service fields apply on next rebuild)"
                        if w.returncode == 0 else "userdata.json file-restore FAILED")
    return restored


def _l3_baseline_path(state_key, setup):
    safe = re.sub(r"[^A-Za-z0-9_.-]", "_", f"{state_key or 'unknown'}__{setup or 'unknown'}")
    return os.path.join(ROOT, "state", "l3_baseline", safe + ".json")


def _l3_baseline(state_key, setup, pre):
    """Compare the pre-flow snapshot to the captured golden baseline for this (state, setup). Returns
    (match, drift_summary). Auto-captures the golden from `pre` if none exists (loud log) — valid only
    when the backend was freshly (re)installed before the first flow; re-bless via `dash l3-baseline`.
    The golden stores only sha + the modules/users summary (no secrets)."""
    if not pre.get("present"):
        return True, "(backend state unreadable — baseline not evaluated)"
    p = _l3_baseline_path(state_key, setup)
    golden = None
    if os.path.exists(p):
        try:
            golden = json.load(open(p))
        except Exception:
            golden = None
    if golden is None:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        json.dump({"sha": pre.get("sha"), "modules": pre.get("modules"), "users_n": pre.get("users_n"),
                   "setup": setup, "state_key": state_key, "captured": now_iso()}, open(p, "w"), indent=1)
        print(f"{AMBER}l3-baseline{OFF} captured golden for {state_key}/{setup} from the current "
              f"pre-flow state — assumes the backend was freshly installed. Re-bless after a reinstall "
              f"with {CYAN}./dash l3-baseline capture --on {setup} …{OFF}")
        return True, "golden auto-captured from this pre-state"
    if golden.get("sha") == pre.get("sha"):
        return True, ""
    drift, gm, nm = [], golden.get("modules") or {}, pre.get("modules") or {}
    for sid in sorted(set(gm) | set(nm)):
        if gm.get(sid) != nm.get(sid):
            drift.append(f"{sid}: baseline={gm.get(sid)} now={nm.get(sid)}")
    if golden.get("users_n") != pre.get("users_n"):
        drift.append(f"users: baseline={golden.get('users_n')} now={pre.get('users_n')}")
    if not drift:
        drift.append("userdata.json differs in fields outside modules/users")
    return False, "; ".join(drift)


def run_l3_flutter(address, token, pf, net="tor", socks_port=9050, flow="providers", retries=None,
                   target=None, state_key=None):
    """Run an AUTOMATED L3 desktop flow test, recorded, over transport `net`
    (tor | chutney | https). `flow` selects which dashboard-owned test to run
    (flutter/<flow>_flow_test.dart — providers/connect/login/services/nextcloud/menus/addremove).
    The test lives in the dashboard repo and is injected into the app for the run, then the Manager
    repo is restored byte-for-byte. For tor/chutney the app dials an .onion over SOCKS; for https it
    dials the same backend over clearnet HTTPS.

    `target` (from resolve_backend_target) selects the backend: None or kind=="vm" → the local
    VirtualBox VM (localhost:2222, SSH tunnel for https, theory7 + mkcert for the cert) — the legacy
    path, unchanged. kind=="box" → a deployed physical box reached over the LAN: the app dials the
    box's live onion (real Tor, SOCKS 9050) or its public https domain (system-trust LE cert, no
    tunnel/CA); server logs come over the box's SSH key. The recorded `method` is the real setup."""
    is_box = bool(target and target.get("kind") == "box")
    setup = (target or {}).get("setup") or "vm-local"
    rec = None
    pre_state, base_match, base_drift = None, True, ""   # per-flow clean-state baseline (req 90)
    app = os.path.normpath(os.path.join(ROOT, FLUTTER_APP_DIR))
    test_src = os.path.join(ROOT, "flutter", f"{flow}_flow_test.dart")
    if not os.path.exists(test_src):
        print(f"{RED}missing {test_src}{OFF}")
        return None
    is_tor = net in ("tor", "chutney")     # onion transports (SOCKS + Tor flakiness/retry)
    if not is_box:
        _ensure_api_nix_path()             # VM backend needs nix for Services on ANY transport
                                           # (a box already has it provisioned at install)
    if net == "https" and is_box:
        # Box over PUBLIC clearnet HTTPS: the app dials the box's real public domain (e.g.
        # api.weersurf.nl) and validates its Let's Encrypt cert against the SYSTEM trust store — no
        # SSH tunnel, no mkcert CA. A bad/expired cert fails red.
        address = target["https_domain"]
        dart_defines = (f"--dart-define=HTTPS_DOMAIN={address} --dart-define=API_TOKEN={token} "
                        f"--dart-define=HTTPS_APEX=1")
        print(f"{GREY}box https: dialing https://{address}/graphql (system-trust LE cert){OFF}")
    elif net == "https":
        # VM over clearnet HTTPS: trusted real domain (theory7.weersurf.nl) via Caddy+mkcert + an SSH
        # tunnel to the VM nginx — NOT the old self-signed nip.io hack. App connects to
        # https://<domain>/graphql (HTTPS_APEX) and validates the cert against the mkcert CA
        # (HTTPS_CA), so a bad cert fails red.
        address, ca = _ensure_theory7()
        dart_defines = (f"--dart-define=HTTPS_DOMAIN={address} --dart-define=API_TOKEN={token} "
                        f"--dart-define=HTTPS_APEX=1")
        if ca:
            dart_defines += f" --dart-define=HTTPS_CA={ca}"
        else:
            print(f"{AMBER}mkcert CA not found ({MKCERT_CA}) — run setup-theory7-https.sh so the app "
                  f"can VALIDATE the cert (falling back to trust-anything for this run).{OFF}")
    else:
        # onion transports: tor (real Tor, SOCKS 9050) or chutney (private net, its client SOCKS).
        have_socks = True if net == "chutney" else pf.get("tor")
        if not have_socks:
            print(f"{AMBER}note{OFF}: host Tor (127.0.0.1:9050) is down — the app may not reach the "
                  f".onion; the run is still recorded. {CYAN}sudo systemctl start tor{OFF}")
        # Gate on the onion answering over SOCKS RIGHT BEFORE launch (cold circuits throw
        # hostUnreachable, which integration_test treats as a fatal uncaught error).
        if have_socks:
            if not _onion_reachable(address, tries=6, socks_port=socks_port):
                if net == "tor" and not is_box:
                    print(f"{GREY}onion not answering yet — restarting the VM's tor to force a descriptor upload…{OFF}")
                    _kick_vm_tor()
                elif net == "tor" and is_box:
                    print(f"{GREY}box onion not answering yet — waiting for a fresh descriptor (not kicking the box's tor)…{OFF}")
                _onion_reachable(address, tries=30, socks_port=socks_port)
        dart_defines = (f"--dart-define=ONION_DOMAIN={address} --dart-define=API_TOKEN={token} "
                        f"--dart-define=SOCKS_PORT={socks_port}")
    itdir = os.path.join(app, "integration_test")
    injected = os.path.join(itdir, f"{flow}_flow_test.dart")
    backup = {f: open(os.path.join(app, f)).read() for f in ("pubspec.yaml", "pubspec.lock")
              if os.path.exists(os.path.join(app, f))}
    created_dir = not os.path.isdir(itdir)
    try:
        print(f"{GREY}injecting automated test into the app (temporary — Manager repo restored after)…{OFF}")
        ensure_integration_dep(app)
        os.makedirs(itdir, exist_ok=True)
        shutil.copy(test_src, injected)
        # Use the app flake's PINNED flutter (flutter332 — pubspec wants >=3.32.0 <3.33.0), NOT the
        # system flutter (which may be newer and would silently re-resolve pubspec.lock → the app
        # under test ≠ the committed deps). --enforce-lockfile makes pub REFUSE to change the lock:
        # with the pinned toolchain it matches and nothing drifts; if it ever can't, it fails LOUD
        # (detection) instead of testing unknown deps. So L3 "just runs" and stays honest.
        print(f"{GREY}flutter pub get --enforce-lockfile (pinned flutter via the app flake)…{OFF}")
        _pg = _sh(f"cd '{app}' && nix develop -c bash -c 'export FLUTTER_SUPPRESS_ANALYTICS=true; flutter config --enable-linux-desktop >/dev/null 2>&1; flutter pub get --enforce-lockfile'", timeout=1800)
        if _pg.returncode != 0:
            print(f"{RED}pub get --enforce-lockfile FAILED{OFF}  L3.{flow}.desktop — the committed "
                  f"pubspec.lock does not match what the pinned flutter resolves.")
            print(f"  The app under test would NOT be the committed deps, so refusing to run (not a "
                  f"target failure). Fix: regenerate the lock WITH the pinned toolchain")
            print(f"  (cd '{app}' && nix develop -c flutter pub get) and commit it to the app fork, "
                  f"then bump the Manager submodule pointer.")
            return
        # server logs come from wherever the backend runs: the box over its SSH key, else the VM.
        if is_box:
            _slog = (" ".join(_ssh_base(target["key"])) + f" root@{target['ip']} "
                     "'journalctl -u selfprivacy-api -u nginx -n 200 --no-pager'")
        else:
            _slog = ("sshpass -p '' ssh -o StrictHostKeyChecking=no -p 2222 root@localhost "
                     "'journalctl -u selfprivacy-api -u nginx -n 200 --no-pager'")
        entry = {
            "id": f"L3.{flow}.desktop", "name": flow, "level": "L3",
            "client": "desktop", "networks": [net], "repo": FLUTTER_APP_DIR,
            # Inner recorder only — the outer run_entry already ran the gates for this run; don't
            # re-gate (_no_gate ⇒ clean-state/pin/behind skipped; needs_box False ⇒ no box gate).
            "needs_box": False, "_no_gate": True,
            "budget_s": 600, "records_video": True, "env": {"FLUTTER_SUPPRESS_ANALYTICS": "true"},
            "cmd": f"nix develop -c flutter test integration_test/{flow}_flow_test.dart -d linux " + dart_defines,
            "server_log_cmd": _slog,
        }
        # Retry on TRANSIENT Tor failures only. The app's reload() timer throws uncaught on a
        # cold-circuit `hostUnreachable`, and integration_test fails on ANY uncaught async error
        # (the real app just logs it and retries on its next 10s tick). A fresh launch on a warm
        # circuit connects — so we retry, kicking the VM's tor between attempts. Clearnet HTTPS is
        # reliable, so https gets a single attempt; a failure there is real and stays red.
        transient_markers = ("hostUnreachable", "TimeoutException", "SocketException", "Connection refused")
        keepwarm = _start_keepwarm(address, socks_port=socks_port) if (
            is_tor and (net == "chutney" or pf.get("tor"))) else None
        # Onion transports retry transient Tor flakiness; clearnet https gets one shot. A caller can
        # force a specific attempt count (e.g. retries=1 for MUTATING flows like addremove, where a
        # blind re-run would re-trigger the backend mutation and confuse the service state).
        max_attempts = retries if retries else (3 if is_tor else 1)
        # Snapshot the backend's mutable SP state BEFORE the flow, and flag drift vs the known-clean
        # golden baseline — so a result reflects the code, not leftover state (req 90). Restored in
        # `finally`. Target-aware (VM or box).
        pre_state = _snapshot_backend(target)
        base_match, base_drift = _l3_baseline(state_key, setup, pre_state)
        if not base_match:
            print(f"{AMBER}l3-baseline drift{OFF}  {flow}/{setup}: pre-flow backend ≠ golden "
                  f"({base_drift}) — the result may reflect leftover state, not code.")
        for attempt in range(1, max_attempts + 1):
            rec = run_entry(entry, net=net, method=setup, record=True, shots=True)
            if not rec or rec.get("status") == "pass":
                break
            log_txt = ""
            cl = (rec.get("artifacts") or {}).get("client_log")
            if cl and os.path.exists(os.path.join(ROOT, cl)):
                log_txt = open(os.path.join(ROOT, cl), errors="replace").read()
            is_transient = any(m in log_txt for m in transient_markers)
            if is_tor and is_transient and attempt < max_attempts:
                print(f"{AMBER}transient {net} connection failure{OFF} — retrying "
                      f"(attempt {attempt + 1}/{max_attempts})…")
                # Keep the attempt (marked flaky), don't delete it — a 'transient' marker can be a
                # REAL intermittent bug; hiding it would misrepresent reliability. The cell headline
                # is still the later pass; flaky fails live in the run history.
                mark_record(rec["run_id"], flaky=True, flaky_reason=f"transient {net} failure, retried")
                if net == "tor" and not is_box:
                    _kick_vm_tor()                   # chutney HS is host-side; nothing to kick;
                                                     # a box's tor is remote — don't restart it
                _onion_reachable(address, tries=20, socks_port=socks_port)  # re-warm before next launch
            else:
                break                                # a real failure (or out of attempts) — keep it
        if keepwarm:
            keepwarm.set()
    finally:
        print(f"{GREY}restoring Manager repo (removing injected test, reverting pubspec)…{OFF}")
        try:
            if os.path.exists(injected):
                os.remove(injected)
            if created_dir and os.path.isdir(itdir) and not os.listdir(itdir):
                os.rmdir(itdir)
        except Exception:
            pass
        for f, content in backup.items():
            open(os.path.join(app, f), "w").write(content)
        # Restore the backend's mutable SP state so the next flow starts from the same clean baseline
        # (generalises the old addremove-only _reenable_service backstop to EVERY flow, both toggle
        # directions, and file-level fields — and it's target-aware: VM or box). What it can't cover is
        # logged, never silently dropped (req 90).
        if pre_state is not None:
            try:
                post_state = _snapshot_backend(target)
                restored = _restore_backend(pre_state, post_state, target, token)
                if restored:
                    print(f"{GREY}backend restore ({setup}): {', '.join(restored)}{OFF}")
                    print(f"{GREY}  NOT covered by snapshot/restore: {'; '.join(L3_STATE_UNCOVERED)}{OFF}")
                if rec:
                    mark_record(rec["run_id"], l3_baseline_match=base_match, l3_baseline_drift=base_drift,
                                l3_restored=restored, l3_pre_sha=pre_state.get("sha"),
                                l3_post_sha=post_state.get("sha"),
                                l3_state_uncovered=(L3_STATE_UNCOVERED if restored else []))
            except Exception as e:
                print(f"{AMBER}backend snapshot/restore failed ({setup}): {e}{OFF}")
    return rec


def cmd_here(args):
    cat = load_catalog()
    mode = "long (full backend bring-up)" if args.long else "quick (use a running backend if present)"
    print(f"{BOLD}dash here — {mode}{OFF}\n")

    # Everything needing sudo is handled here, up front.
    pf = preflight(do_sudo=args.long)

    # One-time app build deps (Flutter + Linux toolchain) via the Manager's own script.
    if args.setup:
        mgr = os.path.normpath(os.path.join(ROOT, "../Manager-Ubuntu-SelfPrivacy-Over-Tor"))
        print(f"{BOLD}setup{OFF}: {mgr}/scripts/requirements.sh --app-linux (apt/sudo, one-time)")
        subprocess.run("./scripts/requirements.sh --app-linux", shell=True, cwd=mgr)
        # Xvfb: for reliable headless UI recording on Wayland (x11grab of :0 captures black there).
        subprocess.run("command -v Xvfb >/dev/null || sudo apt-get install -y xvfb", shell=True)
        pf = preflight(do_sudo=args.long)            # re-check after install

    # Fail fast: --long's whole point is the recorded app test (L3). If a hard prerequisite for it is
    # missing, stop NOW — before the multi-minute VM build + tests — instead of discovering it at the end.
    if args.long:
        need = {"vbox": "VirtualBox", "flutter": "Flutter (run with --setup)",
                "display": "a graphical display", "tor": "host Tor on 127.0.0.1:9050"}
        missing = [need[k] for k in need if not pf[k]]
        if missing:
            print(f"\n{RED}Aborting before doing any heavy work.{OFF} --long runs the app test (L3), which needs:")
            for m in missing:
                print(f"  {RED}✗{OFF} {m}")
            print(f"Fix the above and re-run. (For just the fast checks, use {CYAN}./dash here --fast{OFF} "
                  f"or {CYAN}./dash run L1.onion-routing{OFF}.)")
            sys.exit(1)

    # L1 + L2 FIRST — they use nix/QEMU (KVM). The VirtualBox backend must NOT be running while these
    # run: VirtualBox and KVM both grab Intel VT-x, and the contention guru-meditates the VBox VM
    # (VERR_VMX_INVALID_VMXON_PTR). So the VBox backend is brought up only AFTER the KVM tests finish.
    if pf["vbox"] and _vm_running():
        print(f"{GREY}powering off the VBox VM during the KVM tests (VT-x can't be shared)…{OFF}")
        _power_off_hard()
    run_entry(entry_by_id(cat, "L1.onion-routing"))
    if args.fast:
        print(f"{GREY}skipping L2 (--fast){OFF}")
    else:
        for net in ("tor", "https"):
            run_entry(entry_by_id(cat, "L2.backend"), net=net)

    # Backend (VirtualBox) — AFTER the KVM tests, so nothing else is holding VT-x.
    onion = None
    if not pf["vbox"]:
        print(f"{AMBER}skip backend/L3{OFF} — VirtualBox not installed")
    elif args.long:
        onion = bring_up_backend(cat)
    else:
        onion, _, note = ensure_backend(install_ok=not args.no_install)
        if not onion:
            print(f"{AMBER}backend not ready{OFF} — {note}. Use {CYAN}./dash here --long{OFF} to build it + start Tor.")

    # L3 — the real app over Tor, driven by the automated integration test, recorded.
    # Gate on the .onion actually being reachable, so we never launch the app into a refused loop.
    if onion and pf["flutter"] and pf["display"]:
        print(f"{GREY}backend .onion: {onion} — checking it's reachable over Tor…{OFF}")
        if not pf["tor"]:
            print(f"{AMBER}skip L3{OFF} — host Tor (127.0.0.1:9050) isn't running, so the app can't reach the "
                  f"onion. Start it: {CYAN}sudo systemctl start tor{OFF}, then re-run.")
            reachable = False
        elif _onion_reachable(onion, tries=4):       # quick: already-warm onion answers fast
            reachable = True
        else:                                        # cold boot: kick the VM's tor, then wait generously
            print(f"{GREY}onion not up yet — restarting the VM's tor to force a descriptor upload…{OFF}")
            _kick_vm_tor()
            reachable = _onion_reachable(onion)
        if pf["tor"] and reachable:
            print(f"{GREEN}onion reachable — launching the automated app test.{OFF}")
            run_l3_flutter(onion, DEV_TOKEN, pf)
        elif pf["tor"]:
            print(f"{AMBER}skip L3{OFF} — the backend .onion never answered over Tor. The VM likely didn't "
                  f"stay up (check {CYAN}VBoxManage showvminfo {VM_NAME} | grep State{OFF}) or the Tor HS "
                  f"isn't published yet. Not launching the app (would just loop on 'connection refused').")
    else:
        why = "no backend .onion" if not onion else ("flutter missing" if not pf["flutter"] else "no display")
        print(f"{AMBER}skip L3{OFF} — {why}. (Run {CYAN}./dash here --long{OFF} once flutter deps are installed.)")

    if not args.no_publish:
        cmd_publish(argparse.Namespace(message=f"dash here @ {now_iso()}"))
    print(f"\n{BOLD}dash here done.{OFF} View: ./dash serve" + ("" if args.no_publish else "  ·  pushed to the live board"))


L3_FLOWS = ["connect", "login", "services", "providers", "nextcloud", "users", "menus", "addremove"]


def cmd_rerecord(args):
    """Re-run + re-record the L3 desktop flows over ONE transport (default chutney), producing
    fresh videos + screenshots. Each run STACKS a new record newest-first (old videos stay on
    disk but the latest record points at the new ones). Brings the backend VM up; for chutney it
    also stands up the private chutney network + host-side HS. The mutating flow (addremove) gets a
    single attempt so a blind retry can't double-apply the backend mutation."""
    cat = load_catalog()
    net = args.net or "chutney"
    if net not in ("chutney", "tor", "https"):
        print(f"{RED}--net must be chutney|tor|https (got {net}){OFF}")
        sys.exit(1)
    flows = [f.strip() for f in args.flows.split(",")] if args.flows else L3_FLOWS
    pf = preflight(do_sudo=args.long)
    if not (pf["flutter"] and pf["display"]):
        print(f"{RED}can't record L3{OFF} — need Flutter + a display (see preflight above). "
              f"Install app deps with {CYAN}./dash here --setup{OFF}.")
        sys.exit(1)

    # Backend VM (persistent onion) must be up for every transport — chutney/https proxy to it too.
    if args.long:
        base_onion = bring_up_backend(cat)
    else:
        base_onion, _, note = ensure_backend(install_ok=not args.no_install)
    if not base_onion:
        print(f"{AMBER}backend not ready{OFF} — {note if not args.long else 'VM/onion not up'}. "
              f"Try {CYAN}./dash rerecord --net {net} --long{OFF} to build + boot it.")
        sys.exit(1)

    # Resolve the endpoint + SOCKS port for the chosen transport.
    if net == "chutney":
        address, socks = _ensure_chutney()
        if not address:
            print(f"{RED}chutney backend not ready — aborting (see /tmp/chutney_up.log).{OFF}")
            sys.exit(1)
    elif net == "tor":
        address, socks = base_onion, 9050
    else:  # https — run_l3_flutter resolves theory7.weersurf.nl + the mkcert CA itself
        address, socks = None, None

    print(f"{BOLD}re-recording {len(flows)} {net} flow(s):{OFF} {', '.join(flows)}")
    ok = 0
    for flow in flows:
        retries = 1 if flow == "addremove" else None
        rec = run_l3_flutter(address, DEV_TOKEN, pf, net=net, socks_port=socks, flow=flow, retries=retries)
        if rec and rec.get("status") == "pass":
            ok += 1

    if net == "chutney" and not args.keep_up:
        print(f"{GREY}tearing down chutney (real Tor + VM left untouched)…{OFF}")
        _stop_chutney()
    if not args.no_publish:
        cmd_publish(argparse.Namespace(message=f"rerecord {net} L3 ({ok}/{len(flows)} pass) @ {now_iso()}"))
    print(f"\n{BOLD}rerecord done.{OFF} {ok}/{len(flows)} pass. View: {CYAN}./dash serve{OFF}")


def cmd_vm_reset(args):
    print(f"{BOLD}vm-reset{OFF} — killing stale VBox sessions and removing all copies of {VM_NAME}…")
    _destroy_vm()
    left = _vm_uuids()
    print(f"{GREEN}clean.{OFF}" if not left else f"{AMBER}still present: {left}{OFF} (try again, or check VBox GUI)")


def main():
    p = argparse.ArgumentParser(prog="dash", description="orchestrate + record SelfPrivacy dev/test runs")
    sub = p.add_subparsers(dest="cmd", required=True)

    sub.add_parser("list").set_defaults(fn=cmd_list)

    r = sub.add_parser("run")
    r.add_argument("ids", nargs="*")
    r.add_argument("--all", action="store_true")
    r.add_argument("--level")
    r.add_argument("--category")
    r.add_argument("--tag")
    r.add_argument("--config", help="label the current dirty working tree")
    r.add_argument("--net", help="network/transport: tor|chutney|https|...")
    r.add_argument("--on", help="install method the backend runs on: vm-local|native-ethernet|...")
    r.add_argument("--record", action="store_true", help="screen-record the client UI (local media)")
    r.add_argument("--server-log", help="shell cmd to fetch backend logs after the run (e.g. ssh ... journalctl)")
    r.add_argument("--ip", help="override the target IP for install runs (else the per-setup default; if unreachable the e2e auto-discovers the box on the LAN by MAC)")
    r.add_argument("--key", help="ssh private key path for a box target (required for L3/install on lan-setup-*/usb-*; injected as env KEY=)")
    r.add_argument("--token", help="API token of the box backend (required for L3 on a box; per-box + secret, never defaulted; injected as env API_TOKEN=)")
    r.add_argument("--env", action="append", metavar="KEY=VAL",
                   help="set/override an env var for the run (repeatable): --env DOMAIN=example.com --env MAC=aa:bb:...")
    r.add_argument("--allow-dirty", action="store_true", help="run even if the target code repo has uncommitted changes (default: refuse)")
    r.set_defaults(fn=cmd_run)

    w = sub.add_parser("wrap")
    w.add_argument("id")
    w.add_argument("--config")
    w.add_argument("--net")
    w.add_argument("--on")
    w.add_argument("--record", action="store_true")
    w.add_argument("--server-log")
    w.add_argument("cmd", nargs=argparse.REMAINDER, help="-- then the command")
    w.set_defaults(fn=cmd_wrap)

    rp = sub.add_parser("report")
    rp.add_argument("id")
    rp.add_argument("--status", required=True, choices=["pass", "fail", "slow", "skip"])
    rp.add_argument("--duration", required=True, type=float)
    rp.add_argument("--error", default="")
    rp.add_argument("--config", default="")
    rp.add_argument("--net")
    rp.add_argument("--on")
    rp.add_argument("--env")
    rp.add_argument("--host")
    rp.add_argument("--ip", help="box IP — read its deploy stamp and record THAT as the authoritative state")
    rp.add_argument("--key", help="ssh key for --ip")
    rp.set_defaults(fn=cmd_report)

    vb = sub.add_parser("verify-box")
    vb.add_argument("--ip", required=True, help="deployed box IP to check")
    vb.add_argument("--key", help="ssh private key path")
    vb.set_defaults(fn=cmd_verify_box)

    ft = sub.add_parser("find-target", help="discover + confirm the install target device (match the MAC on its screen)")
    ft.add_argument("--on", help="setup hint (unused for scan; kept for symmetry)")
    ft.add_argument("--subnet", help="extra LAN subnet prefix to scan, e.g. 192.168.1")
    ft.set_defaults(fn=cmd_find_target)

    lb = sub.add_parser("l3-baseline", help="capture/show the known-clean golden backend baseline for an L3 setup")
    lb.add_argument("action", nargs="?", choices=["capture", "show"], default="capture")
    lb.add_argument("--on", required=True, help="setup: vm-local|lan-setup-0a..0d|lan-setup-1|lan-setup-2|usb-0a..0c")
    lb.add_argument("--ip", help="box IP (required for a box setup)")
    lb.add_argument("--key", help="ssh private key path (required for a box setup)")
    lb.add_argument("--token", help="box API token (required for a box setup)")
    lb.set_defaults(fn=cmd_l3_baseline)

    s = sub.add_parser("serve")
    s.add_argument("port", nargs="?", type=int, default=8099)
    s.set_defaults(fn=cmd_serve)

    pub = sub.add_parser("publish")
    pub.add_argument("-m", "--message")
    pub.set_defaults(fn=cmd_publish)

    h = sub.add_parser("here", help="run everything this host can (L1 + L2 + recorded L3), then publish")
    h.add_argument("--long", action="store_true",
                   help="full bring-up: sudo-start Tor + build the VM via build-and-run.sh, then run+record the app")
    h.add_argument("--setup", action="store_true",
                   help="one-time: run the Manager's requirements.sh --app-linux first (Flutter + Linux build deps)")
    h.add_argument("--fast", action="store_true", help="skip the long L2 nixosTests")
    h.add_argument("--no-install", action="store_true", help="(quick mode) don't start/create a VM")
    h.add_argument("--no-publish", action="store_true", help="don't commit+push results at the end")
    h.set_defaults(fn=cmd_here)

    rr = sub.add_parser("rerecord", help="re-run + re-record the L3 desktop flows over one transport (default chutney)")
    rr.add_argument("--net", default="chutney", help="transport: chutney|tor|https")
    rr.add_argument("--flows", help="comma-separated subset, e.g. connect,login (default: all 8)")
    rr.add_argument("--long", action="store_true", help="full VM bring-up (build if missing, sudo-start host Tor)")
    rr.add_argument("--no-install", action="store_true", help="don't create a VM if one is missing")
    rr.add_argument("--keep-up", action="store_true", help="leave the chutney network running afterward")
    rr.add_argument("--no-publish", action="store_true", help="don't commit+push results at the end")
    rr.set_defaults(fn=cmd_rerecord)

    sub.add_parser("backfill-provenance", help="add dial_domain/socks_port to old app-run records (from their logs)").set_defaults(fn=cmd_backfill_provenance)
    sub.add_parser("vm-reset", help="kill stale VBox sessions + remove all copies of the SelfPrivacy VM").set_defaults(fn=cmd_vm_reset)
    sub.add_parser("setups", help="show the install setups (--on values) with topology diagrams").set_defaults(fn=cmd_setups)
    sub.add_parser("demo").set_defaults(fn=cmd_demo)
    sub.add_parser("clear-demo").set_defaults(fn=cmd_clear_demo)

    # wrap uses REMAINDER; strip the leading '--' if present
    argv = sys.argv[1:]
    if len(argv) >= 2 and argv[0] == "wrap" and "--" in argv:
        argv.remove("--")
    args = p.parse_args(argv)
    args.fn(args)


if __name__ == "__main__":
    main()
