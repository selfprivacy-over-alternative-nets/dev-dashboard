# Redact live .onion addresses so they never reach the published dashboard.
_ONION_RE = re.compile(r"[a-z2-7]{16,56}\.onion")


def scrub(text):
    return _ONION_RE.sub("<onion>", text or "")

ROOT = os.path.dirname(os.path.abspath(__file__))
# Results live in the separate `testresults` repo when it's cloned here (so result commits
# stay out of the code/dashboard repos and never dirty the code state); else fall back to local.
_TR = os.path.join(ROOT, "testresults")
RESULTS_ROOT = _TR if os.path.isdir(_TR) else ROOT
DATA = os.path.join(_TR, "results.jsonl") if RESULTS_ROOT == _TR else os.path.join(ROOT, "data", "results.jsonl")
LOGS = os.path.join(RESULTS_ROOT, "logs")
MEDIA = os.path.join(RESULTS_ROOT, "media")
CATALOG = os.path.join(ROOT, "catalog.json")

GREEN, AMBER, RED, GREY, BOLD, OFF = "\033[32m", "\033[33m", "\033[31m", "\033[90m", "\033[1m", "\033[0m"
CYAN = "\033[36m"
GLYPH = {"pass": "🟢", "slow": "🟠", "fail": "🔴", "skip": "⚪", "running": "…"}


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def load_catalog():
    with open(CATALOG) as f:
        return json.load(f)


def all_entries(cat):
    return list(cat.get("tests", [])) + list(cat.get("installs", []))


# ── Install setups (--on) + preflight ────────────────────────────────────────
# The --on value names a setup (vm-local | lan-setup-0/1/2 | usb). Before an
# install runs, preflight() checks the setup is feasible NOW and, if not, returns
# an actionable fix instead of half-running. Topology diagrams live in the catalog
# (install_methods[].topology) so they render in `./dash setups` and the README.
DIRECT_IFACE = os.environ.get("SP_NETBOOT_IFACE", "enp0s31f6")
DIRECT_IP = "192.168.100.1"


def _iface_has_ip(iface, ip):
    r = subprocess.run(["ip", "-4", "addr", "show", iface], capture_output=True, text=True)
    return ip in r.stdout


def _local_prefixes():
    """The /24 prefixes this laptop is on (RFC1918) + the direct-cable netboot subnet — the subnets a
    target could appear on."""
    out = _sh("ip -4 -o addr show scope global", timeout=10).stdout or ""
    pref = set()
    for line in out.splitlines():
        for tok in line.split():
            if "/" in tok and tok.count(".") == 3:
                a = tok.split("/")[0].split(".")
                if a[0] == "10" or (a[0] == "192" and a[1] == "168") or (a[0] == "172" and a[1].isdigit() and 16 <= int(a[1]) <= 31):
                    pref.add(".".join(a[:3]))
    pref.add(DIRECT_IP.rsplit(".", 1)[0])
    return sorted(pref)


def _ping_sweep(prefix):
    """Quietly populate the neighbour table for a /24 (parallel, no job-control noise)."""
    _sh(f"seq 254 | xargs -P254 -I{{}} ping -c1 -W1 {prefix}.{{}} >/dev/null 2>&1", timeout=60)


def _neigh_pairs():
    """(mac, ip) for every neighbour with a resolved lladdr."""
    out = _sh("ip neigh", timeout=10).stdout or ""
    res = []
    for line in out.splitlines():
        p = line.split()
        if "lladdr" in p and "." in p[0]:
            res.append((p[p.index("lladdr") + 1].lower(), p[0]))
    return res


def _netboot_leases():
    """(mac, ip) of devices that took a lease from the direct-cable netboot server — i.e. booted into
    the installer. The strongest signal for 'this is the target'."""
    res, path = [], "/tmp/netboot-leases"
    if os.path.exists(path):
        for line in open(path):
            f = line.split()
            if len(f) >= 3 and ":" in f[1] and "." in f[2]:
                res.append((f[1].lower(), f[2]))
    return res


def _iface_carrier(iface):
    """True if the NIC has a live link (carrier), False if not, None if unknown. No carrier on the
    wired port = nothing is plugged in / the target NIC is off — a target can't be discovered."""
    try:
        return open(f"/sys/class/net/{iface}/carrier").read().strip() == "1"
    except Exception:
        return None


def _up_ifaces():
    out = _sh("ip -br link", timeout=10).stdout or ""
    res = []
    for line in out.splitlines():
        parts = line.split()
        if not parts:
            continue
        name = parts[0].split("@")[0]
        if name != "lo" and not name.startswith(("docker", "veth", "br-", "virbr")):
            res.append(name)
    return res


def _ipv6_ll_discover():
    """Devices reachable by IPv6 link-local multicast (ff02::1) — works even with NO IPv4 / no DHCP,
    e.g. a target cabled straight to this laptop (lan-setup-0*). Returns [(mac, iface)]."""
    for ifc in _up_ifaces():
        _sh(f"ping -6 -c2 -W1 ff02::1%{ifc} >/dev/null 2>&1", timeout=8)
    res = []
    for line in (_sh("ip -6 neigh", timeout=10).stdout or "").splitlines():
        p = line.split()
        if p and p[0].lower().startswith("fe80") and "lladdr" in p and "dev" in p:
            dev = p[p.index("dev") + 1]
            if dev != "lo" and not dev.startswith(("docker", "veth", "br-", "virbr")):
                res.append((p[p.index("lladdr") + 1].lower(), dev))
    return res


def setup_preflight(method):
    """Return (ok, message): whether `install --on <method>` can run right now."""
    if method in (None, "", "-", "test-vm", "vm-remote"):
        return True, ""
    if method == "vm-local":
        if not shutil.which("VBoxManage"):
            return False, "VirtualBox not found (VBoxManage). Install it, e.g. `sudo apt install virtualbox`."
        return True, ""
    if (method or "").startswith("lan-setup-0"):   # lan-setup-0 / 0a / 0b / 0c / 0d
        if not _iface_has_ip(DIRECT_IFACE, DIRECT_IP):
            return False, (
                f"Direct-link netboot server is not running on {DIRECT_IFACE}.\n"
                f"  1) Cable: laptop {DIRECT_IFACE} <-> target ethernet (router OUT of path)\n"
                f"  2) sudo bash ~/netboot/start-netboot-server.sh   (leave it running)\n"
                f"  3) Boot the target into UEFI network mode, then re-run.")
        return True, ""
    if method in ("lan-setup-1", "lan-setup-2"):
        return False, (
            "Router R is not configured for network boot, so the target cannot PXE over R.\n"
            "  R's own DHCP server fights the installer's DHCP. To use this setup, configure R to EITHER:\n"
            "    - disable R's DHCP and let THIS laptop serve DHCP+TFTP on R's LAN, OR\n"
            "    - set R's DHCP boot options (next-server=this laptop, filename=ipxe.efi) [proxyDHCP],\n"
            "      pointing TFTP/HTTP at ~/netboot.\n"
            "  Until R is set up, use  --on lan-setup-0  (direct cable)  or  --on usb.\n"
            "  Details: dev-dashboard/README.md (Setups).")
    if (method or "").startswith("usb"):           # usb / usb-0a / 0b / 0c
        return True, ""  # manual boot; install cmd is @manual
    return True, ""


def cmd_setups(args):
    ms = load_catalog().get("install_methods", [])
    print(f"{BOLD}Install setups (--on values){OFF}\n")
    for m in ms:
        print(f"{BOLD}{m['id']}{OFF}  {GREY}{m.get('label','')}{OFF}")
        print(f"  {m.get('desc','')}")
        for line in (m.get("topology") or "").splitlines():
            print(f"    {CYAN}{line}{OFF}")
        print()


def entry_by_id(cat, cid):
    for e in all_entries(cat):
        if e["id"] == cid:
            return e
    return _resolve_install_alias(cat, cid)


def _resolve_install_alias(cat, cid):
    """Accept the FINE install-setup ids as run targets: install.lan-setup-0a..0d → the coarse
    install.lan-setup-0 entry, install.usb-0a..0c → install.usb. The a/b/c/d differ only in post-install
    connectivity (wifi), not in the install command — so reuse the coarse entry but record the fine
    setup as its method (so the stamp + matrix column reflect the real variant)."""
    base = None
    if re.match(r"^install\.lan-setup-0[a-d]$", cid):
        base = "install.lan-setup-0"
    elif re.match(r"^install\.usb-0[a-c]$", cid):
        base = "install.usb"
    if not base:
        return None
    e = next((x for x in all_entries(cat) if x["id"] == base), None)
    if not e:
        return None
    e = dict(e)
    e["id"] = cid
    e["method"] = cid.split(".", 1)[1]   # lan-setup-0d / usb-0a
    return e


def _wifi_required(setup):
    """Setups whose target ends up on wifi (so a wifi spec is mandatory): lan-setup-0b/0c/0d, usb-0b/0c."""
    return (setup or "") in ("lan-setup-0b", "lan-setup-0c", "lan-setup-0d", "usb-0b", "usb-0c")


def is_ci():
    return bool(os.environ.get("CI") or os.environ.get("GITHUB_ACTIONS"))


def git_state(repo_rel):
    """Return {repo, commit, subject, dirty, diff_hash} for the repo a command targets."""
    repo = os.path.normpath(os.path.join(ROOT, repo_rel)) if repo_rel else ROOT
    name = os.path.basename(repo)

    def g(args, default=""):
        try:
            return subprocess.check_output(["git", "-C", repo] + args, stderr=subprocess.DEVNULL).decode().strip()
        except Exception:
            return default

    commit = g(["rev-parse", "--short", "HEAD"], "unknown")
    branch = g(["rev-parse", "--abbrev-ref", "HEAD"], "")
    subject = g(["log", "-1", "--format=%s"], "")
    porcelain = g(["status", "--porcelain"])
    diff = g(["diff", "HEAD"])
    dirty = bool(porcelain)
    diff_hash = hashlib.sha256((porcelain + diff).encode()).hexdigest()[:8] if dirty else ""
    return {"repo": name, "branch": branch, "commit": commit, "subject": subject, "dirty": dirty, "diff_hash": diff_hash}


def _is_git(repo):
    return subprocess.run(["git", "-C", repo, "rev-parse", "--git-dir"], capture_output=True).returncode == 0


# Which project repos each test actually depends on — scopes the state key AND the clean gate.
# Per-entry "repos" wins; else default by level/category; None → all project repos.
DEFAULT_REPOS = {
    "L1": ["api"],
    "L2": ["tests", "manager", "api"],
    "L3": ["app", "manager", "api"],
    "install": ["manager", "api"],
}


def entry_repos(entry):
    return entry.get("repos") or DEFAULT_REPOS.get(entry.get("level") or entry.get("category"))


def project_repo_states(names=None):
    """git_state for repos in catalog.project_repos — only `names` (the test's repos) if given,
    else all. Each gets a `name`. This is the 'config under test' the run actually depends on."""
    try:
        cat = load_catalog()
    except Exception:
        return []
    out = []
    for name, rel in (cat.get("project_repos") or {}).items():
        if names is not None and name not in names:
            continue
        repo = os.path.normpath(os.path.join(ROOT, rel))
        if not _is_git(repo):
            continue
        st = git_state(rel)
        st["name"] = name
        out.append(st)
    return out


def _state_hash_of(repos):
    """One short hash identifying a whole code state: all repos' commits + their dirtiness."""
    return hashlib.sha256("\n".join(sorted(
        f"{r['name']}:{r.get('commit', '')}:{r.get('diff_hash', '')}" for r in repos)).encode()).hexdigest()[:12]


def _self_contained(entry):
    """A test that builds its OWN flake (spins its own throwaway VM) instead of deploying to a
    box — an L2-style nixosTest. Its own flake.lock (not the backend's) is what pins the api /
    manager / nixpkgs it actually builds."""
    return bool(entry.get("cmd_by_net")) or entry.get("method") == "test-vm"


def nix_sandbox():
    """The host's nix `sandbox` setting ('true' | 'false' | 'relaxed' | ''). Anything other than
    'true' means a nix build may read host state — so a 'hermetic' nixosTest VM build could reflect
    more than the committed code. Best-effort; '' if nix can't be queried."""
    v = (_sh("nix config show sandbox", timeout=15).stdout or "").strip()
    if not v:
        for line in (_sh("nix show-config", timeout=20).stdout or "").splitlines():
            if line.startswith("sandbox ") or line.startswith("sandbox="):
                v = line.split("=", 1)[-1].strip()
                break
    return v


def guard_file_hits(repo_names, guard_paths):
    """Find build-affecting files (catalog `guard_paths`, e.g. users.nix/.env/flake.local.nix) that are
    present in a repo under test AND gitignored — so they're INVISIBLE to `git status` and the clean-
    state gate can't see them, yet they can change the build (req 91). A tracked guard file is part of
    the committed state; an untracked one already trips the dirty gate — neither is a hidden input, so
    only gitignored+present ones are returned. [{repo,path,sha}]."""
    hits = []
    pr = (load_catalog().get("project_repos") or {})
    for name in (repo_names or list(pr)):
        rel = pr.get(name)
        if not rel:
            continue
        repo = os.path.normpath(os.path.join(ROOT, rel))
        if not os.path.isdir(repo):
            continue
        for gp in guard_paths:
            fp = os.path.join(repo, gp)
            if not os.path.isfile(fp):
                continue
            ignored = subprocess.run(["git", "-C", repo, "check-ignore", "-q", gp],
                                     capture_output=True).returncode == 0
            if not ignored:
                continue    # tracked ⇒ in the committed state; untracked ⇒ caught by the dirty gate
            try:
                sha = hashlib.sha256(open(fp, "rb").read()).hexdigest()[:8]
            except Exception:
                sha = "?"
            hits.append({"repo": name, "path": gp, "sha": sha})
    return hits


def drv_of(cmd, run_dir):
    """The derivation path a self-contained build resolves to — the EXACT build-closure identity: it
    captures EVERY transitive input, not just the 3 recorded pins (api/nixpkgs/manager), so two builds
    that differ only in some transitive input can't collide on one state key (req 92). Extracts the
    flake attr (the first '#'-bearing token) from the cmd and runs `nix eval <attr>.drvPath`. Returns
    '' if there's no attr or the eval fails. A dirty tree yields a dirty-suffixed drv (honest)."""
    attr = next((t for t in cmd.split() if "#" in t), "")
    if not attr:
        return ""
    r = _sh(f"cd '{run_dir}' && nix eval \"{attr}.drvPath\" --raw", timeout=240)
    out = (r.stdout or "").strip().splitlines()[-1] if (r.stdout or "").strip() else ""
    return out if out.endswith(".drv") else ""


def resolve_lock(extra_env=None, entry=None):
    """The flake.lock that actually governs THIS run's build/deploy:
      1. $FLAKE/flake.lock when --env FLAKE=… (installs deploy that flake);
      2. a self-contained nixosTest's OWN flake.lock (its repo/cwd flake.lock) — e.g. L2 builds
         the `selfprivacy-tor-tests` flake, whose lock (NOT the backend flake) pins the api /
         manager / nixpkgs under test. Using it makes flake_pins + the pin gate check the right
         lock, so a stale test lock can no longer record a false pass;
      3. else catalog.pins_lock (the backend flake)."""
    for kv in (extra_env or []):
        if kv.startswith("FLAKE="):
            return os.path.join(kv.split("=", 1)[1], "flake.lock")
    if entry is not None and _self_contained(entry):
        rd = os.path.normpath(os.path.join(ROOT, entry.get("cwd") or entry.get("repo") or "."))
        cand = os.path.join(rd, "flake.lock")
        if os.path.exists(cand):
            return cand
    try:
        rel = load_catalog().get("pins_lock")
    except Exception:
        rel = None
    return os.path.normpath(os.path.join(ROOT, rel)) if rel else None


def flake_pins(lock_path=None):
    """{'selfprivacy-api': rev, 'nixpkgs': rev} from a flake.lock — the DEPLOYED versions (from
    the lock, NOT the local api checkout). lock_path defaults to catalog.pins_lock."""
    if lock_path is None:
        lock_path = resolve_lock(None)
    if not lock_path or not os.path.exists(lock_path):
        return {}
    try:
        d = json.load(open(lock_path))
    except Exception:
        return {}
    pins = {}
    for k in ("selfprivacy-api", "nixpkgs", "manager"):
        rev = ((d.get("nodes", {}).get(k, {}) or {}).get("locked", {}) or {}).get("rev")
        if rev:
            pins[k] = rev[:12]
    return pins


def lock_input_mismatch(lock_path, node_name, repo_name):
    """None if the local <repo_name> checkout CORRESPONDS to the <node_name> rev pinned in
    lock_path, else a dict describing the mismatch. 'Corresponds' = local HEAD == pinned rev AND
    clean. Returns None when not configured/checkable (e.g. the lock doesn't pin that input), so
    it never blocks inputs this lock doesn't govern."""
    if not lock_path or not os.path.exists(lock_path):
        return None
    try:
        rel = (load_catalog().get("project_repos") or {}).get(repo_name)
    except Exception:
        rel = None
    if not rel:
        return None
    repo = os.path.normpath(os.path.join(ROOT, rel))
    if not _is_git(repo):
        return None
    try:
        head = subprocess.check_output(["git", "-C", repo, "rev-parse", "HEAD"], stderr=subprocess.DEVNULL).decode().strip()
        lock = json.load(open(lock_path))
    except Exception:
        return None
    pin = ((lock.get("nodes", {}).get(node_name, {}) or {}).get("locked", {}) or {}).get("rev")
    if not pin:
        return None
    dirty = bool(subprocess.run(["git", "-C", repo, "status", "--porcelain"], capture_output=True).stdout.strip())
    if head != pin:
        return {"kind": "rev", "input": node_name, "pin": pin[:12], "checkout": head[:12],
                "msg": f"flake.lock pins {node_name} @ {pin[:12]} but the local {repo_name} checkout is @ {head[:12]}"}
    if dirty:
        return {"kind": "dirty", "input": node_name, "pin": pin[:12], "checkout": head[:12],
                "msg": f"{repo_name} checkout @ {head[:12]} matches the pin but has UNCOMMITTED changes (the build uses the committed pin, not your edits)"}
    return None


def api_pin_mismatch(lock_path=None):
    """None if the local selfprivacy-api checkout corresponds to the flake.lock api pin, else a
    mismatch dict. Thin wrapper over lock_input_mismatch; kept for existing callers."""
    if lock_path is None:
        lock_path = resolve_lock(None)
    return lock_input_mismatch(lock_path, "selfprivacy-api", "api")


def _env_get(extra_env, key):
    for kv in (extra_env or []):
        if kv.startswith(key + "="):
            return kv.split("=", 1)[1]
    return None


def needs_box(entry):
    """True if the test runs against a deployed target box, so the box's deployment identity
    must match the current code. Per-entry `needs_box` wins; else default: L3 tests do (they
    run the Flutter app against a deployed box). L1/L2 are self-contained nixosTests that spin
    their own throwaway VM, so they need no external box (matches the dashboard's needsBox)."""
    if "needs_box" in entry:
        return bool(entry["needs_box"])
    return entry.get("level") == "L3"


def _setup_backend_kind(setup):
    """Which kind of backend a `--on <setup>` names: an external physical 'box' (reached over the LAN
    via SSH key) vs the local 'vm' (VirtualBox on this host, or the self-contained test-VM). L3 against
    a box must pass the box-identity gate + needs --ip/--key/--token; L3 on vm-local does not (the VM
    is local and has no deploy stamp). Fine setup variants (lan-setup-0a..0d / usb-0a..0c) all resolve
    to the same reach, so match by prefix."""
    s = (setup or "").strip()
    if s.startswith("lan-setup-") or s.startswith("usb-") or s == "usb" or s == "native-ethernet":
        return "box"
    return "vm"   # vm-local, test-vm, "-", or unset


def _setup_family(setup):
    """The install-METHOD family of a setup — what actually determines how the box got installed:
    `usb` (installer USB → disk) vs `lan` (direct-cable / router netboot, nixos-anywhere) vs `vm`
    (local VirtualBox). The fine variants (…-0a/0b/0c/0d) share ONE install and differ only in
    post-install connectivity, so they map to the same family. Used to stop a result landing in the
    wrong install-method column (e.g. a usb cell green against a lan-installed box)."""
    s = (setup or "").strip()
    if s.startswith("usb"):
        return "usb"
    if s.startswith("lan-setup") or s == "native-ethernet":
        return "lan"
    return "vm"   # vm-local / test-vm / unset


def _ssh_base(key):
    o = ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
         "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]
    if key:
        o += ["-i", os.path.expanduser(key)]
    return o


def ssh_reachable(ip, key):
    return subprocess.run(_ssh_base(key) + [f"root@{ip}", "true"], capture_output=True).returncode == 0


def read_box_stamp(ip, key):
    """The /etc/dev-test-build.json a box was deployed with, or None if unreachable/unstamped."""
    try:
        raw = subprocess.check_output(_ssh_base(key) + [f"root@{ip}", "cat /etc/dev-test-build.json"], stderr=subprocess.DEVNULL).decode()
        return json.loads(raw)
    except Exception:
        return None


def box_pin_diffs(stamp, want):
    """List of 'k: box=X vs code=Y' where the box's deployed pin != the current code pin."""
    out = []
    for k in ("selfprivacy-api", "nixpkgs"):
        w = want.get(k)
        if w and not str(stamp.get(k, "")).startswith(w):
            out.append(f"{k}: box={str(stamp.get(k, '?'))[:12]} vs code={w}")
    return out


def read_box_live(ip, key):
    """MEASURE the box's ACTUAL running system (not the install-time stamp, which is only a claim):
    the /run/current-system store path + nixos-version. None if unreachable. Lets the gate catch a
    box that was nixos-rebuilt / hand-edited AFTER it was stamped — the stamp wouldn't change, but
    the running closure would."""
    try:
        out = subprocess.check_output(
            _ssh_base(key) + [f"root@{ip}",
                              "printf '%s\\n%s' \"$(readlink -f /run/current-system)\" \"$(nixos-version 2>/dev/null)\""],
            stderr=subprocess.DEVNULL).decode().splitlines()
        return {"system": (out[0].strip() if out else ""),
                "nixos_version": (out[1].strip() if len(out) > 1 else "")}
    except Exception:
        return None


def submodule_drift(rel):
    """If `rel` is a git submodule whose working checkout differs from the superproject's
    recorded pointer, return a message; else None. (So 'manager clean' can't hide an app
    checkout that doesn't match manager's recorded gitlink.)"""
    if not rel:
        return None
    repo = os.path.normpath(os.path.join(ROOT, rel))
    if not _is_git(repo):
        return None
    try:
        sup = subprocess.check_output(["git", "-C", repo, "rev-parse", "--show-superproject-working-tree"], stderr=subprocess.DEVNULL).decode().strip()
    except Exception:
        return None
    if not sup:
        return None
    subrel = os.path.relpath(repo, sup)
    try:
        out = subprocess.check_output(["git", "-C", sup, "submodule", "status", "--", subrel], stderr=subprocess.DEVNULL).decode()
    except Exception:
        return None
    if out and out[0] in "+-U":
        return f"{subrel}: checkout {out[1:11].strip()} differs from {os.path.basename(sup)}'s recorded submodule pointer"
    return None


def gen_run_id():
    stamp = datetime.datetime.now().strftime("%Y%m%dT%H%M%S")
    return f"{stamp}-{os.urandom(2).hex()}"


def append_record(rec):
    os.makedirs(os.path.dirname(DATA), exist_ok=True)
    with open(DATA, "a") as f:
        f.write(json.dumps(rec) + "\n")


def cmd_backfill_provenance(args):
    """One-time migration: add dial_domain (+ socks_port) to existing app-run records by
    parsing the dart-defines out of each run's log header. Idempotent (skips records that
    already carry it, or that have no parseable app command)."""
    if not os.path.exists(DATA):
        print("no results.jsonl")
        return
    out, changed = [], 0
    for line in open(DATA):
        if not line.strip():
            out.append(line.rstrip("\n"))
            continue
        r = json.loads(line)
        if "dial_domain" not in r:
            lp = (r.get("artifacts") or {}).get("client_log") or r.get("log_path")
            prov = extract_provenance(log_header_cmd(os.path.join(ROOT, lp))) if lp else {}
            if prov:
                r.update(prov)
                changed += 1
        out.append(json.dumps(r))
    with open(DATA, "w") as f:
        f.write("\n".join(out) + "\n")
    print(f"backfilled provenance into {changed} record(s)")


def drop_record(run_id):
    """Remove a previously-appended record by run_id (used to discard a transient retry attempt so
    the board isn't polluted with flaky-Tor failures we immediately retried past)."""
    if not run_id or not os.path.exists(DATA):
        return
    kept = [l for l in open(DATA) if l.strip() and json.loads(l).get("run_id") != run_id]
    open(DATA, "w").write("".join(kept))


def mark_record(run_id, **fields):
    """Update an already-appended record in place (by run_id) with extra fields — used to RETAIN a
    transient retry attempt marked flaky, instead of deleting it (so real-but-intermittent failures
    aren't silently hidden; the cell headline is still the later pass, flaky fails live in history)."""
    if not run_id or not os.path.exists(DATA):
        return
    out = []
    for l in open(DATA):
        if not l.strip():
            continue
        r = json.loads(l)
        if r.get("run_id") == run_id:
            r.update(fields)
        out.append(json.dumps(r))
    open(DATA, "w").write("\n".join(out) + "\n")


def repos_behind_upstream(repos, fetch=False):
    """{name: n} for each repo whose local HEAD is n commits BEHIND its tracked upstream (0 omitted).
    With fetch=True, refresh the remote-tracking ref first (best-effort, short timeout) so the count
    reflects the TRUE latest — not a stale last-fetch. Offline: the fetch is skipped and the compare
    falls back to the last-known upstream (so a confirmed-behind still trips; an unverifiable one
    doesn't). Catches testing a stale checkout while believing it's the latest code."""
    try:
        pr = (load_catalog().get("project_repos") or {})
    except Exception:
        pr = {}
    out = {}
    for r in repos:
        rel = pr.get(r.get("name"))
        if not rel:
            continue
        repo = os.path.normpath(os.path.join(ROOT, rel))
        if fetch:
            try:
                subprocess.run(["git", "-C", repo, "fetch", "--quiet"], timeout=30,
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        try:
            n = subprocess.check_output(["git", "-C", repo, "rev-list", "--count", "HEAD..@{u}"],
                                        stderr=subprocess.DEVNULL).decode().strip()
            if n and n != "0":
                out[r["name"]] = int(n)
        except Exception:
            pass
    return out


def summarize_error(log_path):
    """Pull a one-line error summary out of a log (best effort, generic across tools)."""
    try:
        lines = open(log_path, errors="replace").read().splitlines()
    except Exception:
        return ""
    keys = ("error:", "Error", "Traceback", "assert", "AssertionError", "FAILED", "failed",
            "Exception", "Timeout", "cannot", "not found", "refused")
    hits = [l.strip() for l in lines if any(k in l for k in keys) and l.strip()]
    # Prefer a pytest/nix summary-ish line if present.
    for l in reversed(hits):
        if " failed" in l or "FAILED" in l or "AssertionError" in l or "error:" in l:
            return scrub(l[:240])
    return scrub(hits[-1][:240] if hits else "")


def classify(exit_code, duration, budget):
    if exit_code == 0:
        return "slow" if (budget and duration > budget) else "pass"
    return "fail"


def start_recording(run_id):
    """Record the app UI. Prefer a HEADLESS Xvfb: on Wayland/GNOME, x11grab of the real :0 captures
    black (rootless XWayland), so we render the app into a private Xvfb framebuffer and capture that —
    session-independent, small, always the app. Returns a dict incl. the DISPLAY the app must use."""
    if not shutil.which("ffmpeg"):
        print(f"{GREY}(ffmpeg missing — skipping video){OFF}")
        return None
    os.makedirs(MEDIA, exist_ok=True)
    out = os.path.join(MEDIA, run_id + ".mp4")
    size = "1280x800"
    try:
        if shutil.which("Xvfb"):
            disp = ":99"
            xvfb = subprocess.Popen(["Xvfb", disp, "-screen", "0", size + "x24", "-nolisten", "tcp"],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            time.sleep(2)
            ff = subprocess.Popen(["ffmpeg", "-y", "-f", "x11grab", "-video_size", size, "-framerate", "12",
                                   "-i", disp, "-pix_fmt", "yuv420p", out],
                                  stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.PIPE)
            print(f"{GREY}(recording the app headlessly via Xvfb {disp} → {os.path.relpath(out, ROOT)}){OFF}")
            return {"procs": [ff, xvfb], "out": out,
                    "env": {"DISPLAY": disp, "GDK_BACKEND": "x11", "LIBGL_ALWAYS_SOFTWARE": "1"}}
        x = os.environ.get("DISPLAY")
        if not x:
            print(f"{GREY}(no Xvfb and no X display — skipping video){OFF}")
            return None
        ff = subprocess.Popen(["ffmpeg", "-y", "-f", "x11grab", "-framerate", "12", "-i", x, "-pix_fmt", "yuv420p", out],
                              stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.PIPE)
        print(f"{AMBER}(recording ambient X — likely blank on Wayland; install {CYAN}xvfb{OFF}{AMBER} "
              f"[or run --setup] for a real recording){OFF}")
        return {"procs": [ff], "out": out, "env": {"GDK_BACKEND": "x11"}}
    except Exception as ex:
        print(f"{GREY}(recorder failed: {ex}){OFF}")
        return None


def trim_black(path, pad=0.3):
    """Drop the leading/trailing all-black stretch from a recording. `flutter test -d linux` spends
    the first ~20s BUILDING the app (no window on the display yet → black), then the UI shows for the
    last few seconds; without this the mp4 is 'mostly black'. Uses ffmpeg blackdetect to find the
    content window and re-encodes just that span. Best-effort: leaves the file untouched on any doubt."""
    try:
        r = subprocess.run(["ffmpeg", "-i", path, "-vf",
                            "blackdetect=d=0.2:pic_th=0.98:pix_th=0.10", "-f", "null", "-"],
                           capture_output=True, text=True, timeout=120)
        dur = None
        d = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                            "-of", "default=nw=1:nk=1", path], capture_output=True, text=True, timeout=30)
        try:
            dur = float(d.stdout.strip())
        except ValueError:
            return   # can't reason about the tail without a duration
        spans = re.findall(r"black_start:([\d.]+) black_end:([\d.]+)", r.stderr)
        start, end = 0.0, dur
        for bs, be in spans:
            bs, be = float(bs), float(be)
            if bs <= 0.2 and be > start:              # leading black (the build)
                start = be
            if be >= dur - 0.2 and bs < end:          # trailing black (teardown)
                end = bs
        start = max(0.0, start - pad)
        end = min(dur, end + pad)
        if end - start < 1.0 or (start <= 0.2 and end >= dur - 0.2):
            return   # nothing worth trimming, or it'd leave < 1s — keep the original
        tmp = path + ".trim.mp4"
        t = subprocess.run(["ffmpeg", "-y", "-i", path, "-ss", f"{start:.2f}", "-to", f"{end:.2f}",
                            "-c:v", "libx264", "-pix_fmt", "yuv420p", "-an", tmp],
                           capture_output=True, text=True, timeout=180)
        if t.returncode == 0 and os.path.exists(tmp) and os.path.getsize(tmp) > 1000:
            os.replace(tmp, path)
            print(f"{GREY}(trimmed recording to the {end - start:.1f}s where the UI is visible){OFF}")
        elif os.path.exists(tmp):
            os.remove(tmp)
    except Exception as ex:
        print(f"{GREY}(video trim skipped: {ex}){OFF}")


def stop_recording(rec):
    if not rec:
        return ""
    for p in rec["procs"]:                     # ffmpeg first (SIGINT finalizes the mp4), then Xvfb
        try:
            p.send_signal(signal.SIGINT)
            p.wait(timeout=12)
        except Exception:
            try:
                p.kill()
            except Exception:
                pass
    out = rec["out"]
    if os.path.exists(out) and os.path.getsize(out) > 1000:
        trim_black(out)
        return os.path.relpath(out, ROOT)
    return ""


def pull_server_log(cmd, run_id):
