def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def load_catalog():
    with open(CATALOG) as f:
        return json.load(f)


def all_entries(cat):
    return list(cat.get("tests", [])) + list(cat.get("installs", [])) + list(cat.get("reaches", []))


# ── Install setups (--on) + preflight ────────────────────────────────────────
# The --on value names a setup = one view of the setup diagram (flow.html#setup-map, data
# docs/diagrams/setup-map.json): its Install toggle + Network toggle → cable-0a/0b/0d/0c, wifi-0a/0d,
# usb-0a/0d/0c, vm (catalog `setups`; old ids like lan-setup-0d / vm-local are accepted as aliases).
# Before an install runs, preflight() checks the setup is feasible NOW and, if not, returns an
# actionable fix instead of half-running. Topology sketches live in the catalog (setups[].topology)
# so they render in `./dash setups`.
DIAGRAM_JSON = os.path.join(ROOT, "docs", "diagrams", "setup-map.json")


def _all_setups(cat=None):
    cat = cat or load_catalog()
    return list(cat.get("setups", [])) + list(cat.get("harness_setups", []))


def setup_ids(cat=None):
    """The --on values a user passes (diagram setups, in diagram order) — the harness test-vm is not one."""
    return [s["id"] for s in (cat or load_catalog()).get("setups", [])]


def setup_entry(sid, cat=None):
    return next((s for s in _all_setups(cat) if s["id"] == sid), None)


def canon_setup(s, cat=None):
    """(canonical setup id, None) for a diagram setup id, the harness test-vm or a legacy alias
    (lan-setup-0d → cable-0d, lan-setup-1 → wifi-0a, vm-local → vm, …); (None, why) for a removed or
    unknown one. Unset stays unset."""
    if s in (None, "", "-"):
        return s, None
    cat = cat or load_catalog()
    for e in _all_setups(cat):
        if s == e["id"] or s in (e.get("aliases") or []):
            return e["id"], None
    gone = (cat.get("removed_setups") or {}).get(s)
    if gone:
        return None, gone
    return None, f"unknown setup '{s}' — use one of: {' | '.join(setup_ids(cat))}  (./dash setups)"


def setup_label(sid, cat=None):
    s = setup_entry(sid, cat)
    return (s or {}).get("label") or sid


def diagram_view(setup=None, row=None, cat=None):
    """The setup-diagram view key of a run ("method=cable;net=0a;reach=cloudflare;name=buy"), so a record
    links straight to flow.html#setup-map;<view>. "" when there is no such view: the harness test-vm (L1/L2),
    a future or greyed-out row, or a harness row whose reach isn't a diagram Reach (local https). A harness row
    whose reach IS one (onion over chutney) maps to that reach's view — it simulates it."""
    cat = cat or load_catalog()
    if not setup or setup not in setup_ids(cat):
        return ""
    s = setup_entry(setup, cat)
    parts = [f"method={s['method']}"] + ([f"net={s['net']}"] if s.get("net") else [])
    r = next((x for x in cat.get("reach_rows", []) if x["id"] == row), None) if row else None
    if r:
        if r.get("future") or r.get("greyed") or r.get("reach") not in {x["id"] for x in (cat.get("setup_map") or {}).get("reaches", [])}:
            return ""
        parts.append(f"reach={r['reach']}")
        if r.get("name"):
            parts.append(f"name={r['name']}")
    return ";".join(parts)
DIRECT_IFACE = os.environ.get("SP_NETBOOT_IFACE", "enp0s31f6")
DIRECT_IP = "192.168.100.1"


def _iface_has_ip(iface, ip):
    r = subprocess.run(["ip", "-4", "addr", "show", iface], capture_output=True, text=True)
    return ip in r.stdout


def _local_prefixes():
    """The /24 prefixes this laptop is on (RFC1918) + the direct-cable netboot subnet — the subnets a
    target could appear on."""
    out = _sh("ip -4 -o addr show scope global", timeout=10).stdout or ""
    pref = set()
    for line in out.splitlines():
        for tok in line.split():
            if "/" in tok and tok.count(".") == 3:
                a = tok.split("/")[0].split(".")
                if a[0] == "10" or (a[0] == "192" and a[1] == "168") or (a[0] == "172" and a[1].isdigit() and 16 <= int(a[1]) <= 31):
                    pref.add(".".join(a[:3]))
    pref.add(DIRECT_IP.rsplit(".", 1)[0])
    return sorted(pref)


def _ping_sweep(prefix):
    """Quietly populate the neighbour table for a /24 (parallel, no job-control noise)."""
    _sh(f"seq 254 | xargs -P254 -I{{}} ping -c1 -W1 {prefix}.{{}} >/dev/null 2>&1", timeout=60)


def _neigh_pairs():
    """(mac, ip) for every neighbour with a resolved lladdr."""
    out = _sh("ip neigh", timeout=10).stdout or ""
    res = []
    for line in out.splitlines():
        p = line.split()
        if "lladdr" in p and "." in p[0]:
            res.append((p[p.index("lladdr") + 1].lower(), p[0]))
    return res


def _netboot_leases():
    """(mac, ip) of devices that took a lease from the direct-cable netboot server — i.e. booted into
    the installer. The strongest signal for 'this is the target'."""
    res, path = [], "/tmp/netboot-leases"
    if os.path.exists(path):
        for line in open(path):
            f = line.split()
            if len(f) >= 3 and ":" in f[1] and "." in f[2]:
                res.append((f[1].lower(), f[2]))
    return res


def _iface_carrier(iface):
    """True if the NIC has a live link (carrier), False if not, None if unknown. No carrier on the
    wired port = nothing is plugged in / the target NIC is off — a target can't be discovered."""
    try:
        return open(f"/sys/class/net/{iface}/carrier").read().strip() == "1"
    except Exception:
        return None


def _netboot_running():
    """True if the netboot server is ACTUALLY serving — a DHCP server listening on UDP :67. Checking
    only the interface IP (192.168.100.1) gives false positives: that IP lingers after a prior install
    even though the dnsmasq/TFTP/HTTP services were killed, so the target gets no lease and never shows."""
    try:
        out = subprocess.run(["ss", "-lun"], capture_output=True, text=True, timeout=4).stdout
        return any(tok.endswith(":67") for line in out.splitlines() for tok in line.split())
    except Exception:
        return False


def _up_ifaces():
    out = _sh("ip -br link", timeout=10).stdout or ""
    res = []
    for line in out.splitlines():
        parts = line.split()
        if not parts:
            continue
        name = parts[0].split("@")[0]
        if name != "lo" and not name.startswith(("docker", "veth", "br-", "virbr")):
            res.append(name)
    return res


def _ipv6_ll_discover():
    """Devices reachable by IPv6 link-local multicast (ff02::1) — works even with NO IPv4 / no DHCP,
    e.g. a target cabled straight to this laptop (cable-* setups). Returns [(mac, iface)]."""
    for ifc in _up_ifaces():
        _sh(f"ping -6 -c2 -W1 ff02::1%{ifc} >/dev/null 2>&1", timeout=8)
    res = []
    for line in (_sh("ip -6 neigh", timeout=10).stdout or "").splitlines():
        p = line.split()
        if p and p[0].lower().startswith("fe80") and "lladdr" in p and "dev" in p:
            dev = p[p.index("dev") + 1]
            if dev != "lo" and not dev.startswith(("docker", "veth", "br-", "virbr")):
                res.append((p[p.index("lladdr") + 1].lower(), dev))
    return res


def setup_preflight(method):
    """Return (ok, message): whether `install --on <method>` can run right now (method = canonical setup id)."""
    if method in (None, "", "-", "test-vm"):
        return True, ""
    kind = (setup_entry(method) or {}).get("method")
    if kind == "vm":
        if not shutil.which("VBoxManage"):
            return False, "VirtualBox not found (VBoxManage). Install it, e.g. `sudo apt install virtualbox`."
        return True, ""
    if kind == "cable":                            # cable-0a / 0b / 0d / 0c: netboot over a direct cable
        if not _iface_has_ip(DIRECT_IFACE, DIRECT_IP):
            return False, (
                f"Direct-link netboot server is not running on {DIRECT_IFACE}.\n"
                f"  1) Cable: laptop {DIRECT_IFACE} <-> target ethernet (router OUT of path)\n"
                f"  2) sudo bash ~/netboot/start-netboot-server.sh   (leave it running)\n"
                f"  3) Boot the target into UEFI network mode, then re-run.")
        return True, ""
    if kind == "wifi":                             # wifi-0a / 0d: netboot THROUGH router R
        return False, (
            "Router R is not configured for network boot, so the target cannot PXE over R.\n"
            "  R's own DHCP server fights the installer's DHCP. To use this setup, configure R to EITHER:\n"
            "    - disable R's DHCP and let THIS laptop serve DHCP+TFTP on R's LAN, OR\n"
            "    - set R's DHCP boot options (next-server=this laptop, filename=ipxe.efi) [proxyDHCP],\n"
            "      pointing TFTP/HTTP at ~/netboot.\n"
            "  Until R is set up, run a LAN-cable install instead (./dash run install.cable-0a | install.cable-0b |\n"
            "  install.cable-0d | install.cable-0c) or a USB-stick one (install.usb-0a | install.usb-0d | install.usb-0c).\n"
            "  Details: dev-dashboard/README.md (Setups).")
    if kind == "usb":                              # usb-0a / 0d / 0c: manual boot from the stick
        return True, ""
    return True, ""


def diagram_alignment(cat=None):
    """Compare the catalog's matrix axes with the setup diagram's toggles (docs/diagrams/setup-map.json):
    Install/Network/Reach/Name option values + labels, which networks each install method offers, which
    names each reach offers, and that every diagram (method, net) / (reach, name) view is a matrix
    setup / reach row. Returns a list of mismatches ([] = aligned)."""
    cat = cat or load_catalog()
    try:
        tg = {t["id"]: t for t in json.load(open(DIAGRAM_JSON))["meta"]["toggles"]}
    except Exception as ex:
        return [f"cannot read the diagram toggles from {os.path.relpath(DIAGRAM_JSON, ROOT)}: {ex}"]
    sm = cat.get("setup_map") or {}
    out = []

    def opts(tid):
        return [(o["value"], o.get("label", "")) for o in (tg.get(tid) or {}).get("options", [])]

    for tid, key in (("method", "methods"), ("net", "nets"), ("reach", "reaches"), ("name", "names")):
        want, have = opts(tid), [(x["id"], x.get("label", "")) for x in sm.get(key, [])]
        if want != have:
            out.append(f"toggle '{tid}': diagram {want} ≠ catalog setup_map.{key} {have}")
    diag_methods = {v for v, _ in opts("method")}
    for s in cat.get("setups", []):
        if s.get("method") not in diag_methods:
            out.append(f"setup {s['id']}: Install {s.get('method')!r} is not a diagram option")
    net_order = [v for v, _ in opts("net")]
    nw = ((tg.get("net") or {}).get("optionsWhen") or {}).get("method") or {}
    for m, _ in opts("method"):
        want = [n for n in net_order if n in (nw.get(m) or [])] if m in nw else net_order
        want_ids = [f"{m}-{n}" for n in want] if want else [m]
        have_ids = [s["id"] for s in cat.get("setups", []) if s.get("method") == m]
        if want_ids != have_ids:
            out.append(f"Install={m}: diagram views {want_ids} ≠ catalog setups {have_ids}")
        for s in cat.get("setups", []):
            if s.get("method") == m and s["id"] in want_ids and s.get("net") != (s["id"].split("-", 1)[1] if want else None):
                out.append(f"setup {s['id']}: net field {s.get('net')!r} doesn't match its id")
    rw = ((tg.get("name") or {}).get("optionsWhen") or {}).get("reach") or {}
    rows = [(r["reach"], r.get("name")) for r in cat.get("reach_rows", [])
            if not r.get("harness") and not r.get("future") and not r.get("greyed")]
    for r in sm.get("reaches", []):
        want = [n for n, _ in opts("name") if n in (rw.get(r["id"]) or [])] if r["id"] in rw else [n for n, _ in opts("name")]
        if r.get("names", []) != want:
            out.append(f"Reach={r['id']}: diagram names {want} ≠ catalog names {r.get('names', [])}")
        for nm in (want or [None]):
            if (r["id"], nm) not in rows:
                out.append(f"diagram view reach={r['id']}" + (f";name={nm}" if nm else "") + " has no matrix reach row")
    known = {(r["id"], n) for r in sm.get("reaches", []) for n in (r.get("names") or [None])}
    for rr in rows:
        if rr not in known:
            out.append(f"matrix reach row {rr} is not a diagram view")
    return out


def alignment_gate(cat=None):
    """"" when the matrix matches the setup diagram, else why nothing may run (req 183). Checked before EVERY
    run / wrap / report: a result recorded against drifted axes lands in a cell that no longer means what it
    says. No override (not even --allow-dirty) — align catalog.json with the diagram first."""
    mism = diagram_alignment(cat)
    if not mism:
        return ""
    return (f"{RED}matrix ≠ setup diagram{OFF} — nothing run. Align catalog.json (setup_map / setups / reach_rows) "
            f"with {os.path.relpath(DIAGRAM_JSON, ROOT)} first (see ./dash setups --check):\n"
            + "\n".join(f"  - {m}" for m in mism))


