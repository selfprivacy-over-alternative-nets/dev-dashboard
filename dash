def cmd_list(args):
    cat = load_catalog()
    es = all_entries(cat)
    for e in es:
        nets = ",".join(e.get("networks") or []) or "-"
        c = e.get("cmd", "")
        kind = "@todo" if c == "@todo" else "@manual" if c == "@manual" else ""
        print(f"  {e['id']:<26} {e['level']:<8} {e.get('client','-'):<8} net={nets:<16} {GREY}{kind}{OFF}")
    print(f"\n{len(es)} commands. Run: ./dash run <id> [--net tor --on vm-local --record]  |  ./dash run --all")


def select(args):
    cat = load_catalog()
    es = all_entries(cat)
    if args.ids:
        picked = [entry_by_id(cat, i) for i in args.ids]
        missing = [i for i, p in zip(args.ids, picked) if p is None]
        if missing:
            sys.exit(f"unknown id(s): {', '.join(missing)}")
        return picked
    if args.all:
        return es
    out = es
    if args.level:
        out = [e for e in out if e["level"] == args.level]
    if args.category:
        out = [e for e in out if e.get("category") == args.category]
    if args.tag:
        k, _, v = args.tag.partition("=")
        out = [e for e in out if str(e.get(k, "")) == v]
    if out is es:
        sys.exit("nothing selected. use <id>, --all, --level, --category, or --tag")
    return out


def cmd_run(args):
    entries = select(args)
    # Fold the dedicated box args into the env channel the gates/dispatch already read (KEY for the
    # box-identity gate + server logs; API_TOKEN for the L3 app). Keeps run_entry's signature stable.
    env = list(args.env or [])
    if getattr(args, "key", None):
        env.append(f"KEY={args.key}")
    if getattr(args, "token", None):
        env.append(f"API_TOKEN={args.token}")
    args.env = env
    print(f"{BOLD}Running {len(entries)} command(s){OFF}\n")
    results = [run_entry(e, args.config, net=args.net, method=args.on,
                         record=args.record, server_log=args.server_log,
                         ip=args.ip, extra_env=args.env, allow_dirty=args.allow_dirty) for e in entries]
    results = [r for r in results if r]
    ok = sum(1 for r in results if r["status"] == "pass")
    print(f"\n{BOLD}Done.{OFF} {ok}/{len(results)} pass. Data → {os.path.relpath(DATA, ROOT)}")
    print("View:  ./dash serve   Publish:  ./dash publish")


def cmd_wrap(args):
    cat = load_catalog()
    e = entry_by_id(cat, args.id) or {"id": args.id, "name": args.id, "category": "test",
                                       "level": "adhoc", "repo": None, "budget_s": None}
    e = dict(e)
    e["cmd"] = " ".join(args.cmd)
    run_entry(e, args.config, net=args.net, method=args.on, record=args.record, server_log=args.server_log)


def cmd_report(args):
    cat = load_catalog()
    e = entry_by_id(cat, args.id)
    if not e:
        sys.exit(f"unknown id: {args.id}")
    gs = git_state(e.get("repo"))
    nets = e.get("networks") or []
    _repos = project_repo_states(entry_repos(e))
    _pins = flake_pins()
    _box = None
    _sh = None
    if args.ip:
        # Authoritative: record the box's actual deployed identity (the device, not report-time git).
        _box = read_box_stamp(args.ip, args.key)
        if _box is None:
            print(f"{AMBER}warning{OFF}: root@{args.ip} unreachable or not stamped — recording local git state instead.")
        else:
            _server = _box.get("repos") or []
            _snames = {s.get("name") for s in _server}
            _client = [r for r in _repos if r.get("name") not in _snames]
            _repos = _server + _client
            _pins = _box.get("pins") or _pins
            _sh = _box.get("state_hash")
    rec = {
        "run_id": gen_run_id(), "ts": now_iso(), "env": args.env or ("ci" if is_ci() else "local"),
        "host": args.host or socket.gethostname(), "category": e.get("category", "test"),
        "id": e["id"], "name": e.get("name", e["id"]), "level": e.get("level", ""),
        "client": e.get("client", "-"), "transport": args.net or (nets[0] if len(nets) == 1 else "-"),
        "backend": e.get("backend", "-"), "method": args.on or e.get("method", "-"),
        "records_video": bool(e.get("records_video")),
        "config_label": args.config or "", "status": args.status,
        "source": "manual",   # self-attested (click-through/video), NOT an automated+verified run
        "duration_s": round(float(args.duration), 1), "exit_code": 0 if args.status == "pass" else 1,
        "error": scrub(args.error or ""), "log_path": "",
        "artifacts": {"client_log": "", "server_log": "", "video": ""},
        "repos": _repos, "pins": _pins, "pin_mismatch": api_pin_mismatch(), "state_hash": _sh, "box_stamp": _box,
        **{k: gs[k] for k in ("repo", "branch", "commit", "subject", "dirty", "diff_hash")},
    }
    append_record(rec)
    print(f"recorded {args.status} for {args.id} ({fmt_dur(args.duration)})")


def cmd_verify_box(args):
    """Read /etc/dev-test-build.json from a deployed box and compare to the CURRENT code pins.
    Answers: does this already-deployed box correspond to the code state you'd be testing?"""
    if not ssh_reachable(args.ip, args.key):
        sys.exit(f"{RED}unreachable{OFF} — root@{args.ip} not reachable over SSH (box down / wrong IP / wrong key).")
    stamp = read_box_stamp(args.ip, args.key)
    if stamp is None:
        sys.exit(f"{RED}not-stamped{OFF} — root@{args.ip} is reachable but has no /etc/dev-test-build.json (deployed before stamping; redeploy to stamp it).")
    want = flake_pins()  # current catalog-default deployed pins
    diffs = box_pin_diffs(stamp, want)
    print(f"box root@{args.ip} deployed_at {stamp.get('deployed_at', '?')} from flake {stamp.get('flake', '?')}")
    if diffs:
        print(f"{RED}MISMATCH{OFF} — the box runs a DIFFERENT state than the current code:")
        for d in diffs:
            print("  " + d)
        print("  redeploy the box before testing, so results reflect the current code.")
        sys.exit(1)
    print(f"{GREEN}MATCH{OFF} — box corresponds to current code pins ({', '.join(f'{k}={v}' for k, v in want.items())}).")


def cmd_l3_baseline(args):
    """Capture (bless) or show the known-clean golden backend baseline for an L3 setup. Run `capture`
    right after a fresh (re)install so later flows' drift is measured against a clean reference. The
    golden stores only the state sha + modules/users summary — no secrets. All args explicit (reqs 1-6);
    box setups need --ip/--key/--token (enforced by resolve_backend_target)."""
    setup = args.on
    action = args.action or "capture"
    target = resolve_backend_target(setup, "tor", args.ip, args.key, args.token)
    if not target:
        sys.exit(1)
    if target["kind"] == "box":
        stamp = read_box_stamp(target["ip"], target["key"])
        state_key = (stamp or {}).get("state_hash") or "unknown"
    else:
        state_key = _state_hash_of(project_repo_states(DEFAULT_REPOS["L3"]))
    p = _l3_baseline_path(state_key, setup)
    if action == "show":
        print(open(p).read() if os.path.exists(p)
              else f"no baseline for {state_key}/{setup} (expected {os.path.relpath(p, ROOT)})")
        return
    pre = _snapshot_backend(target)
    if not pre.get("present"):
        sys.exit(f"{RED}backend userdata.json not readable on {setup}{OFF} — is the backend up?")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    json.dump({"sha": pre.get("sha"), "modules": pre.get("modules"), "users_n": pre.get("users_n"),
               "setup": setup, "state_key": state_key, "captured": now_iso()}, open(p, "w"), indent=1)
    print(f"{GREEN}captured golden baseline{OFF}  {state_key}/{setup} → {os.path.relpath(p, ROOT)}")
