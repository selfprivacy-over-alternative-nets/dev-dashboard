@startuml architecture
' SelfPrivacy-over-alternative-nets — repos and how they connect.
' Rendered deterministically to architecture.svg by docs/render-diagrams.sh (pinned plantuml).
title SelfPrivacy-over-alternative-nets — repos & data/control flow

skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam ArrowColor #444444
skinparam rectangle {
  BorderColor #555555
  roundCorner 12
}
skinparam package {
  BorderColor #888888
  BackgroundColor #F6F6F6
}

legend top left
<b>Provenance</b>
<back:#CDEBC5>    </back>  NEW — built for this project
<back:#F7E7A6>    </back>  FORK — upstream SelfPrivacy + our delta
<back:#DDDDDD>    </back>  UPSTREAM — used unmodified
endlegend

package "dev-dashboard  —  NEW (this repo)" {
  rectangle "catalog.json\n<i>what to run</i>" as cat #CDEBC5
  rectangle "<b>dash</b>\n<i>orchestrator: run · time · gate · capture</i>" as dash #CDEBC5
  rectangle "index.html + matrix.html\n<i>dashboards</i>" as ui #CDEBC5
}

rectangle "<b>testresults</b> (separate repo)\nresults.jsonl + logs/ + media/\n<i>keyed by code state</i>" as tr #CDEBC5
cloud "GitHub Pages" as pages #DDDDDD

cat -right-> dash
dash --> tr : write 1 record / run\n(exit · time · log · video)
ui --> tr : read
ui ..> pages : publish

package "Manager-...-Over-Tor" as mgr #CDEBC5 {
  rectangle "backend/\n<i>NixOS modules · build-and-run.sh</i>" as backend #CDEBC5
  rectangle "flutter-app\nselfprivacy.org.app" as app #F7E7A6
}
rectangle "selfprivacy-api\n<i>nix run .#pytest-vm</i>" as api #F7E7A6
rectangle "selfprivacy-tor-tests\n<i>self-contained nixosTest VM</i>" as tests #CDEBC5

' dev-dashboard RUNS each target and CAPTURES its result (exit/log/video) → then writes the record.
dash <--> api    : L1 unit-VM\n(run -> pass/fail + log)
dash <--> tests  : L2 integration\n(run -> pass/fail + log)
dash <--> mgr    : L3 / install\n(run -> result + recording)

' The deployer, expanded by what each piece VARIES BY (ordered generic → hardware → per-user → env):
' generic = reusable as-is; hardware = auto-adapted per device; per-user = inputs per install;
' env = environment-specific workaround. Scaling = shrink everything below «generic» to auto/inputs.
' A vertically-stacked "skyscraper": one FLOOR per element, top→bottom, colour-banded by what it
' VARIES BY (green=generic/reusable · blue=hardware/auto · amber=per-user/input · red=env hack ·
' grey=state/secrets, NOT synced). Hidden edges force the vertical stack.
package "selfprivacy-altnet-deployer (flake) + ~/netboot — NEW" as deploy #CDEBC5 {
  rectangle "flake.nix — pins backend · wires tor-core + disko   «generic»" as f1 #E8F5E9
  rectangle "netboot.nix — in-RAM PXE installer   «generic»" as f2 #E8F5E9
  rectangle "nix-gc-path.nix — nix in API PATH (GC)   «generic»" as f3 #E8F5E9
  rectangle "disko.nix — disk layout by-id (auto)   «hardware»" as f4 #E3F0FB
  rectangle "~/netboot dnsmasq — MAC pin (auto)   «hardware»" as f5 #E3F0FB
  rectangle "host.nix — hostname · net · ssh · recovery   «per-user»" as f6 #FFF3E0
  rectangle "weersurf-https.nix — domain + cert source   «per-user»" as f7 #FFF3E0
  rectangle "secrets-seed.nix — userdata.json (token on-box)   «per-user»" as f8 #FFF3E0
  rectangle "renew/ — theory7 DNS-01 (Selenium)   «env hack»" as f9 #FBE9E7
  rectangle "state/extra — token · cert · wifi → --extra-files   🔒 NOT synced" as f10 #ECEFF1
  rectangle "state/keepass · wifi/ · ca/ — secrets + CA fallback   🔒 NOT synced" as f11 #ECEFF1
  f1 -[hidden]down-> f2
  f2 -[hidden]down-> f3
  f3 -[hidden]down-> f4
  f4 -[hidden]down-> f5
  f5 -[hidden]down-> f6
  f6 -[hidden]down-> f7
  f7 -[hidden]down-> f8
  f8 -[hidden]down-> f9
  f9 -[hidden]down-> f10
  f10 -[hidden]down-> f11
}
note bottom of deploy
  install: <b>nixos-anywhere --flake <deployer>#box --extra-files state/extra</b>
  (builds backend+disko+host, partitions, copies state/extra onto the box; token made on-box)
  synced to the private repo EXCEPT <b>state/</b> (all secrets): <i>rsync --exclude state</i>
end note
rectangle "chutney\n<i>private Tor net</i>" as chut #DDDDDD

' The app (a repo) is BUILT and RUN on a FRONTEND DEVICE — kept distinct from the BACKEND MACHINE
' that runs SelfPrivacy. L3 pairs one of each; the app dials the backend over a transport.
rectangle "FRONTEND DEVICE — runs the app" as FE #EEF3FB {
  node "Ubuntu laptop\n<i>Flutter desktop app</i>" as fedesk #FFFFFF
  node "Android device / emulator\n<i>Flutter app (roadmap)</i>" as feandroid #F0F0F0
}
rectangle "BACKEND MACHINE — runs SelfPrivacy" as BE #FBF2EC {
  node "VirtualBox VM\n<i>vm-local</i>" as vm #FFFFFF
  node "physical box\n<i>LAN · lan-setup-* / usb-*</i>" as box #FFFFFF
}

app ..> fedesk    : built & run (L3 desktop)
app ..> feandroid : roadmap (L3 android)
backend --> vm    : build-and-run.sh
deploy  --> box   : nixos-anywhere / USB / netboot
mgr     ..> deploy : install.* (box)
fedesk ..> vm     : dials backend\n(tor · https · chutney)
fedesk ..> box    : dials backend\n(tor · https)
chut ..> fedesk   : chutney transport

@enduml
